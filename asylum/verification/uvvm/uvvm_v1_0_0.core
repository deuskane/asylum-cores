CAPI=2:

#-----------------------------------------------------------------------------
# Title      : uvvm Core file
# Project    : Asylum
#-----------------------------------------------------------------------------
# File       : uvvm.core
# Author     : mrosiere
#-----------------------------------------------------------------------------
# Description: Library of UVVM BFMs for the Asylum testbenches, in the form
#              of UVVM Light : one core, one VHDL library (asylum_uvvm),
#              one package per BFM in src_bfm/, BFMs only (no VVC)
#-----------------------------------------------------------------------------
# Copyright (c) 2026
#-----------------------------------------------------------------------------
# Revisions  :
# Date        Version  Author   Description
# 2026-11-22  1.0.0    mrosiere Created
#-----------------------------------------------------------------------------

name        : asylum:verification:uvvm:1.0.0
description : UVVM BFMs of the Asylum testbenches

#=========================================
filesets:
#=========================================

  #---------------------------------------
  src_bfm:
  #---------------------------------------
    files        :
      - src_bfm/apb_bfm_pkg.vhd
      - src_bfm/jtag_bfm_pkg.vhd
    file_type    : vhdlSource-2008
    logical_name : asylum_uvvm
    depend       :
      - bitvis:verification:uvvm

  #---------------------------------------
  # Testbench of apb_bfm_pkg : APB slave model, one package per scenario
  #---------------------------------------
  sim_apb:
    files        :
      - sim/apb/tb_apb_bfm_pkg.vhd
      - sim/apb/tb_apb_slave.vhd
      - sim/apb/tb_apb_reset_values_pkg.vhd
      - sim/apb/tb_apb_write_read_pkg.vhd
      - sim/apb/tb_apb_back_to_back_pkg.vhd
      - sim/apb/tb_apb_wait_states_pkg.vhd
      - sim/apb/tb_apb_pslverr_pkg.vhd
      - sim/apb/tb_apb_timeout_pkg.vhd
      - sim/apb/tb_apb_tests_pkg.vhd
      - sim/apb/tb_apb.vhd
    file_type    : vhdlSource-2008
    depend       :
      # string_pkg list_length / list_item / list_contains (TESTS_LIST)
      - ">=asylum:utils:pkg:1.10.0"

  #---------------------------------------
  # Testbench of jtag_bfm_pkg : IEEE 1149.1 TAP model, one package per
  # scenario
  #---------------------------------------
  sim_jtag:
    files        :
      - sim/jtag/tb_jtag_bfm_pkg.vhd
      - sim/jtag/tb_jtag_tap.vhd
      - sim/jtag/tb_jtag_reset_trst_pkg.vhd
      - sim/jtag/tb_jtag_reset_tms_pkg.vhd
      - sim/jtag/tb_jtag_idcode_pkg.vhd
      - sim/jtag/tb_jtag_bypass_pkg.vhd
      - sim/jtag/tb_jtag_user_dr_pkg.vhd
      - sim/jtag/tb_jtag_idle_pkg.vhd
      - sim/jtag/tb_jtag_tests_pkg.vhd
      - sim/jtag/tb_jtag.vhd
    file_type    : vhdlSource-2008
    depend       :
      # string_pkg list_length / list_item / list_contains (TESTS_LIST)
      - ">=asylum:utils:pkg:1.10.0"

#=========================================
targets:
#=========================================

  #---------------------------------------
  default: &default
  #---------------------------------------
    description     : Library only (no toplevel), used as a dependency
    filesets        :
      - src_bfm
    default_tool    : ghdl

  #---------------------------------------
  # tb_apb : compiled once, scenarios chosen at run time (TESTS_LIST,
  # empty : build and elaboration only). sim_apb (build only) and one
  # sim_apb_<test> target per scenario. Generated.
  #---------------------------------------
  sim_apb: &sim_apb
    << : *default
    description     : Simulation of apb_bfm_pkg against an APB slave model - build only (scenarios of TESTS_LIST)
    filesets_append :
      - sim_apb
    toplevel        : tb_apb
    parameters      :
      - TESTS_LIST
    default_tool    : ghdl
    tools :
      ghdl :
        analyze_options :
          - "$(GHDL_ANALYZE_OPTION)"
          - "-Wall"
          - "-frelaxed"
        run_options     :
          - "$(GHDL_RUN_OPTION)"
          - "--ieee-asserts=disable"

  #---------------------------------------
  sim_apb_reset_values:
  #---------------------------------------
    << : *sim_apb
    description     : Simulation of apb_bfm_pkg - read of the slave memory after the reset
    parameters      :
      - TESTS_LIST=reset_values

  #---------------------------------------
  sim_apb_write_read:
  #---------------------------------------
    << : *sim_apb
    description     : Simulation of apb_bfm_pkg - write then read back, don't care bits, mismatch of apb_check
    parameters      :
      - TESTS_LIST=write_read

  #---------------------------------------
  sim_apb_back_to_back:
  #---------------------------------------
    << : *sim_apb
    description     : Simulation of apb_bfm_pkg - back to back writes and reads, 2 cycles per transfer
    parameters      :
      - TESTS_LIST=back_to_back

  #---------------------------------------
  sim_apb_wait_states:
  #---------------------------------------
    << : *sim_apb
    description     : Simulation of apb_bfm_pkg - 1, 3 and max_wait_cycles wait states
    parameters      :
      - TESTS_LIST=wait_states

  #---------------------------------------
  sim_apb_pslverr:
  #---------------------------------------
    << : *sim_apb
    description     : Simulation of apb_bfm_pkg - pslverr expected, not expected and missing
    parameters      :
      - TESTS_LIST=pslverr

  #---------------------------------------
  sim_apb_timeout:
  #---------------------------------------
    << : *sim_apb
    description     : Simulation of apb_bfm_pkg - timeout of the BFM, then a normal transfer
    parameters      :
      - TESTS_LIST=timeout

  #---------------------------------------
  # tb_jtag : compiled once, scenarios chosen at run time (TESTS_LIST,
  # empty : build and elaboration only), TAP model and BFM configuration
  # from the generics. Reference configuration (5-bit IR, 40-bit user data
  # register, TCK 100 ns) : sim_jtag (build only) and one sim_jtag_<test>
  # target per scenario ; sim_jtag_ir8 (8-bit IR, 7-bit user data register,
  # TCK 30 ns) runs every scenario. Each target repeats the generics of its
  # configuration : FuseSoC replaces the parameters list of an inherited
  # target. Generated.
  #---------------------------------------
  sim_jtag: &sim_jtag
    << : *default
    description     : Simulation of jtag_bfm_pkg against an IEEE 1149.1 TAP model - build only (scenarios of TESTS_LIST)
    filesets_append :
      - sim_jtag
    toplevel        : tb_jtag
    parameters      :
      - TESTS_LIST
      - IR_WIDTH=5
      - DR_WIDTH=40
      - TCK_PERIOD_NS=100
    default_tool    : ghdl
    tools :
      ghdl :
        analyze_options :
          - "$(GHDL_ANALYZE_OPTION)"
          - "-Wall"
          - "-frelaxed"
        run_options     :
          - "$(GHDL_RUN_OPTION)"
          - "--ieee-asserts=disable"

  #---------------------------------------
  sim_jtag_reset_trst:
  #---------------------------------------
    << : *sim_jtag
    description     : Simulation of jtag_bfm_pkg - TRST pulse then TMS reset, IDCODE selected
    parameters      :
      - TESTS_LIST=reset_trst
      - IR_WIDTH=5
      - DR_WIDTH=40
      - TCK_PERIOD_NS=100

  #---------------------------------------
  sim_jtag_reset_tms:
  #---------------------------------------
    << : *sim_jtag
    description     : Simulation of jtag_bfm_pkg - reset by TMS only (no TRST pulse), IDCODE selected
    parameters      :
      - TESTS_LIST=reset_tms
      - IR_WIDTH=5
      - DR_WIDTH=40
      - TCK_PERIOD_NS=100

  #---------------------------------------
  sim_jtag_idcode:
  #---------------------------------------
    << : *sim_jtag
    description     : Simulation of jtag_bfm_pkg - IDCODE read, don't care bits, mismatch of jtag_check_dr
    parameters      :
      - TESTS_LIST=idcode
      - IR_WIDTH=5
      - DR_WIDTH=40
      - TCK_PERIOD_NS=100

  #---------------------------------------
  sim_jtag_bypass:
  #---------------------------------------
    << : *sim_jtag
    description     : Simulation of jtag_bfm_pkg - BYPASS and undecoded opcode, one bit delay
    parameters      :
      - TESTS_LIST=bypass
      - IR_WIDTH=5
      - DR_WIDTH=40
      - TCK_PERIOD_NS=100

  #---------------------------------------
  sim_jtag_user_dr:
  #---------------------------------------
    << : *sim_jtag
    description     : Simulation of jtag_bfm_pkg - wide user data register, IR then DR scans
    parameters      :
      - TESTS_LIST=user_dr
      - IR_WIDTH=5
      - DR_WIDTH=40
      - TCK_PERIOD_NS=100

  #---------------------------------------
  sim_jtag_idle:
  #---------------------------------------
    << : *sim_jtag
    description     : Simulation of jtag_bfm_pkg - number of TCK cycles of each procedure, idle cycles
    parameters      :
      - TESTS_LIST=idle
      - IR_WIDTH=5
      - DR_WIDTH=40
      - TCK_PERIOD_NS=100

  #---------------------------------------
  sim_jtag_ir8:
  #---------------------------------------
    << : *sim_jtag
    description     : Simulation of jtag_bfm_pkg, 8-bit IR, 7-bit user data register, TCK 30 ns, every scenario
    parameters      :
      - TESTS_LIST=reset_trst,reset_tms,idcode,bypass,user_dr,idle
      - IR_WIDTH=8
      - DR_WIDTH=7
      - TCK_PERIOD_NS=30

#=========================================
parameters :
#=========================================

  TESTS_LIST :
    description : Scenarios of the testbench, separated by ',' (empty, build and elaboration only)
    datatype    : str
    paramtype   : generic

  #---------------------------------------
  # Generics of tb_jtag (sim_jtag*)
  #---------------------------------------
  IR_WIDTH :
    description : Width of the instruction register of the TAP model (config.ir_width of the BFM)
    datatype    : int
    default     : 5
    paramtype   : generic

  DR_WIDTH :
    description : Width of the user data register of the TAP model
    datatype    : int
    default     : 40
    paramtype   : generic

  TCK_PERIOD_NS :
    description : Period of TCK (ns, even, config.tck_period of the BFM)
    datatype    : int
    default     : 100
    paramtype   : generic

# Next lines is a pragma, don't modify
#<PROVIDER_BEGIN>
provider  :
  name    : github
  user    : deuskane
  repo    : asylum-verification-uvvm
  version : asylum-verification-uvvm-1.0.0
 #version : e737b774593f241127a9fd66ece398bae3a25525
