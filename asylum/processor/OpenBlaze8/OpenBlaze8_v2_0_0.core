filesets:
  #---------------------------------------
  # Generator
  #---------------------------------------
  pbcc_dep:
    depend:
      - asylum:utils:generators

  #---------------------------------------
  # Source Files
  #---------------------------------------
  files_hdl:
    files        :
      - hdl/OpenBlaze8_pkg.vhd
      - hdl/OpenBlaze8_ALU.vhd
      - hdl/OpenBlaze8_Clock.vhd
      - hdl/OpenBlaze8_Control.vhd
      - hdl/OpenBlaze8_Decode.vhd
      - hdl/OpenBlaze8_Flags.vhd
      - hdl/OpenBlaze8_Interrupt.vhd
      - hdl/OpenBlaze8_LoadStore.vhd
      - hdl/OpenBlaze8_Operand.vhd
      - hdl/OpenBlaze8_Program_Counter.vhd
      - hdl/OpenBlaze8_RAM.vhd
      - hdl/OpenBlaze8_RegFile.vhd
      - hdl/OpenBlaze8_Result.vhd
      - hdl/OpenBlaze8_Stack.vhd
      - hdl/OpenBlaze8.vhd
      - hdl/sbi_OpenBlaze8.vhd
    file_type    : vhdlSource-2008
    logical_name : asylum
    depend       :
      - asylum:utils:pkg
      - ">=asylum:component:ram:1.0.0"
      - ">=asylum:component:stack:1.2.0"
      
  #---------------------------------------
  # Testbench Files
  #---------------------------------------
  files_sim:
    files:
      - sim/openblaze8/tb_OpenBlaze8_bfm_pkg.vhd
      - sim/openblaze8/tb_OpenBlaze8_tests_pkg.vhd
      - sim/openblaze8/tb_OpenBlaze8_rom.vhd
      - sim/openblaze8/tb_OpenBlaze8.vhd
    file_type : vhdlSource-2008
    depend    :
      - bitvis:verification:uvvm
      # string_pkg list_length / list_item (TESTS_LIST)
      - ">=asylum:utils:pkg:1.10.0"
      # Reference
      - ">=xilinx:processor:kcpsm:1.30"
      - ">=xilinx:primitive:unisim:11.1"
  #---------------------------------------
  syn:
  #---------------------------------------
    files        :
      - syn/sbi_OpenBlaze8_wrapper.vhd
    file_type    : vhdlSource-2008
    logical_name : asylum
    # ghdl_synth.sh / ghdl_synth.mk (pre_run hook of lint_ghdl_synth_*)
    depend       :
      - asylum:utils:ghdl_synth

  #---------------------------------------
  syn_yosys:
  #---------------------------------------
    # yosys_synth.sh / yosys_synth.mk / yosys_synth.py (pre_run hook of syn_*)
    depend       :
      - asylum:utils:yosys_synth

  # Next line is a pragma, don't modify
  #<FILESETS_BEGIN>
  #<FILESETS_END>
  # Previous line is a pragma, don't modify

targets:

  #---------------------------------------
  # Default Target
  #---------------------------------------
  default: &default
    description     : Default Target
    filesets        :
      - files_hdl
    toplevel        : OpenBlaze8
    default_tool    : ghdl

  #---------------------------------------
  # Lint : -Wall analysis and elaboration (empty simulation) of
  # sbi_OpenBlaze8_wrapper (sbi_OpenBlaze8 and the core)
  #---------------------------------------
  lint_ghdl : &lint_ghdl
    << : *default
    description     : Lint with GHDL (-Wall analysis and elaboration of sbi_OpenBlaze8_wrapper)
    toplevel        : asylum.sbi_OpenBlaze8_wrapper
    filesets_append : [syn]
    default_tool    : ghdl
    tools :
      ghdl :
        analyze_options : ["-Wall"]

  #---------------------------------------
  # Synthesis check : -Wall analysis, ghdl --synth -Wall and elaboration
  # (no simulation) of a variant (OpenBlaze8 : lint_ghdl_synth_core_*,
  # sbi_OpenBlaze8_wrapper : lint_ghdl_synth_sbi_*) with the generics of the
  # target.
  # The pre_run hook (ghdl_synth.sh of asylum:utils:ghdl_synth) adds
  # ghdl_synth.mk to the edalize Makefile.
  # FuseSoC merges tools in depth : analyze_options comes from lint_ghdl.
  #---------------------------------------
  lint_ghdl_synth_core_default : &lint_ghdl_synth
    << : *lint_ghdl
    description     : Synthesis check of OpenBlaze8, default generics (KCPSM3, asynchronous register file)
    toplevel        : asylum.OpenBlaze8
    tools :
      ghdl :
        run_options     : ["--no-run"]
    hooks :
      pre_run : [ghdl_synth]

  #---------------------------------------
  lint_ghdl_synth_core_small :
  #---------------------------------------
    << : *lint_ghdl_synth
    description     : Synthesis check of OpenBlaze8, small configuration (stack 8, RAM 16, 256 instructions)
    parameters      :
      - STACK_DEPTH=8
      - RAM_DEPTH=16
      - ADDR_INST_WIDTH=8

  #---------------------------------------
  lint_ghdl_synth_sbi_default : &lint_ghdl_synth_sbi
  #---------------------------------------
    << : *lint_ghdl_synth
    description     : Synthesis check of sbi_OpenBlaze8_wrapper, default generics (asynchronous register file)
    toplevel        : asylum.sbi_OpenBlaze8_wrapper

  #---------------------------------------
  lint_ghdl_synth_sbi_ram256 :
  #---------------------------------------
    << : *lint_ghdl_synth_sbi
    description     : Synthesis check of sbi_OpenBlaze8_wrapper, RAM 256, synchronous register file (PicoSoC)
    parameters      :
      - RAM_DEPTH=256
      - REGFILE_SYNC_READ=true

  #---------------------------------------
  # Synthesis : size of a variant with the generics of the target, Xilinx
  # Artix-7 (LUT, FF, BRAM, DSP) and sky130 (area), by Yosys and its GHDL
  # plugin. Same configurations as lint_ghdl_synth_*.
  # The pre_run hook (yosys_synth.sh of asylum:utils:yosys_synth) adds
  # yosys_synth.mk to the edalize Makefile.
  #---------------------------------------
  syn_core_default : &syn
    << : *lint_ghdl
    description     : Synthesis (Artix-7, sky130) of OpenBlaze8, default generics (KCPSM3, asynchronous register file)
    toplevel        : asylum.OpenBlaze8
    filesets_append : [syn, syn_yosys]
    tools :
      ghdl :
        run_options     : ["--no-run"]
    hooks :
      pre_run : [yosys_synth]

  #---------------------------------------
  syn_core_small :
  #---------------------------------------
    << : *syn
    description     : Synthesis (Artix-7, sky130) of OpenBlaze8, small configuration (stack 8, RAM 16, 256 instructions)
    parameters      :
      - STACK_DEPTH=8
      - RAM_DEPTH=16
      - ADDR_INST_WIDTH=8

  #---------------------------------------
  syn_sbi_default : &syn_sbi
  #---------------------------------------
    << : *syn
    description     : Synthesis (Artix-7, sky130) of sbi_OpenBlaze8_wrapper, default generics (asynchronous register file)
    toplevel        : asylum.sbi_OpenBlaze8_wrapper

  #---------------------------------------
  syn_sbi_ram256 :
  #---------------------------------------
    << : *syn_sbi
    description     : Synthesis (Artix-7, sky130) of sbi_OpenBlaze8_wrapper, RAM 256, synchronous register file (PicoSoC)
    parameters      :
      - RAM_DEPTH=256
      - REGFILE_SYNC_READ=true

  #---------------------------------------
  # tb_OpenBlaze8 : compiled once per configuration (MODEL,
  # REGFILE_SYNC_READ) with the ROM of every test program (pbcc_gen),
  # programs chosen at run time (TESTS_LIST, empty : build and elaboration
  # only).
  # Reference configuration core : sim_core (build only) and one
  # sim_core_<program> target per program ; the other configurations run
  # every program. Each target repeats the generics of its configuration :
  # FuseSoC replaces the parameters list of an inherited target.
  #---------------------------------------
  sim_core : &sim_core
    << : *default
    description     : Simulation of OpenBlaze8 in lock-step with kcpsm3, KCPSM3 timing (asynchronous register file) - build only (programs of TESTS_LIST)
    toplevel        : tb_OpenBlaze8
    default_tool    : ghdl
    filesets_append :
      - files_sim
      - pbcc_dep
    generate        : [gen_test_000_default, gen_test_001_test_ok, gen_test_002_jump, gen_test_003_jump, gen_test_004_comp, gen_test_005_comp, gen_test_006_and, gen_test_007_or, gen_test_008_xor, gen_test_009_andi, gen_test_010_ori, gen_test_011_xori, gen_test_012_add, gen_test_013_addi, gen_test_014_sub, gen_test_015_subi, gen_test_016_comp, gen_test_017_compi, gen_test_018_rl, gen_test_019_rr, gen_test_020_sl0, gen_test_021_sl1, gen_test_022_sla, gen_test_023_slx, gen_test_024_sr, gen_test_025_call, gen_test_026_call_ret, gen_test_027_call_ret, gen_test_028_call_ret_cond, gen_test_029_fetch_store, gen_test_030_fetch_store, gen_test_031_fetch_store, gen_test_032_stack_depth, gen_test_033_mul, gen_test_034_div, gen_test_035_test, gen_test_036_test, gen_test_037_in_out, gen_test_038_in_out, gen_test_039_eint_reti, gen_test_040_eint_reti, gen_test_041_eint_reti, gen_test_042_in_out_indirect, gen_test_043_carry, gen_test_044_reti_flags, gen_test_045_int_reset, gen_test_uadd16, gen_test_udiv16, gen_test_umul16]
    parameters      :
      - TESTS_LIST
      - MODEL=core
      - REGFILE_SYNC_READ=false
    tools :
      ghdl :
        analyze_options : ["-Wall","-fsynopsys","-frelaxed"]
        run_options     : ["--fst=dut.fst","--ieee-asserts=disable"]

  #---------------------------------------
  sim_core_regfile_sync :
  #---------------------------------------
    << : *sim_core
    description     : Simulation of OpenBlaze8 in lock-step with kcpsm3, synchronous register file - every program
    parameters      :
      - TESTS_LIST=test_000_default,test_001_test_ok,test_002_jump,test_003_jump,test_004_comp,test_005_comp,test_006_and,test_007_or,test_008_xor,test_009_andi,test_010_ori,test_011_xori,test_012_add,test_013_addi,test_014_sub,test_015_subi,test_016_comp,test_017_compi,test_018_rl,test_019_rr,test_020_sl0,test_021_sl1,test_022_sla,test_023_slx,test_024_sr,test_025_call,test_026_call_ret,test_027_call_ret,test_028_call_ret_cond,test_029_fetch_store,test_030_fetch_store,test_031_fetch_store,test_032_stack_depth,test_033_mul,test_034_div,test_035_test,test_036_test,test_037_in_out,test_038_in_out,test_039_eint_reti,test_040_eint_reti,test_041_eint_reti,test_042_in_out_indirect,test_043_carry,test_044_reti_flags,test_045_int_reset,test_uadd16,test_udiv16,test_umul16
      - MODEL=core
      - REGFILE_SYNC_READ=true

  #---------------------------------------
  sim_sbi_regfile_sync :
  #---------------------------------------
    << : *sim_core
    description     : Simulation of sbi_OpenBlaze8 in lock-step with kcpsm3, synchronous register file (PicoSoC), random cke_i and SBI ready (stalls) - every program
    parameters      :
      - TESTS_LIST=test_000_default,test_001_test_ok,test_002_jump,test_003_jump,test_004_comp,test_005_comp,test_006_and,test_007_or,test_008_xor,test_009_andi,test_010_ori,test_011_xori,test_012_add,test_013_addi,test_014_sub,test_015_subi,test_016_comp,test_017_compi,test_018_rl,test_019_rr,test_020_sl0,test_021_sl1,test_022_sla,test_023_slx,test_024_sr,test_025_call,test_026_call_ret,test_027_call_ret,test_028_call_ret_cond,test_029_fetch_store,test_030_fetch_store,test_031_fetch_store,test_032_stack_depth,test_033_mul,test_034_div,test_035_test,test_036_test,test_037_in_out,test_038_in_out,test_039_eint_reti,test_040_eint_reti,test_041_eint_reti,test_042_in_out_indirect,test_043_carry,test_044_reti_flags,test_045_int_reset,test_uadd16,test_udiv16,test_umul16
      - MODEL=sbi
      - REGFILE_SYNC_READ=true

  # Next line is a pragma, don't modify
  #<TARGETS_BEGIN>
  #---------------------------------------
  sim_core_test_000_default:
  #---------------------------------------
    << : *sim_core
    description     : Simulation of OpenBlaze8 in lock-step with kcpsm3 - program sim/testbench-asm/test_000_default.psm, default program (writes the OK trigger)
    parameters      :
