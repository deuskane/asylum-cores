CAPI=2:

#-----------------------------------------------------------------------------
# Title      : OpenBlaze8 Core file
# Project    : Asylum
#-----------------------------------------------------------------------------
# File       : Openblaze8.core
# Author     : mrosiere
#-----------------------------------------------------------------------------
# Description: 
#-----------------------------------------------------------------------------
# Copyright (c) 2021
#-----------------------------------------------------------------------------
# Revisions  :
# Date        Version  Author   Description
# 2021-10-26  1.0.0    mrosiere Created
# 2021-11-03  1.0.1    mrosiere Use generator
# 2021-11-16  1.1.0    mrosiere Delete Debug Bus
# 2025-09-06  1.1.1    mrosiere Use package
# 2025-11-05  1.2.0    mrosiere Add parameter for sync/async regfile
# 2025-11-22  1.3.0    mrosiere Add sbi wrapper
# 2026-05-24  1.3.1    mrosiere Fix internal cke condition
# 2026-06-15  1.3.2    mrosiere Delete MULTI_CYCLE parameter
# 2026-11-17  2.0.0    mrosiere KCPSM3 timing : internal reset released 2
#                               cycles after reset_i, synchronous reset of
#                               the cycle phase and of the stack (stack >=
#                               1.2.0, cyclic pointer), registered
#                               read_strobe / write_strobe,
#                               REGFILE_SYNC_READ = false by default,
#                               generic checks, lint_ghdl targets
#-----------------------------------------------------------------------------

name        : asylum:processor:OpenBlaze8:2.0.0
description : OpenBlaze8

