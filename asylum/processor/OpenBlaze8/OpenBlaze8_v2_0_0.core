  # Previous line is a pragma, don't modify

scripts:

  #---------------------------------------
  # pre_run hook of lint_ghdl_synth_* (cwd = work_root)
  #---------------------------------------
  ghdl_synth :
    cmd : [bash, ghdl_synth.sh]

  #---------------------------------------
  # pre_run hook of syn_* (cwd = work_root)
  #---------------------------------------
  yosys_synth :
    cmd : [bash, yosys_synth.sh]

#=========================================
parameters :
#=========================================

  #---------------------------------------
  # Generics of OpenBlaze8 / sbi_OpenBlaze8_wrapper (lint_ghdl_synth_*, syn_*)
  #---------------------------------------
  STACK_DEPTH :
    description : Depth of the call stack
    datatype    : int
    default     : 32
    paramtype   : generic

  RAM_DEPTH :
    description : Depth of the scratchpad RAM
    datatype    : int
    default     : 64
    paramtype   : generic

  ADDR_INST_WIDTH :
    description : Width of the instruction address
    datatype    : int
    default     : 10
    paramtype   : generic

  REGFILE_SYNC_READ :
    description : true, register file with synchronous read
    datatype    : bool
    default     : false
    paramtype   : generic

  #---------------------------------------
  # Generics of tb_OpenBlaze8 (sim_*), with REGFILE_SYNC_READ
  #---------------------------------------
  TESTS_LIST :
    description : Programs run in sequence, separated by commas (empty, build only)
    datatype    : str
    paramtype   : generic

  MODEL :
    description : DUT of the testbench, core (OpenBlaze8) or sbi (sbi_OpenBlaze8 with stalls)
    datatype    : str
    default     : core
    paramtype   : generic

# Next lines is a pragma, don't modify
#<PROVIDER_BEGIN>
provider  :
  name    : github
  user    : deuskane
  repo    : asylum-processor-OpenBlaze8
  version : asylum-processor-OpenBlaze8-2.0.0
 #version : 5397ba794e479990273f1c93fd07efec869b3a78
#<PROVIDER_END>
