CAPI=2:

#-----------------------------------------------------------------------------
# Title      : ICN Core file
# Project    : Asylum
#-----------------------------------------------------------------------------
# File       : ICN.core
# Author     : mrosiere
#-----------------------------------------------------------------------------
# Description: 
#-----------------------------------------------------------------------------
# Copyright (c) 2025
#-----------------------------------------------------------------------------
# Revisions  :
# Date        Version  Author   Description
# 2025-03-22  1.0.0    mrosiere Created
# 2025-04-05  1.1.0    mrosiere Add Algo
# 2025-05-08  1.2.0    mrosiere Change to into downto
# 2025-09-05  1.2.1    mrosiere Add Package
# 2025-11-22  1.2.2    mrosiere Use sbi instead pbi
# 2026-01-18  1.2.3    mrosiere Use info record of sbi
# 2026-05-22  1.3.0    mrosiere Add explicit default slave
# 2026-06-02  1.3.1    mrosiere Fix multi driver
# 2026-06-05  1.3.2    mrosiere Add default slave dedicated port option
# 2026-08-16  1.3.3    mrosiere Fix default slave dedicated port
#                               Add name in all instances
# 2026-10-05  1.3.4    mrosiere Fix reset condition of sbi_pipe protocol check
#                               Add sim_pipe target (sbi_pipe on all ports)
# 2026-11-17  1.4.0    mrosiere sbi_icn_mux_mst releases the bus when the granted
#                               master drops cs, one-hot overlap check, 0-bit
#                               address width targets, arbitration and SoC
#                               configuration tests (sim_soc, sim_one_hot)
#-----------------------------------------------------------------------------

name        : asylum:infrastructure:icn:1.4.0
description : Interconnection

#=========================================
filesets:
#=========================================

  #---------------------------------------
  hdl:
  #---------------------------------------
    files        :
      - hdl/icn_pkg.vhd
      - hdl/sbi_default_slave.vhd
      - hdl/sbi_pipe.vhd
      - hdl/sbi_icn_mux_mst.vhd
      - hdl/sbi_icn_mux_tgt.vhd
      - hdl/sbi_icn.vhd
      - hdl/sbi_wrapper_target.vhd
    file_type    : vhdlSource-2008
    logical_name : asylum
    depend       :
      - asylum:utils:pkg


  #---------------------------------------
  sim_icn:
  #---------------------------------------
    files        :
      - sim/icn/tb_sbi_icn_bfm_pkg.vhd
      - sim/icn/tb_sbi_icn_simple_pkg.vhd
      - sim/icn/tb_sbi_icn_default_slave_pkg.vhd
      - sim/icn/tb_sbi_icn_exhaustive_pkg.vhd
      - sim/icn/tb_sbi_icn_arbitration_pkg.vhd
      - sim/icn/tb_sbi_icn_contention_pkg.vhd
      - sim/icn/tb_sbi_icn_abort_pkg.vhd
      - sim/icn/tb_sbi_icn_latency_pkg.vhd
      - sim/icn/tb_sbi_icn_clock_enable_pkg.vhd
      - sim/icn/tb_sbi_icn_reset_pkg.vhd
      - sim/icn/tb_sbi_icn_tests_pkg.vhd
      - sim/icn/tb_sbi_icn.vhd
    file_type    : vhdlSource-2008
    depend       :
      - bitvis:verification:uvvm
      # string_pkg list_length / list_item / list_contains (TESTS_LIST)
      - ">=asylum:utils:pkg:1.10.0"


  #---------------------------------------
  syn:
  #---------------------------------------
    files        :
      - syn/sbi_icn_wrapper.vhd
    file_type    : vhdlSource-2008
    logical_name : asylum
    # ghdl_synth.sh / ghdl_synth.mk (pre_run hook of lint_ghdl_synth_*)
    depend       :
      - asylum:utils:ghdl_synth

  #---------------------------------------
  syn_yosys:
  #---------------------------------------
    # yosys_synth.sh / yosys_synth.mk / yosys_synth.py (pre_run hook of syn_*)
    depend       :
      - asylum:utils:yosys_synth

#=========================================
targets:
#=========================================

  #---------------------------------------
  default: &default
  #---------------------------------------
    description     : Default Target
    filesets        :
      - hdl

  #---------------------------------------
  # Lint : -Wall analysis and elaboration (empty simulation)
  #---------------------------------------
  lint_ghdl : &lint_ghdl
    << : *default
    description     : Lint with GHDL (-Wall analysis and elaboration of sbi_icn_wrapper)
    toplevel        : asylum.sbi_icn_wrapper
    filesets_append : [syn]
    default_tool    : ghdl
    tools :
      ghdl :
        analyze_options : ["-Wall"]

  #---------------------------------------
  # Synthesis check : -Wall analysis, ghdl --synth -Wall and elaboration
  # (no simulation) of sbi_icn_wrapper with the generics of the target.
  # The pre_run hook (ghdl_synth.sh of asylum:utils:ghdl_synth) adds
  # ghdl_synth.mk to the edalize Makefile.
  # FuseSoC merges tools in depth : analyze_options comes from lint_ghdl.
  #---------------------------------------
  lint_ghdl_synth_default : &lint_ghdl_synth
    << : *lint_ghdl
    description     : Synthesis check of sbi_icn_wrapper, PicoSoC ICN2 (default generics)
    tools :
      ghdl :
        run_options     : ["--no-run"]
    hooks :
      pre_run : [ghdl_synth]

  #---------------------------------------
  lint_ghdl_synth_picosoc_icn1 :
  #---------------------------------------
    << : *lint_ghdl_synth
    description     : Synthesis check of sbi_icn_wrapper, PicoSoC ICN1
    parameters      :
      - ADDR_MAP=picosoc_icn1
      - INTERNAL_DEFAULT_SLAVE=false

  #---------------------------------------
  lint_ghdl_synth_picosoc_rr :
  #---------------------------------------
    << : *lint_ghdl_synth
    description     : Synthesis check of sbi_icn_wrapper, PicoSoC ICN2 with 2 masters roundrobin
    parameters      :
      - NB_MASTER=2
      - MASTER_SEL=roundrobin

  #---------------------------------------
  lint_ghdl_synth_tb :
  #---------------------------------------
    << : *lint_ghdl_synth
    description     : Synthesis check of sbi_icn_wrapper, address map of tb_sbi_icn
    parameters      :
      - NB_MASTER=2
      - MASTER_SEL=roundrobin
      - TARGET_SEL=mux
      - ADDR_MAP=tb

  #---------------------------------------
  lint_ghdl_synth_tb_pipe :
  #---------------------------------------
    << : *lint_ghdl_synth
    description     : Synthesis check of sbi_icn_wrapper, address map of tb_sbi_icn with sbi_pipe
    parameters      :
      - NB_MASTER=2
      - MASTER_SEL=roundrobin
      - TARGET_SEL=mux
      - ADDR_MAP=tb
      - PIPEIN=true
      - PIPEOUT=true

  #---------------------------------------
  lint_ghdl_synth_one_hot :
  #---------------------------------------
    << : *lint_ghdl_synth
    description     : Synthesis check of sbi_icn_wrapper, 3 masters, 4 targets one_hot
    parameters      :
      - NB_MASTER=3
      - ADDR_MAP=one_hot

  #---------------------------------------
  lint_ghdl_width0 :
  #---------------------------------------
    << : *lint_ghdl
    description     : Lint with GHDL of sbi_icn_wrapper, single-register targets (0-bit address width), configuration checks run
    parameters      :
      - ADDR_MAP=width0

  #---------------------------------------
  lint_ghdl_synth_width0 :
  #---------------------------------------
    << : *lint_ghdl_synth
    description     : Synthesis check of sbi_icn_wrapper, single-register targets (0-bit address width)
    parameters      :
      - ADDR_MAP=width0

  #---------------------------------------
  # Synthesis : size of sbi_icn_wrapper with the generics of the target,
  # Xilinx Artix-7 (LUT, FF, BRAM, DSP) and sky130 (area), by Yosys and
  # its GHDL plugin. Same configurations as lint_ghdl_synth_*.
  # The pre_run hook (yosys_synth.sh of asylum:utils:yosys_synth) adds
  # yosys_synth.mk to the edalize Makefile.
  #---------------------------------------
  syn_default : &syn
    << : *lint_ghdl
    description     : Synthesis (Artix-7, sky130) of sbi_icn_wrapper, PicoSoC ICN2 (default generics)
    filesets_append : [syn, syn_yosys]
    tools :
      ghdl :
        run_options     : ["--no-run"]
    hooks :
      pre_run : [yosys_synth]

  #---------------------------------------
  syn_picosoc_icn1 :
  #---------------------------------------
    << : *syn
    description     : Synthesis (Artix-7, sky130) of sbi_icn_wrapper, PicoSoC ICN1
    parameters      :
      - ADDR_MAP=picosoc_icn1
      - INTERNAL_DEFAULT_SLAVE=false

  #---------------------------------------
  syn_picosoc_rr :
  #---------------------------------------
    << : *syn
    description     : Synthesis (Artix-7, sky130) of sbi_icn_wrapper, PicoSoC ICN2 with 2 masters roundrobin
    parameters      :
      - NB_MASTER=2
      - MASTER_SEL=roundrobin

  #---------------------------------------
  syn_tb :
  #---------------------------------------
    << : *syn
    description     : Synthesis (Artix-7, sky130) of sbi_icn_wrapper, address map of tb_sbi_icn
    parameters      :
      - NB_MASTER=2
      - MASTER_SEL=roundrobin
      - TARGET_SEL=mux
      - ADDR_MAP=tb

  #---------------------------------------
  syn_tb_pipe :
  #---------------------------------------
    << : *syn
    description     : Synthesis (Artix-7, sky130) of sbi_icn_wrapper, address map of tb_sbi_icn with sbi_pipe
    parameters      :
      - NB_MASTER=2
      - MASTER_SEL=roundrobin
      - TARGET_SEL=mux
      - ADDR_MAP=tb
      - PIPEIN=true
      - PIPEOUT=true

  #---------------------------------------
  syn_one_hot :
  #---------------------------------------
    << : *syn
    description     : Synthesis (Artix-7, sky130) of sbi_icn_wrapper, 3 masters, 4 targets one_hot
    parameters      :
      - NB_MASTER=3
      - ADDR_MAP=one_hot

  #---------------------------------------
  syn_width0 :
  #---------------------------------------
    << : *syn
    description     : Synthesis (Artix-7, sky130) of sbi_icn_wrapper, single-register targets (0-bit address width)
    parameters      :
      - ADDR_MAP=width0

  #---------------------------------------
  # tb_sbi_icn (sim/icn) : compiled once per configuration, scenarios
  # chosen at run time (TESTS_LIST, empty : build and elaboration only).
  # Reference configuration sim_soc (fix, or, external default slave,
  # wait states : every scenario applies) : sim_soc (build only) and one
  # sim_soc_<test> target per scenario ; sim_basic, sim_pipe and
  # sim_one_hot run the whole list (abort needs wait states and no
  # sbi_pipe on the master ports : not in sim_basic and sim_pipe). Each
  # target repeats the generics of its configuration : FuseSoC replaces
  # the parameters list of an inherited target.
  #---------------------------------------
  sim_soc: &sim_soc
    << : *default
    description     : Simulation of sbi_icn (UVVM), SoC configuration (fix, or, external default slave, 2 wait states per target index) - build only (scenarios of TESTS_LIST)
    filesets_append :
      - sim_icn
    toplevel        : tb_sbi_icn
    parameters      :
      - TESTS_LIST
      - MASTER_SEL=fix
      - TARGET_SEL=or
      - TARGET_ADDR_ENCODING=binary
      - INTERNAL_DEFAULT_SLAVE=false
      - WAIT_STATES=2
      - PIPEIN=false
      - PIPEOUT=false
    default_tool    : ghdl
    tools :
      ghdl :
        analyze_options :
          - "$(GHDL_ANALYZE_OPTION)"
          - "-Wall"
          - "-frelaxed"
        run_options     :
          - "$(GHDL_RUN_OPTION)"
          - "--ieee-asserts=disable"
          - "--assert-level=error"

  #---------------------------------------
  sim_soc_simple:
  #---------------------------------------
    << : *sim_soc
    description     : Simulation of sbi_icn (UVVM), SoC configuration - each memory target written by a master and read back by the other one, address decoding
    parameters      :
      - TESTS_LIST=simple
      - MASTER_SEL=fix
      - TARGET_SEL=or
      - TARGET_ADDR_ENCODING=binary
      - INTERNAL_DEFAULT_SLAVE=false
      - WAIT_STATES=2
      - PIPEIN=false
      - PIPEOUT=false

  #---------------------------------------
  sim_soc_default_slave:
  #---------------------------------------
    << : *sim_soc
    description     : Simulation of sbi_icn (UVVM), SoC configuration - accesses to unmapped addresses (default slave)
    parameters      :
      - TESTS_LIST=default_slave
      - MASTER_SEL=fix
      - TARGET_SEL=or
      - TARGET_ADDR_ENCODING=binary
      - INTERNAL_DEFAULT_SLAVE=false
      - WAIT_STATES=2
      - PIPEIN=false
      - PIPEOUT=false

  #---------------------------------------
  sim_soc_exhaustive:
  #---------------------------------------
    << : *sim_soc
    description     : Simulation of sbi_icn (UVVM), SoC configuration - every address of every memory target, accesses switching from one target to the other
    parameters      :
      - TESTS_LIST=exhaustive
      - MASTER_SEL=fix
      - TARGET_SEL=or
      - TARGET_ADDR_ENCODING=binary
      - INTERNAL_DEFAULT_SLAVE=false
      - WAIT_STATES=2
      - PIPEIN=false
      - PIPEOUT=false

  #---------------------------------------
  sim_soc_arbitration:
  #---------------------------------------
    << : *sim_soc
    description     : Simulation of sbi_icn (UVVM), SoC configuration - simultaneous requests of the two masters, first granted master
    parameters      :
      - TESTS_LIST=arbitration
      - MASTER_SEL=fix
      - TARGET_SEL=or
      - TARGET_ADDR_ENCODING=binary
      - INTERNAL_DEFAULT_SLAVE=false
      - WAIT_STATES=2
      - PIPEIN=false
      - PIPEOUT=false

  #---------------------------------------
  sim_soc_contention:
  #---------------------------------------
    << : *sim_soc
    description     : Simulation of sbi_icn (UVVM), SoC configuration - back-to-back accesses of both masters, order of the grants
    parameters      :
      - TESTS_LIST=contention
      - MASTER_SEL=fix
      - TARGET_SEL=or
      - TARGET_ADDR_ENCODING=binary
      - INTERNAL_DEFAULT_SLAVE=false
      - WAIT_STATES=2
      - PIPEIN=false
      - PIPEOUT=false

  #---------------------------------------
  sim_soc_abort:
  #---------------------------------------
    << : *sim_soc
    description     : Simulation of sbi_icn (UVVM), SoC configuration - the granted master releases cs before ready, the other master is not locked out
    parameters      :
      - TESTS_LIST=abort
      - MASTER_SEL=fix
      - TARGET_SEL=or
      - TARGET_ADDR_ENCODING=binary
      - INTERNAL_DEFAULT_SLAVE=false
      - WAIT_STATES=2
      - PIPEIN=false
      - PIPEOUT=false

  #---------------------------------------
  sim_soc_latency:
  #---------------------------------------
    << : *sim_soc
    description     : Simulation of sbi_icn (UVVM), SoC configuration - cycles from the request to ready for every target port and the default slave
    parameters      :
      - TESTS_LIST=latency
      - MASTER_SEL=fix
      - TARGET_SEL=or
      - TARGET_ADDR_ENCODING=binary
      - INTERNAL_DEFAULT_SLAVE=false
      - WAIT_STATES=2
      - PIPEIN=false
      - PIPEOUT=false

  #---------------------------------------
  sim_soc_clock_enable:
  #---------------------------------------
    << : *sim_soc
    description     : Simulation of sbi_icn (UVVM), SoC configuration - cke_i = 0 holds an access, before and after the grant
    parameters      :
      - TESTS_LIST=clock_enable
      - MASTER_SEL=fix
      - TARGET_SEL=or
      - TARGET_ADDR_ENCODING=binary
      - INTERNAL_DEFAULT_SLAVE=false
      - WAIT_STATES=2
      - PIPEIN=false
      - PIPEOUT=false

  #---------------------------------------
  sim_soc_reset:
  #---------------------------------------
    << : *sim_soc
    description     : Simulation of sbi_icn (UVVM), SoC configuration - request held through a reset, reset during an access
    parameters      :
      - TESTS_LIST=reset
      - MASTER_SEL=fix
      - TARGET_SEL=or
      - TARGET_ADDR_ENCODING=binary
      - INTERNAL_DEFAULT_SLAVE=false
      - WAIT_STATES=2
      - PIPEIN=false
      - PIPEOUT=false

  #---------------------------------------
  sim_basic:
  #---------------------------------------
    << : *sim_soc
    description     : Simulation of sbi_icn (UVVM), roundrobin, mux, internal default slave, no wait state - every scenario
    parameters      :
      - TESTS_LIST=simple,default_slave,exhaustive,arbitration,contention,latency,clock_enable,reset
      - MASTER_SEL=roundrobin
      - TARGET_SEL=mux
      - TARGET_ADDR_ENCODING=binary
      - INTERNAL_DEFAULT_SLAVE=true
      - WAIT_STATES=0
      - PIPEIN=false
      - PIPEOUT=false

  #---------------------------------------
  sim_pipe:
  #---------------------------------------
    << : *sim_soc
    description     : Simulation of sbi_icn (UVVM), sbi_pipe on every master and target port (roundrobin, mux, internal default slave, 1 wait state per target index) - every scenario
    parameters      :
      - TESTS_LIST=simple,default_slave,exhaustive,arbitration,contention,latency,clock_enable,reset
      - MASTER_SEL=roundrobin
      - TARGET_SEL=mux
      - TARGET_ADDR_ENCODING=binary
      - INTERNAL_DEFAULT_SLAVE=true
      - WAIT_STATES=1
      - PIPEIN=true
      - PIPEOUT=true

  #---------------------------------------
  sim_one_hot:
  #---------------------------------------
    << : *sim_soc
    description     : Simulation of sbi_icn (UVVM), one-hot address decoding (roundrobin, or, internal default slave, 1 wait state per target index) - every scenario
    parameters      :
      - TESTS_LIST=simple,default_slave,exhaustive,arbitration,contention,abort,latency,clock_enable,reset
      - MASTER_SEL=roundrobin
      - TARGET_SEL=or
      - TARGET_ADDR_ENCODING=one_hot
      - INTERNAL_DEFAULT_SLAVE=true
      - WAIT_STATES=1
      - PIPEIN=false
      - PIPEOUT=false

#=========================================
scripts:
#=========================================

  #---------------------------------------
  # pre_run hook of lint_ghdl_synth_* (cwd = work_root)
  #---------------------------------------
  ghdl_synth :
    cmd : [bash, ghdl_synth.sh]

  #---------------------------------------
  # pre_run hook of syn_* (cwd = work_root)
  #---------------------------------------
  yosys_synth :
    cmd : [bash, yosys_synth.sh]

#=========================================
parameters :
#=========================================

  TESTS_LIST :
    description : Scenarios run in sequence, separated by ',' (names in sim/icn/tb_sbi_icn_tests_pkg.vhd), empty = build only
    datatype    : str
    default     : ""
    paramtype   : generic

  PIPEIN :
    description : Insert an sbi_pipe stage on every master port (PIPEIN_ENABLE), wrapper and testbench
    datatype    : bool
    default     : false
    paramtype   : generic

  PIPEOUT :
    description : Insert an sbi_pipe stage on every target port (PIPEOUT_ENABLE), wrapper and testbench
    datatype    : bool
    default     : false
    paramtype   : generic

  #---------------------------------------
  # Generics of sbi_icn_wrapper (lint_ghdl_synth_*) and of the testbench (sim_*)
  #---------------------------------------
  NB_MASTER :
    description : Number of masters
    datatype    : int
    default     : 1
    paramtype   : generic

  MASTER_SEL :
    description : Master arbitration (fix / roundrobin), wrapper and testbench
    datatype    : str
    default     : fix
    paramtype   : generic

  TARGET_SEL :
    description : Target read data selection (or / mux), wrapper and testbench
    datatype    : str
    default     : or
    paramtype   : generic

  ADDR_MAP :
    description : Address map of sbi_icn_wrapper (picosoc_icn2 / picosoc_icn1 / tb / one_hot / width0)
    datatype    : str
    default     : picosoc_icn2
    paramtype   : generic

  INTERNAL_DEFAULT_SLAVE :
    description : true, internal default slave ; false, external default slave on the last target port (testbench, a memory model)
    datatype    : bool
    default     : true
    paramtype   : generic

  TARGET_ADDR_ENCODING :
    description : Testbench only, address decoding of the interconnect ("binary" / "one_hot")
    datatype    : str
    default     : binary
    paramtype   : generic

  WAIT_STATES :
    description : Testbench only, target i answers after WAIT_STATES*i cycles
    datatype    : int
    default     : 0
    paramtype   : generic

# Next lines is a pragma, don't modify
#<PROVIDER_BEGIN>
provider  :
  name    : github
  user    : deuskane
  repo    : asylum-infrastructure_icn
  version : asylum-infrastructure-icn-1.4.0
 #version : 854268064415bd02fe829191b4d1d5a4d75bab9a
#<PROVIDER_END>
