      - HWLA_BAUD_RATE=9600
      - HWLA_DEPTH=1024
      - HWLA_PRE_TRIGGER=16
      - JTAG_BAUD_RATE=9600
      - USER_UART_DEPTH_TX=4
      - USER_UART_DEPTH_RX=4
