      - USER_FAULT_INJECTION=true
      - DEBUG_ENABLE=true
      - USER_CPU_DEBUG_ENABLE=true
      - SUPERVISOR_CPU_DEBUG_ENABLE=true
      - FSYS=25000000
      - FSYS_INT=12500000
      - USER_NB_SWITCH=4
