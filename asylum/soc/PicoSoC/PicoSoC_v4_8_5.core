  #---------------------------------------
  # OpenOCD + GDB co-simulation (tb_PicoSoC_openocd, GDB scenario
  # sim/openocd/picosoc.py) through the UART pads : JTAG pins
  # (debug_mux_sel_i 10, PIN mode of asylum:verification:openocd) or JTAG
  # over the UART (11, BYTE mode). Needs gcc, openocd and gdb-multiarch
  # (hooks rbb/cosim.sh of the kit, run in the work root). No waveform.
  # The mode 11 target runs 18 to 34 minutes : leading '_', no CI job, not
  # in nonreg, run by hand (make _sim_...).
  #---------------------------------------
  sim_soc2_wardrv_fsm_fault_c_user_openocd_jtag: &sim_openocd
  #---------------------------------------
    << : *default
    description       : OpenOCD + GDB co-simulation of the test esw/demo/user.c - Without Supervisor, Safety Lock-Step, With    Fault Injection, JTAG chain of the user CPU and injection TAPs, JTAG pins on the UART pads (debug_mux_sel_i 10, TCK = FSYS_INT / 8), scenario sim/openocd/picosoc.py (IDCODEs, GDB halt / resume of the user CPU, INJECT)
    default_tool      : ghdl
    toplevel          : tb_PicoSoC_openocd
    generate          : [gen_rv32i_user_c,gen_rv32i_supervisor_c_dummy]
    filesets_append   : &filesets_openocd
      - files_sim
      - files_sim_openocd
      - pbcc_dep
    parameters        : &cfg_soc2_wardrv_fsm_fault_openocd
      - CPU_MODEL=WardRV_fsm
      - FSYS=25000000
      - FSYS_INT=12500000
      - JTAG_BAUD_RATE=921600

      # Platform Configuration
      - SUPERVISOR=false
      - USER_SAFETY=lock-step
      - USER_FAULT_INJECTION=true

      # Debug
      - DEBUG_ENABLE=true
      - USER_CPU_DEBUG_ENABLE=true

      # Test Bench Configuration
      - TB_WATCHDOG=200000
    parameters_append :
      - DEBUG_MUX_SEL=10
    tools : &tools_openocd
      ghdl :
        analyze_options : ["-Wall","-fsynopsys","-frelaxed","--no-vital-checks"]
        run_options     : ["$(GHDL_RUN_OPTION)","--ieee-asserts=disable"]
    hooks :
      pre_build         : [cosim_build]
      pre_run           : [cosim_start]
      post_run          : [cosim_check]

  #---------------------------------------
  _sim_soc2_wardrv_fsm_fault_c_user_openocd_bitbang:
  #---------------------------------------
    << : *sim_openocd
    description       : OpenOCD + GDB co-simulation of the test esw/demo/user.c - Without Supervisor, Safety Lock-Step, With    Fault Injection, JTAG chain of the user CPU and injection TAPs, JTAG over the UART pads (debug_mux_sel_i 11, 921600 baud), scenario sim/openocd/picosoc.py (IDCODEs, GDB halt / resume of the user CPU, INJECT)
    parameters_append :
      - DEBUG_MUX_SEL=11

  #---------------------------------------
  # OpenOCD co-simulation of a JTAG chain of 4 TAPs (tb_PicoSoC_openocd,
  # OpenOCD script sim/openocd/chain.cfg, no GDB) : the hook pre_run of
  # sim_openocd would add to cosim_start_chain (hooks are merged in depth),
  # so the target takes its pieces (filesets, tools)
  #---------------------------------------
  sim_soc3x2_wardrv_fsm_c_user_openocd_chain:
  #---------------------------------------
    << : *default
    description       : OpenOCD co-simulation of the test esw/demo/user.c - With    Supervisor, Safety Lock-Step, Without Fault Injection, 2 CPUs, JTAG chain of 4 TAPs (2 user CPUs, supervisor CPU, injection), JTAG pins on the UART pads (debug_mux_sel_i 10, TCK = FSYS_INT / 8), script sim/openocd/chain.cfg (IDCODE of every TAP, riscv targets examined)
    default_tool      : ghdl
    toplevel          : tb_PicoSoC_openocd
    generate          : [gen_rv32i_user_c,gen_rv32i_supervisor_c]
    filesets_append   : *filesets_openocd
    parameters        : &cfg_soc3x2_wardrv_fsm_openocd
      - CPU_MODEL=WardRV_fsm
      - FSYS=25000000
      - FSYS_INT=12500000

      # SoC User Configuration
      - USER_NB_CPU=2

      # Platform Configuration
      - SUPERVISOR=true
      - USER_SAFETY=lock-step
      - USER_FAULT_INJECTION=false

      # Debug
      - DEBUG_ENABLE=true
      - USER_CPU_DEBUG_ENABLE=true
      - SUPERVISOR_CPU_DEBUG_ENABLE=true

      # Test Bench Configuration
      - TB_WATCHDOG=200000
      - DEBUG_MUX_SEL=10
    tools             : *tools_openocd
    hooks :
      pre_build         : [cosim_build]
      pre_run           : [cosim_start_chain]
      post_run          : [cosim_check]

  #---------------------------------------
  # OpenOCD co-simulation of the discovery of the JTAG chain
  # (tb_PicoSoC_openocd, OpenOCD script sim/openocd/discover_check.cfg on
  # tools/openocd/discover.cfg, no GDB) : the printed number of TAPs,
  # IDCODEs and picosoc_chain line against the chain of the generics
  # (PICOSOC_CHAIN of cosim.cfg, written by the testbench). Own hooks, as
  # sim_soc3x2_wardrv_fsm_c_user_openocd_chain
  #---------------------------------------
  sim_soc3x2_wardrv_fsm_c_user_openocd_discover:
  #---------------------------------------
    << : *default
    description       : OpenOCD co-simulation of the test esw/demo/user.c - With    Supervisor, Safety Lock-Step, Without Fault Injection, 2 CPUs, JTAG chain of 4 TAPs (2 user CPUs, supervisor CPU, injection), JTAG pins on the UART pads (debug_mux_sel_i 10, TCK = FSYS_INT / 8), discovery of the chain tools/openocd/discover.cfg checked by sim/openocd/discover_check.cfg (number of TAPs, IDCODEs, picosoc_chain)
    default_tool      : ghdl
    toplevel          : tb_PicoSoC_openocd
    generate          : [gen_rv32i_user_c,gen_rv32i_supervisor_c]
    filesets_append   : *filesets_openocd
    parameters        : *cfg_soc3x2_wardrv_fsm_openocd
    tools             : *tools_openocd
    hooks :
      pre_build         : [cosim_build]
      pre_run           : [cosim_start_discover]
      post_run          : [cosim_check]

  #---------------------------------------
  sim_soc1_wardrv_fsm_c_user_openocd_discover:
  #---------------------------------------
    << : *default
    description       : OpenOCD co-simulation of the test esw/demo/user.c - Without Supervisor, Safety None     , Without Fault Injection, JTAG chain of 1 TAP (user CPU, as emu_ng_medium_soc1_wardrv_fsm), JTAG pins on the UART pads (debug_mux_sel_i 10, TCK = FSYS_INT / 8), discovery of the chain tools/openocd/discover.cfg checked by sim/openocd/discover_check.cfg (number of TAPs, IDCODEs, picosoc_chain)
    default_tool      : ghdl
    toplevel          : tb_PicoSoC_openocd
    generate          : [gen_rv32i_user_c,gen_rv32i_supervisor_c_dummy]
    filesets_append   : *filesets_openocd
    parameters        : &cfg_soc1_wardrv_fsm_openocd
      - CPU_MODEL=WardRV_fsm
      - FSYS=25000000
      - FSYS_INT=12500000

      # Platform Configuration
      - SUPERVISOR=false
      - USER_SAFETY=none
      - USER_FAULT_INJECTION=false

      # Debug
      - DEBUG_ENABLE=false
      - USER_CPU_DEBUG_ENABLE=true

      # Test Bench Configuration
      - TB_WATCHDOG=200000
      - DEBUG_MUX_SEL=10
    tools             : *tools_openocd
    hooks :
      pre_build         : [cosim_build]
      pre_run           : [cosim_start_discover]
      post_run          : [cosim_check]

  #---------------------------------------
  # OpenOCD co-simulations of tools/openocd/picosoc.cfg without
  # picosoc_chain (tb_PicoSoC_openocd) : the chain discovered, the TAPs
  # and targets created from the IDCODEs, checked against the chain of
  # the generics (PICOSOC_CHAIN of cosim.cfg). Chain of 1 TAP : GDB
  # scenario sim/openocd/picosoc.py on sim/openocd/generic.cfg ; chain of
  # 4 TAPs : OpenOCD script sim/openocd/generic_check.cfg, no GDB. Own
  # hooks, as sim_soc3x2_wardrv_fsm_c_user_openocd_chain
  #---------------------------------------
  sim_soc1_wardrv_fsm_c_user_openocd_generic:
  #---------------------------------------
    << : *default
    description       : OpenOCD + GDB co-simulation of the test esw/demo/user.c - Without Supervisor, Safety None     , Without Fault Injection, JTAG chain of 1 TAP (user CPU, as emu_ng_medium_soc1_wardrv_fsm), JTAG pins on the UART pads (debug_mux_sel_i 10, TCK = FSYS_INT / 8), tools/openocd/picosoc.cfg without picosoc_chain (chain discovered), scenario sim/openocd/picosoc.py (IDCODEs, GDB halt / resume of the user CPU)
    default_tool      : ghdl
    toplevel          : tb_PicoSoC_openocd
    generate          : [gen_rv32i_user_c,gen_rv32i_supervisor_c_dummy]
    filesets_append   : *filesets_openocd
    parameters        : *cfg_soc1_wardrv_fsm_openocd
    tools             : *tools_openocd
    hooks :
      pre_build         : [cosim_build]
      pre_run           : [cosim_start_generic]
      post_run          : [cosim_check]

  #---------------------------------------
  sim_soc3x2_wardrv_fsm_c_user_openocd_generic:
  #---------------------------------------
    << : *default
    description       : OpenOCD co-simulation of the test esw/demo/user.c - With    Supervisor, Safety Lock-Step, Without Fault Injection, 2 CPUs, JTAG chain of 4 TAPs (2 user CPUs, supervisor CPU, injection), JTAG pins on the UART pads (debug_mux_sel_i 10, TCK = FSYS_INT / 8), tools/openocd/picosoc.cfg without picosoc_chain (chain discovered) checked by sim/openocd/generic_check.cfg (IDCODEs, riscv targets named and examined, halt / resume, INJECT)
    default_tool      : ghdl
    toplevel          : tb_PicoSoC_openocd
    generate          : [gen_rv32i_user_c,gen_rv32i_supervisor_c]
    filesets_append   : *filesets_openocd
    parameters        : *cfg_soc3x2_wardrv_fsm_openocd
    tools             : *tools_openocd
    hooks :
      pre_build         : [cosim_build]
      pre_run           : [cosim_start_generic_check]
      post_run          : [cosim_check]

  #---------------------------------------
  # OpenOCD co-simulation of the HWLA captures over JTAG
  # (tb_PicoSoC_openocd, HWLA_LINK jtag, OpenOCD script
  # sim/openocd/hwla_check.cfg on tools/openocd/picosoc.cfg, no GDB) : the
  # chain discovered (the TAP of jtag_axis named picosoc hwla),
  # picosoc_hwla_status before the error / after it / after the dump, an
  # error in CPU1 (picosoc_inject, the supervisor resets the user SoC once),
  # picosoc_hwla_dump of one capture to hwla.bin, decoded by
  # hwla/hwla2vcd.py with hwla/hwla_wardrv_fsm.args (hooks of
  # sim/openocd/hwla_vcd.sh)
  #---------------------------------------
  sim_soc3_wardrv_fsm_fault_c_user_openocd_hwla:
  #---------------------------------------
    << : *default
    description       : OpenOCD co-simulation of the test esw/demo/user.c - With    Supervisor, Safety Lock-Step, With    Fault Injection, JTAG chain of 3 TAPs (user CPU, HWLA jtag_axis, injection), HWLA_LINK jtag, JTAG pins on the UART pads (debug_mux_sel_i 10, TCK = FSYS_INT / 8), script sim/openocd/hwla_check.cfg (chain discovered, picosoc_hwla_status, picosoc_inject, picosoc_hwla_dump), capture decoded by hwla2vcd.py
    default_tool      : ghdl
    toplevel          : tb_PicoSoC_openocd
    generate          : [gen_rv32i_user_c,gen_rv32i_supervisor_c]
    filesets_append   :
      - files_sim
      - files_sim_openocd
      - pbcc_dep
    parameters        :
      - CPU_MODEL=WardRV_fsm
      - FSYS=25000000
      - FSYS_INT=12500000

      # Platform Configuration
      - SUPERVISOR=true
      - USER_SAFETY=lock-step
      - USER_FAULT_INJECTION=true

      # Debug
      - DEBUG_ENABLE=true
      - HWLA_LINK=jtag
      - USER_CPU_DEBUG_ENABLE=true

      # Test Bench Configuration
      - TB_WATCHDOG=200000
      - DEBUG_MUX_SEL=10
    tools             : *tools_openocd
    hooks :
      pre_build         : [cosim_build]
      pre_run           : [cosim_start_hwla]
      post_run          : [cosim_check, hwla_vcd]

  #---------------------------------------
  sim_soc3_wardrv_fsm_c_user:
  #---------------------------------------
    << : *sim
    description       : Simulation of the test esw/demo/user.c                - With    Supervisor, Safety Lock-Step, Without Fault Injection
    generate          : [gen_rv32i_user_c,gen_rv32i_supervisor_c]
    parameters        : &cfg_soc3_wardrv_fsm
      - CPU_MODEL=WardRV_fsm
      - FSYS=25000000
      - FSYS_INT=12500000
      # SoC User Configuration
      - USER_BAUD_RATE=921600
      # Platform Configuration
      - SUPERVISOR=true
      - USER_SAFETY=lock-step
      - USER_FAULT_INJECTION=false
      # Debug
      - DEBUG_ENABLE=false
    parameters_append :
      - TB_WATCHDOG=200000
      - SPI_MODEL=none
      - FIRMWARE=user
      - TESTS_LIST=switch,it_user

