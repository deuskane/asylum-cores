      - USER_SPI_DEPTH_RX=4
      - USER_SPI_NB_IO=2

  #---------------------------------------
  sim: &sim
  #---------------------------------------
    << : *default
    description     : default rule to sim (DON'T RUN)
    default_tool    : ghdl
    toplevel        : tb_PicoSoC
    parameters   :
      - CPU_MODEL=OpenBlaze8
      - FSYS=25000000
      - FSYS_INT=12500000
    filesets_append :
      - files_sim
      - pbcc_dep
    tools :
      ghdl :
        analyze_options : ["-Wall","-fsynopsys","-frelaxed","--no-vital-checks"]
        run_options     : ["--fst=dut.fst","--ieee-asserts=disable"]

  #---------------------------------------
  emu_ng_medium_soc4_openblaze8_fault_spi: &emu_ng_medium_default
  #---------------------------------------
    description       : NanoXplore NG_MEDIUM Board of the test esw/demo/user.c (SPI)          - With    Supervisor, Safety TMR      , With    Fault Injection
    default_tool      : nxmap
    filesets          :
      - files_hdl
      - files_ng_medium 
      - pbcc_dep
    generate          : [gen_picoblaze3_user_c_uart_9600_spi,gen_picoblaze3_supervisor_c_tmr]
    parameters        : &cfg_ng_medium_openblaze8
      - CPU_MODEL=OpenBlaze8
      - FSYS=25000000
      - FSYS_INT=12500000
      - USER_NB_SWITCH=4
      - USER_NB_LED0=8
      - USER_NB_LED1=8
      - RESET_POLARITY=low
      - USER_IT_POLARITY=low
      - USER_FAULT_POLARITY=low
      # SoC User Configuration
      - USER_BAUD_RATE=9600
      - HWLA_BAUD_RATE=9600
      - HWLA_DEPTH=1024
      - HWLA_PRE_TRIGGER=16
      - JTAG_BAUD_RATE=9600
      - USER_UART_DEPTH_TX=4
      - USER_UART_DEPTH_RX=4
      - USER_SPI_DEPTH_CMD=4
      - USER_SPI_DEPTH_TX=4
      - USER_SPI_DEPTH_RX=4
      - USER_SPI_NB_IO=2
    parameters_append :
      # Platform Configuration
      - SUPERVISOR=true
      - USER_SAFETY=tmr
      - USER_FAULT_INJECTION=true
      # Debug
      - DEBUG_ENABLE=false
    flags             :
      TARGET  : NANOXPLORE_NG_MEDIUM
    tools             :
      nxmap:
        fpga         : NG-MEDIUM
        program      : True
        logical_name : asylum
    toplevel          : PicoSoC_top

