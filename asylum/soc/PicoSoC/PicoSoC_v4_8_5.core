  #---------------------------------------
  # Testbench of the injection / status TAP alone (PicoSoC_tap) : INJECT,
  # [2:0] outside the CPUs (a level), [7:4], [11:8], [15:12] inside the CPU
  # copy 0, 1, 2 (a pulse per 0 -> 1). The ROMs of the generators are only compiled (PicoSoC_pkg
  # uses ROM_user_pkg)
  #---------------------------------------
  sim_tap: &sim_tap
  #---------------------------------------
    << : *sim
    description       : Testbench of PicoSoC_tap (injection / status TAP) alone, build check (one scenario per target sim_tap_<test>)
    toplevel          : tb_PicoSoC_tap
    generate          : [gen_rv32i_user_c,gen_rv32i_supervisor_c_dummy]
    parameters        :
      - TESTS_LIST

  #---------------------------------------
  sim_tap_inject:
  #---------------------------------------
    << : *sim_tap
    description       : Testbench of PicoSoC_tap (injection / status TAP) alone, scenario inject (INJECT [2:0], the injection outside the CPUs, a level)
    parameters        :
      - TESTS_LIST=inject

  #---------------------------------------
  sim_tap_inject_cpu:
