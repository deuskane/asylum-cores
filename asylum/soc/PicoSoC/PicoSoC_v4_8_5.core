  #---------------------------------------
    << : *sim
    description       : Simulation of the test esw/demo/user.c                - With    Supervisor, Safety TMR      , With    Fault Injection, IT and fault inputs active low (board)
    generate          : [gen_rv32i_user_c,gen_rv32i_supervisor_c_tmr]
    parameters        : &cfg_soc4_wardrv_fsm_fault
      - CPU_MODEL=WardRV_fsm
      - FSYS=25000000
      - FSYS_INT=12500000
      # SoC User Configuration
      - USER_BAUD_RATE=921600
      # Platform Configuration
      - SUPERVISOR=true
      - USER_SAFETY=tmr
      - USER_FAULT_INJECTION=true
      # Debug
      - DEBUG_ENABLE=false
      - USER_IT_POLARITY=low
      - USER_FAULT_POLARITY=low
    parameters_append :
      - TB_WATCHDOG=200000
      - SPI_MODEL=none
      - FIRMWARE=user
      - TESTS_LIST=switch,it_user,fault_tmr

  #---------------------------------------
  sim_soc4_wardrv_fsm_c_user_uart:
  #---------------------------------------
    << : *sim
    description  : Simulation of the test esw/demo/user.c                - With    Supervisor, Safety TMR      , Without Fault Injection
    generate     : [gen_rv32i_user_c_uart_921600,gen_rv32i_supervisor_c_tmr]
    parameters   :
      - CPU_MODEL=WardRV_fsm
      - FSYS=25000000
      - FSYS_INT=12500000

      # SoC User Configuration
      - USER_BAUD_RATE=921600
      
      # Platform Configuration
      - SUPERVISOR=true
      - USER_SAFETY=tmr
      - USER_FAULT_INJECTION=false

      # Debug
      - DEBUG_ENABLE=false

      # Test Bench Configuration
      - TB_WATCHDOG=200000
      - SPI_MODEL=none
      - FIRMWARE=user_uart
      - TESTS_LIST=switch,it_user,uart

