  emu_ng_medium_soc2_openblaze8_fault:
  #---------------------------------------
    << : *emu_ng_medium_default
    description  : NanoXplore NG_MEDIUM Board of the test esw/user.c            - Without Supervisor, Safety Lock Step, With    Fault Injection
    generate : [gen_picoblaze3_user_c_uart_9600,gen_picoblaze3_supervisor_c]
    parameters   :
