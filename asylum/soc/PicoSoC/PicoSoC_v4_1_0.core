CAPI=2:

#-----------------------------------------------------------------------------
# Title      : OB8 SOC Core file
# Project    : Asylum
#-----------------------------------------------------------------------------
# File       : PicoSoC.core
# Author     : mrosiere
#-----------------------------------------------------------------------------
# Description: 
#-----------------------------------------------------------------------------
# Copyright (c) 2021
#-----------------------------------------------------------------------------
# Revisions  :
# Date        Version  Author   Description
# 2021-10-26  1.0.0    mrosiere Created
# 2021-11-03  1.0.1    mrosiere Use generator
# 2021-11-16  1.0.2    mrosiere Add identity.c
# 2022-01-06  1.0.3    mrosiere Support nxmap
# 2022-07-13  1.1.0    mrosiere DATA_OE_<INIT/FORCE> in NB_IO
# 2024-12-31  1.1.1    mrosiere Fix constant in gpio declaration
# 2025-01-04  1.1.2    mrosiere Update Target and Makefile 
# 2025-01-06  1.1.3    mrosiere Add reset resynchonizer
# 2025-01-06  1.1.4    mrosiere Add top level to separate clock and reset management
#                               Usefull to student
# 2025-01-12  2.0.0    mrosiere Add supervisor and add safety
# 2025-01-15  2.1.0    mrosiere Support TMR safety
# 2025-01-21  2.2.0    mrosiere Add UART
# 2025-01-21  2.2.1    mrosiere Add UART Baud Rate in tb
# 2025-03-08  2.2.2    mrosiere Use unconstrained pbi
# 2025-03-30  2.3.0    mrosiere Use ICN
# 2025-04-05  2.3.1    mrosiere Change AddressMap to be compliant with OneHot encoding
# 2025-04-08  2.3.2    mrosiere Add parameters for ICN
# 2025-04-14  2.3.3    mrosiere Add debug bus
# 2025-05-14  2.4.0    mrosiere Change default BAUD TICK
# 2025-06-16  2.5.0    mrosiere Add SPI
# 2025-07-04  2.6.0    mrosiere Add GIC (Supervisor)
# 2025-07-09  2.6.1    mrosiere Configure UART and SPI FIFO
# 2025-07-29  2.7.0    mrosiere Add GIC (User)
# 2025-08-02  2.7.1    mrosiere Add Uart CTS/RTS
# 2025-08-11  2.7.2    mrosiere Use Target Techmap
# 2025-08-31  2.7.3    mrosiere Cosmetics : rename generate and esw
# 2025-10-18  2.7.4    mrosiere Add software modbus
# 2025-11-02  2.8.0    mrosiere Add Timer (User)
# 2025-11-10  2.8.1    mrosiere Add debug bus from uart and set to 4 the FIFO depth
# 2025-11-22  2.8.2    mrosiere Use sbi instead pbi
# 2025-11-26  2.8.3    mrosiere Use uvvm instead uvvm light
# 2025-11-27  2.9.0    mrosiere Add CRC (User)
# 2025-12-06  2.9.1    mrosiere Add Generic LOCK_STEP_DEPTH (User)
# 2025-12-30  2.9.2    mrosiere rename tb_PicoSoC_modbus to tb_PicoSoC_modbus_rtu
#                               Add targets
# 2026-01-17  2.9.3    mrosiere Move it sync dff into GIC
# 2026-05-09  3.0.0    mrosiere Add Generic CPU_MODEL
# 2026-05-24  3.0.1    mrosiere Change Supervisor ICN Address Encoding
# 2026-05-27  3.1.0    mrosiere Add spinlock and mailbox
# 2026-06-05  3.2.0    mrosiere Use ICN with NB_MASTER
# 2026-06-06  3.2.1    mrosiere Rename LED
#                               Add name
# 2026-06-17  3.2.2    mrosiere Add RAM2 for shared memories
# 2026-08-01  3.2.3    mrosiere Use GPIO_irq instead of GPIO
# 2026-08-22  3.3.0    mrosiere Update SPI controller
# 2026-10-05  3.3.1    mrosiere Fix default toplevel (PicoSoC_top), remove duplicated target,
#                               fix USER_SPI_DEPTH_* names in emu targets,
#                               rename emu_ng_medium_soc1_*_c_user to emu_ng_medium_soc4_*_fault_spi,
#                               emu_basys WardRV target uses user_identity.c (rvcc_gen has no psm),
#                               PicoSoC_top CPU_MODEL default, OR of diff_o with NB_CPU > 1,
#                               add missing gen_*_user_c_uart_9600 generators
# 2026-11-15  3.3.2    mrosiere esw : clear the ISR before unmasking (asylum:system:GIC 2.0.0
#                               records the masked sources too)
# 2026-11-19  4.0.0    mrosiere it_user_i resynchronized in the user GIC, data bus compared
#                               in lock-step / TMR (asylum:utils:pkg >= 1.9.0), ICN2 address
#                               width, NG-MEDIUM SPI pads (USER_SPI_NB_IO = 2, inputs
#                               without pad tied to 0), USER_NB_LED0 / 1 other than 8,
#                               mailbox "data available" sources 3 / 4 on the user GIC
#                               (mailbox >= 1.1.0, GIC >= 2.0.0), esw uart.h for uart 3.0.0
#                               (UART_IT_TX_EMPTY), cpu_nop; tb_PicoSoC checks the user
#                               interruption, the UART output and the multi-CPU progress;
#                               targets: emu_basys_* removed, lint_ghdl_synth_basys renamed
#                               lint_ghdl_synth_4leds_reset_high, sim_soc4_*_fault_c_user_uart
#                               renamed sim_soc4_*_c_user_uart
# 2026-11-22  4.1.0    mrosiere UART pads shared by the user UART, the HWLA UART and JTAG
#                               (asylum:debug:jtag jtag_pad_mux, switch_i MSBs, FTDI MPSSE
#                               pinout : uart_tx_io, uart_cts_b_io, uart_rts_b_io), JTAG chain :
#                               WardRV_debug of the user / supervisor CPU
#                               (USER_CPU_DEBUG_ENABLE, SUPERVISOR_CPU_DEBUG_ENABLE), TAP of
#                               fault injection and status (DEBUG_ENABLE); tb : JTAG BFM
#                               (asylum:verification:uvvm 1.1.0), scenarios pad_mux, jtag_*
#-----------------------------------------------------------------------------

name        : asylum:soc:PicoSoC:4.1.0
description : SoC with OpenBlaze8/WardRV, switch, led, UART, SPI, I2C, PWM, GIC, Timer, RAM, CRC, Spinlock and Mailbox

