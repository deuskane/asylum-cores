  emu_ng_medium_soc4_wardrv_fsm_fault_spi:
  #---------------------------------------
    description  : NanoXplore NG_MEDIUM Board of the test esw/user.c (SPI)      - With    Supervisor, Safety TMR      , With    Fault Injection
    default_tool : nxmap
    filesets     :
      - files_hdl
      - files_ng_medium 
      - pbcc_dep
    generate : [gen_rv32i_user_c_uart_9600_spi,gen_rv32i_supervisor_c_tmr]
    parameters   :
      - CPU_MODEL=WardRV_fsm
      - FSYS=25000000
      - FSYS_INT=12500000
      - USER_NB_SWITCH=6
      - USER_NB_LED0=8
      - USER_NB_LED1=8
      - RESET_POLARITY=low
      - USER_IT_POLARITY=low
      - USER_FAULT_POLARITY=low

      # SoC User Configuration
      - USER_BAUD_RATE=9600
      - USER_UART_DEPTH_TX=4
      - USER_UART_DEPTH_RX=4
      - USER_SPI_DEPTH_CMD=4
      - USER_SPI_DEPTH_TX=4
      - USER_SPI_DEPTH_RX=4
      - USER_SPI_NB_IO=2
      
      # Platform Configuration
      - SUPERVISOR=true
      - USER_SAFETY=tmr
      - USER_FAULT_INJECTION=true

      # Debug
      - DEBUG_ENABLE=false
    flags :
      TARGET  : NANOXPLORE_NG_MEDIUM
    tools:
      nxmap:
        fpga         : NG-MEDIUM
        program      : True
        logical_name : asylum
    toplevel : PicoSoC_top

