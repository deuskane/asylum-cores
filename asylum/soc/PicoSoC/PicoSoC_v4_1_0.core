#=========================================
scripts:
#=========================================

  #---------------------------------------
  # pre_run hook of lint_ghdl_synth_* (cwd = work_root)
  #---------------------------------------
  ghdl_synth :
    cmd : [bash, ghdl_synth.sh]

  #---------------------------------------
  # pre_run hook of syn_* (cwd = work_root)
  #---------------------------------------
  yosys_synth :
    cmd : [bash, yosys_synth.sh]

#=========================================
parameters :
#=========================================

  FSYS :
    description : External frequency
    datatype    : int
    default     : 500000000
    paramtype   : generic

  FSYS_INT :
    description : Internal frequency
    datatype    : int
    default     : 500000000
    paramtype   : generic

  USER_NB_CPU :
    description : Number of User CPU
    datatype    : int
    default     : 1
    paramtype   : generic
    
  USER_BAUD_RATE :
    description : Baud Rate
    datatype    : int
    default     : 9600
    paramtype   : generic

  USER_UART_DEPTH_TX :
    description : UART TX Depth FIFO
    datatype    : int
    default     : 0
    paramtype   : generic

  USER_UART_DEPTH_RX :
    description : UART RX Depth FIFO
    datatype    : int
    default     : 0
    paramtype   : generic

  USER_SPI_DEPTH_CMD :
    description : SPI TX Depth FIFO
    datatype    : int
    default     : 0
    paramtype   : generic

  USER_SPI_DEPTH_TX :
    description : SPI TX Depth FIFO
    datatype    : int
    default     : 0
    paramtype   : generic

  USER_SPI_DEPTH_RX :
    description : SPI RX Depth FIFO
    datatype    : int
    default     : 0
    paramtype   : generic

  USER_SPI_NB_IO :
    description : SPI IO lines with a pad (MOSI, MISO, WP#, HOLD#, ...), up to 8
    datatype    : int
    default     : 8
    paramtype   : generic

  USER_NB_SWITCH :
    description : Switch number on board
    datatype    : int
    default     : 8
    paramtype   : generic

  USER_NB_LED0 :
    description : led number on board
    datatype    : int
    default     : 8
    paramtype   : generic

  USER_NB_LED1 :
    description : led number on board
    datatype    : int
    default     : 8
    paramtype   : generic

  RESET_POLARITY :
    description : Polarity of arst_i signal (low / high)
    datatype    : str
    default     : low
    paramtype   : generic

  SUPERVISOR :
    description : Instanciate the supervisor
    datatype    : bool
    default     : false
    paramtype   : generic

  USER_SAFETY :
    description : Safety Algorithm (none / lock-step / tmr)
    datatype    : str
    default     : none
    paramtype   : generic

  USER_FAULT_INJECTION :
    description : Polarity of arst_i signal (low / high)
    datatype    : bool
    default     : false
    paramtype   : generic

  USER_IT_POLARITY :
    description : Polarity of it_user_i signal (low / high)
    datatype    : str
    default     : low
    paramtype   : generic

  USER_FAULT_POLARITY :
    description : Polarity of inject_err_r_i signal (low / high)
    datatype    : str
    default     : low
    paramtype   : generic

  DEBUG_ENABLE :
    description : Enable the Debug Buss
    datatype    : bool
    default     : false
    paramtype   : generic

  USER_CPU_DEBUG_ENABLE :
    description : Debug unit (WardRV_debug, in cpu_wrapper) of the user CPU of every cluster, in the JTAG chain (WardRV_fsm)
    datatype    : bool
    default     : false
    paramtype   : generic

  SUPERVISOR_CPU_DEBUG_ENABLE :
    description : Debug unit (WardRV_debug, in cpu_wrapper) of the supervisor CPU, in the JTAG chain (WardRV_fsm)
    datatype    : bool
    default     : false
    paramtype   : generic

  CPU_MODEL :
    description : CPU Model (OpenBlaze8 / WardRV_fsm)
    datatype    : str
    default     : OpenBlaze8
    paramtype   : generic

  SPI_MODEL :
    description : SPI Model (m25p40 / s25fl512s)
    datatype    : str
    default     : m25p40
    paramtype   : generic

  TESTS_LIST :
    description : Testbench scenarios, separated by ',' (switch, it_user, uart, fault_lock_step, fault_tmr, fault_diff, hwla, hello, pad_mux, jtag_chain, jtag_inject, jtag_status, jtag_cpu_user, jtag_cpu_supervisor, test_<ip> / basic, fault_lock_step, fault_tmr, sequence for tb_PicoSoC_modbus_rtu)
    datatype    : str
    paramtype   : generic

  FIRMWARE :
    description : Program of the user ROM for tb_PicoSoC (identity / user / user_uart / user_uart_spi / user_uart_spi_mem / hello)
    datatype    : str
    default     : user
    paramtype   : generic

  TB_WATCHDOG :
    description : Testbench timeout of one wait (clk_i cycles)
    datatype    : int
    default     : 10000
    paramtype   : generic


# Next lines is a pragma, don't modify
#<PROVIDER_BEGIN>
provider  :
  name    : github
  user    : deuskane
  repo    : asylum-soc-picosoc
  version : asylum-soc-PicoSoC-4.1.0
 #version : a9735df9237b5703f72bccd815681dcd92218ab0
