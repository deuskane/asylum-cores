#=========================================
filesets:
#=========================================
  #---------------------------------------
  pbcc_dep:
  #---------------------------------------
    depend:
      - ">=asylum:utils:generators:1.0.0"      

  #---------------------------------------
  files_hdl:
  #---------------------------------------
    files        :
      - hdl/cpu_wrapper.vhd
      - hdl/cpu_safety.vhd
      - hdl/PicoSoC_pkg.vhd
      - hdl/PicoSoC_pads.vhd
      - hdl/PicoSoC_top.vhd
      - hdl/PicoSoC_user.vhd
      - hdl/PicoSoC_supervisor.vhd
    file_type    : vhdlSource
    logical_name : asylum
    depend       :
      - ">=asylum:utils:pkg:1.9.0"
      - ">=asylum:target:techmap:1.0.0"
      - ">=asylum:component:clock_divider:1.0.0"
      - ">=asylum:component:GPIO:1.0.0"
      - ">=asylum:component:crc:1.0.0"
      - ">=asylum:communication:uart:3.0.0"
      - ">=asylum:communication:SPI:1.0.0"
      - ">=asylum:infrastructure:icn:1.0.0"
      - ">=asylum:system:GIC:2.0.0"
      - ">=asylum:system:spinlock:1.0.0"
      - ">=asylum:system:mailbox:1.1.0"
      - ">=asylum:communication:I2C:1.0.0"
      - ">=asylum:component:PWM:1.0.0"
      - ">=asylum:debug:HWLA:3.0.0"
      - ">=asylum:debug:jtag:1.0.0"
      - ">=asylum:component:fifo:1.0.0"
      - ">=asylum:component:timer:2.0.0"
      - ">=asylum:component:ram:1.2.0"
      - ">=asylum:processor:OpenBlaze8:1.0.0"
      - ">=asylum:processor:WardRV:1.2.0"
      
  #---------------------------------------
  files_sim:
  #---------------------------------------
    files:
      - sim/picosoc/tb_PicoSoC_bfm_pkg.vhd
      - sim/picosoc/tb_PicoSoC_jtag_pkg.vhd
      - sim/picosoc/tb_PicoSoC_switch_pkg.vhd
      - sim/picosoc/tb_PicoSoC_it_user_pkg.vhd
      - sim/picosoc/tb_PicoSoC_uart_pkg.vhd
      - sim/picosoc/tb_PicoSoC_fault_lock_step_pkg.vhd
      - sim/picosoc/tb_PicoSoC_fault_tmr_pkg.vhd
      - sim/picosoc/tb_PicoSoC_fault_diff_pkg.vhd
      - sim/picosoc/tb_PicoSoC_hwla_pkg.vhd
      - sim/picosoc/tb_PicoSoC_hello_pkg.vhd
      - sim/picosoc/tb_PicoSoC_pad_mux_pkg.vhd
      - sim/picosoc/tb_PicoSoC_jtag_chain_pkg.vhd
      - sim/picosoc/tb_PicoSoC_jtag_inject_pkg.vhd
      - sim/picosoc/tb_PicoSoC_jtag_status_pkg.vhd
      - sim/picosoc/tb_PicoSoC_jtag_cpu_pkg.vhd
      - sim/picosoc/tb_PicoSoC_test_gpio_pkg.vhd
      - sim/picosoc/tb_PicoSoC_test_uart_pkg.vhd
      - sim/picosoc/tb_PicoSoC_test_timer_pkg.vhd
      - sim/picosoc/tb_PicoSoC_test_gic_pkg.vhd
      - sim/picosoc/tb_PicoSoC_test_mailbox_pkg.vhd
      - sim/picosoc/tb_PicoSoC_test_i2c_pkg.vhd
      - sim/picosoc/tb_PicoSoC_test_pwm_pkg.vhd
      - sim/picosoc/tb_PicoSoC_tests_pkg.vhd
      - sim/picosoc/tb_PicoSoC.vhd
      - sim/modbus_rtu/tb_PicoSoC_modbus_rtu_bfm_pkg.vhd
      - sim/modbus_rtu/tb_PicoSoC_modbus_rtu_basic_pkg.vhd
      - sim/modbus_rtu/tb_PicoSoC_modbus_rtu_fault_lock_step_pkg.vhd
      - sim/modbus_rtu/tb_PicoSoC_modbus_rtu_fault_tmr_pkg.vhd
      - sim/modbus_rtu/tb_PicoSoC_modbus_rtu_sequence_pkg.vhd
      - sim/modbus_rtu/tb_PicoSoC_modbus_rtu_tests_pkg.vhd
      - sim/modbus_rtu/tb_PicoSoC_modbus_rtu.vhd
      - sim/mem/memory.mem         : {file_type : user, copyto : memory.mem   }
      - sim/mem/memoryOTP.mem      : {file_type : user, copyto : memoryOTP.mem}
    file_type : vhdlSource-2008
    depend :
      - ">=asylum:utils:pkg:1.10.0" # string_pkg list_* (TESTS_LIST)
      - fmf:memory:flash_nor
      - bitvis:verification:uvvm
      - ">=asylum:verification:uvvm:1.1.0" # jtag_bfm_pkg (JTAG BFM)

  #---------------------------------------
  files_ng_medium:
  #---------------------------------------
    files:
      - boards/NanoXplore-DK625V0/pads.py    : {file_type : nx_pads}
      - boards/NanoXplore-DK625V0/options.py : {file_type : nx_options}
      - boards/NanoXplore-DK625V0/features.py: {file_type : nx_features}
    file_type : vhdlSource

  #---------------------------------------
  syn:
  #---------------------------------------
    # ghdl_synth.sh / ghdl_synth.mk (pre_run hook of lint_ghdl_synth_*)
    depend       :
      - asylum:utils:ghdl_synth

  #---------------------------------------
  syn_yosys:
  #---------------------------------------
    # yosys_synth.sh / yosys_synth.mk / yosys_synth.py (pre_run hook of syn_*)
    depend       :
      - asylum:utils:yosys_synth

  # Next line is a pragma, don't modify
  #<FILESETS_BEGIN>
  #<FILESETS_END>
  # Previous line is a pragma, don't modify

#=========================================
targets:
#=========================================

  #---------------------------------------
  default: &default
  #---------------------------------------
    description     : Default Target (DON'T RUN)
    filesets        :
      - files_hdl
    toplevel        : PicoSoC_top
    default_tool    : ghdl

  #---------------------------------------
  # Lint : -Wall analysis and elaboration (empty simulation)
  # Firmware : user_identity.c and dummy.c (OpenBlaze8, pbcc_gen)
  #---------------------------------------
  lint_ghdl : &lint_ghdl
    << : *default
    description     : Lint with GHDL (-Wall analysis and elaboration of PicoSoC_top)
    toplevel        : asylum.PicoSoC_top
    filesets_append : [pbcc_dep,syn]
    generate        : [gen_picoblaze3_user_c_identity,gen_picoblaze3_supervisor_c_dummy]
    default_tool    : ghdl
    tools :
      ghdl :
        analyze_options : ["-Wall","-fsynopsys","-frelaxed"]

  #---------------------------------------
  # Synthesis check : -Wall analysis, ghdl --synth -Wall and elaboration
  # (no simulation) of PicoSoC_top with the generics of the target.
  # The pre_run hook (ghdl_synth.sh of asylum:utils:ghdl_synth) adds
  # ghdl_synth.mk to the edalize Makefile.
  # FuseSoC merges tools in depth : analyze_options comes from lint_ghdl.
  # OpenBlaze8 : firmware of lint_ghdl (pbcc_gen)
  #---------------------------------------
  lint_ghdl_synth_default : &lint_ghdl_synth
    << : *lint_ghdl
    description     : Synthesis check of PicoSoC_top, OpenBlaze8, default generics
    tools :
      ghdl :
        run_options     : ["--no-run"]
    hooks :
      pre_run : [ghdl_synth]

  #---------------------------------------
  lint_ghdl_synth_soc1 :
  #---------------------------------------
    << : *lint_ghdl_synth
    description     : Synthesis check of PicoSoC_top, OpenBlaze8, soc1 (no supervisor, no safety)
    parameters      :
      - SUPERVISOR=false
      - USER_SAFETY=none
      - USER_FAULT_INJECTION=false
      - DEBUG_ENABLE=false

  #---------------------------------------
  lint_ghdl_synth_soc4_ng_medium :
  #---------------------------------------
    << : *lint_ghdl_synth
    description     : Synthesis check of PicoSoC_top, OpenBlaze8, soc4 (supervisor, TMR) with the NG-MEDIUM generics
    parameters      :
      - SUPERVISOR=true
      - USER_SAFETY=tmr
      - USER_FAULT_INJECTION=true
      - DEBUG_ENABLE=false
      - FSYS=25000000
      - FSYS_INT=12500000
      - USER_NB_SWITCH=6
      - USER_BAUD_RATE=9600
      - USER_UART_DEPTH_TX=4
      - USER_UART_DEPTH_RX=4
      - USER_SPI_DEPTH_CMD=4
      - USER_SPI_DEPTH_TX=4
      - USER_SPI_DEPTH_RX=4
      - USER_SPI_NB_IO=2

  #---------------------------------------
  lint_ghdl_synth_4leds_reset_high :
  #---------------------------------------
    << : *lint_ghdl_synth
    description     : Synthesis check of PicoSoC_top, OpenBlaze8, 4 + 1 LEDs and reset active high
    parameters      :
      - USER_NB_LED0=4
      - USER_NB_LED1=1
      - RESET_POLARITY=high

  #---------------------------------------
  # WardRV_fsm : the firmware ROMs depend on the CPU (rvcc_gen)
  #---------------------------------------
  lint_ghdl_synth_wardrv_soc1 : &lint_ghdl_synth_wardrv
    << : *lint_ghdl_synth
    description     : Synthesis check of PicoSoC_top, WardRV_fsm, soc1 (no supervisor, no safety)
    generate        : [gen_rv32i_user_c_identity,gen_rv32i_supervisor_c_dummy]
    parameters      :
      - CPU_MODEL=WardRV_fsm
      - SUPERVISOR=false
      - USER_SAFETY=none
      - USER_FAULT_INJECTION=false
      - DEBUG_ENABLE=false

  #---------------------------------------
  lint_ghdl_synth_wardrv_soc4_ng_medium :
  #---------------------------------------
    << : *lint_ghdl_synth_wardrv
    description     : Synthesis check of PicoSoC_top, WardRV_fsm, soc4 (supervisor, TMR) with the NG-MEDIUM generics
    parameters      :
      - CPU_MODEL=WardRV_fsm
      - SUPERVISOR=true
      - USER_SAFETY=tmr
      - USER_FAULT_INJECTION=true
      - DEBUG_ENABLE=false
      - FSYS=25000000
      - FSYS_INT=12500000
      - USER_NB_SWITCH=6
      - USER_BAUD_RATE=9600
      - USER_UART_DEPTH_TX=4
      - USER_UART_DEPTH_RX=4
      - USER_SPI_DEPTH_CMD=4
      - USER_SPI_DEPTH_TX=4
      - USER_SPI_DEPTH_RX=4
      - USER_SPI_NB_IO=2

  #---------------------------------------
  lint_ghdl_synth_wardrv_soc4_ng_medium_debug :
  #---------------------------------------
    << : *lint_ghdl_synth_wardrv
    description     : Synthesis check of PicoSoC_top, WardRV_fsm, soc4 (supervisor, TMR) with the NG-MEDIUM generics, HWLA, JTAG injection / status TAP and both CPU debuggers
    parameters      :
      - CPU_MODEL=WardRV_fsm
      - SUPERVISOR=true
      - USER_SAFETY=tmr
      - USER_FAULT_INJECTION=true
      - DEBUG_ENABLE=true
      - USER_CPU_DEBUG_ENABLE=true
      - SUPERVISOR_CPU_DEBUG_ENABLE=true
      - FSYS=25000000
      - FSYS_INT=12500000
      - USER_NB_SWITCH=6
      - USER_BAUD_RATE=9600
      - USER_UART_DEPTH_TX=4
      - USER_UART_DEPTH_RX=4
      - USER_SPI_DEPTH_CMD=4
      - USER_SPI_DEPTH_TX=4
      - USER_SPI_DEPTH_RX=4
      - USER_SPI_NB_IO=2

  #---------------------------------------
  lint_ghdl_synth_wardrv_soc1x4 :
  #---------------------------------------
    << : *lint_ghdl_synth_wardrv
    description     : Synthesis check of PicoSoC_top, WardRV_fsm, soc1 with 4 user CPUs
    parameters      :
      - CPU_MODEL=WardRV_fsm
      - SUPERVISOR=false
      - USER_SAFETY=none
      - USER_FAULT_INJECTION=false
      - DEBUG_ENABLE=false
      - USER_NB_CPU=4

  #---------------------------------------
  # Synthesis : size of PicoSoC_top with the generics of the target,
  # Xilinx Artix-7 (LUT, FF, BRAM, DSP) and sky130 (area), by Yosys and
  # its GHDL plugin. Two configurations of each lint_ghdl_synth_* CPU :
  # the smallest SoC (soc1) and the NG-MEDIUM board SoC (soc4 : supervisor,
  # TMR). The user ROM holds the firmware of lint_ghdl (user_identity.c).
  # The pre_run hook (yosys_synth.sh of asylum:utils:yosys_synth) adds
  # yosys_synth.mk to the edalize Makefile.
  #---------------------------------------
  syn_soc1 : &syn
    << : *lint_ghdl
    description     : Synthesis (Artix-7, sky130) of PicoSoC_top, OpenBlaze8, soc1 (no supervisor, no safety)
    filesets_append : [pbcc_dep, syn, syn_yosys]
    tools :
      ghdl :
        run_options     : ["--no-run"]
    hooks :
      pre_run : [yosys_synth]
    parameters      :
      - SUPERVISOR=false
      - USER_SAFETY=none
      - USER_FAULT_INJECTION=false
      - DEBUG_ENABLE=false

  #---------------------------------------
  syn_soc4_ng_medium :
  #---------------------------------------
    << : *syn
    description     : Synthesis (Artix-7, sky130) of PicoSoC_top, OpenBlaze8, soc4 (supervisor, TMR) with the NG-MEDIUM generics
    parameters      :
      - SUPERVISOR=true
      - USER_SAFETY=tmr
      - USER_FAULT_INJECTION=true
      - DEBUG_ENABLE=false
      - FSYS=25000000
      - FSYS_INT=12500000
      - USER_NB_SWITCH=6
      - USER_BAUD_RATE=9600
      - USER_UART_DEPTH_TX=4
      - USER_UART_DEPTH_RX=4
      - USER_SPI_DEPTH_CMD=4
      - USER_SPI_DEPTH_TX=4
      - USER_SPI_DEPTH_RX=4
      - USER_SPI_NB_IO=2

  #---------------------------------------
  syn_wardrv_soc1 : &syn_wardrv
  #---------------------------------------
    << : *syn
    description     : Synthesis (Artix-7, sky130) of PicoSoC_top, WardRV_fsm, soc1 (no supervisor, no safety)
    generate        : [gen_rv32i_user_c_identity,gen_rv32i_supervisor_c_dummy]
    parameters      :
      - CPU_MODEL=WardRV_fsm
      - SUPERVISOR=false
      - USER_SAFETY=none
      - USER_FAULT_INJECTION=false
      - DEBUG_ENABLE=false

  #---------------------------------------
  syn_wardrv_soc4_ng_medium :
  #---------------------------------------
    << : *syn_wardrv
    description     : Synthesis (Artix-7, sky130) of PicoSoC_top, WardRV_fsm, soc4 (supervisor, TMR) with the NG-MEDIUM generics
    parameters      :
      - CPU_MODEL=WardRV_fsm
      - SUPERVISOR=true
      - USER_SAFETY=tmr
      - USER_FAULT_INJECTION=true
      - DEBUG_ENABLE=false
      - FSYS=25000000
      - FSYS_INT=12500000
      - USER_NB_SWITCH=6
      - USER_BAUD_RATE=9600
      - USER_UART_DEPTH_TX=4
      - USER_UART_DEPTH_RX=4
      - USER_SPI_DEPTH_CMD=4
      - USER_SPI_DEPTH_TX=4
      - USER_SPI_DEPTH_RX=4
      - USER_SPI_NB_IO=2

  #---------------------------------------
  syn_wardrv_soc4_ng_medium_debug :
  #---------------------------------------
    << : *syn_wardrv
    description     : Synthesis (Artix-7, sky130) of PicoSoC_top, WardRV_fsm, soc4 (supervisor, TMR) with the NG-MEDIUM generics, HWLA, JTAG injection / status TAP and both CPU debuggers
    parameters      :
      - CPU_MODEL=WardRV_fsm
      - SUPERVISOR=true
      - USER_SAFETY=tmr
      - USER_FAULT_INJECTION=true
      - DEBUG_ENABLE=true
      - USER_CPU_DEBUG_ENABLE=true
      - SUPERVISOR_CPU_DEBUG_ENABLE=true
      - FSYS=25000000
      - FSYS_INT=12500000
      - USER_NB_SWITCH=6
      - USER_BAUD_RATE=9600
      - USER_UART_DEPTH_TX=4
      - USER_UART_DEPTH_RX=4
      - USER_SPI_DEPTH_CMD=4
      - USER_SPI_DEPTH_TX=4
      - USER_SPI_DEPTH_RX=4
      - USER_SPI_NB_IO=2

  #---------------------------------------
  sim: &sim
  #---------------------------------------
    << : *default
    description     : default rule to sim (DON'T RUN)
    default_tool    : ghdl
    toplevel        : tb_PicoSoC
    parameters   :
      - CPU_MODEL=OpenBlaze8
      - FSYS=25000000
      - FSYS_INT=12500000
    filesets_append :
      - files_sim
      - pbcc_dep
    tools :
      ghdl :
        analyze_options : ["-Wall","-fsynopsys","-frelaxed","--no-vital-checks"]
        run_options     : ["--fst=dut.fst","--ieee-asserts=disable"]

  #---------------------------------------
  emu_ng_medium_soc4_openblaze8_fault_spi: &emu_ng_medium_default
  #---------------------------------------
    description  : NanoXplore NG_MEDIUM Board of the test esw/user.c (SPI)      - With    Supervisor, Safety TMR      , With    Fault Injection
    default_tool : nxmap
    filesets     :
      - files_hdl
      - files_ng_medium 
      - pbcc_dep
    generate : [gen_picoblaze3_user_c_uart_9600_spi,gen_picoblaze3_supervisor_c_tmr]
    parameters   :
      - CPU_MODEL=OpenBlaze8
      - FSYS=25000000
      - FSYS_INT=12500000
      - USER_NB_SWITCH=6
      - USER_NB_LED0=8
      - USER_NB_LED1=8
      - RESET_POLARITY=low
      - USER_IT_POLARITY=low
      - USER_FAULT_POLARITY=low

      # SoC User Configuration
      - USER_BAUD_RATE=9600
      - USER_UART_DEPTH_TX=4
      - USER_UART_DEPTH_RX=4
      - USER_SPI_DEPTH_CMD=4
      - USER_SPI_DEPTH_TX=4
      - USER_SPI_DEPTH_RX=4
      - USER_SPI_NB_IO=2
      
      # Platform Configuration
      - SUPERVISOR=true
      - USER_SAFETY=tmr
      - USER_FAULT_INJECTION=true

      # Debug
      - DEBUG_ENABLE=false
    flags :
      TARGET  : NANOXPLORE_NG_MEDIUM
    tools:
      nxmap:
        fpga         : NG-MEDIUM
        program      : True
        logical_name : asylum
    toplevel : PicoSoC_top

  #---------------------------------------
  emu_ng_medium_soc1_openblaze8:
  #---------------------------------------
    << : *emu_ng_medium_default
    description  : NanoXplore NG_MEDIUM Board of the test esw/user.c            - Without Supervisor, Safety None     , Without Fault Injection
    generate : [gen_picoblaze3_user_c_uart_9600_spi_mem,gen_picoblaze3_supervisor_c_dummy]
    parameters   :
      - CPU_MODEL=OpenBlaze8
      - FSYS=25000000
      - FSYS_INT=12500000
      - USER_NB_SWITCH=6
      - USER_NB_LED0=8
      - USER_NB_LED1=8
      - RESET_POLARITY=low
      - USER_IT_POLARITY=low
      - USER_FAULT_POLARITY=low

      # SoC User Configuration
      - USER_BAUD_RATE=9600
      - USER_UART_DEPTH_TX=4
      - USER_UART_DEPTH_RX=4
      - USER_SPI_DEPTH_CMD=4
      - USER_SPI_DEPTH_TX=4
      - USER_SPI_DEPTH_RX=4
      - USER_SPI_NB_IO=2
      
      # Platform Configuration
      - SUPERVISOR=false
      - USER_SAFETY=none
      - USER_FAULT_INJECTION=false

      # Debug
      - DEBUG_ENABLE=false

  #---------------------------------------
  emu_ng_medium_soc1_openblaze8_modbus_rtu:
  #---------------------------------------
    << : *emu_ng_medium_default
    description  : NanoXplore NG_MEDIUM Board of the test esw/user_modbus_rtu.c - Without Supervisor, Safety None     , Without Fault Injection
    generate : [gen_picoblaze3_user_modbus_rtu_9600,gen_picoblaze3_supervisor_c_dummy]
    parameters   :
