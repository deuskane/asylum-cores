CAPI=2:

#-----------------------------------------------------------------------------
# Title      : I2C Core file
# Project    : Asylum
#-----------------------------------------------------------------------------
# File       : I2C.core
# Author     : mrosiere
#-----------------------------------------------------------------------------
# Description: I2C master / slave with CSR access over the SBI bus
#-----------------------------------------------------------------------------
# Copyright (c) 2026
#-----------------------------------------------------------------------------
# Revisions  :
# Date        Version  Author   Description
# 2026-10-22  1.0.0    mrosiere First Release
#                               One target per verification scenario
#                               (sim_<scenario>), sim_multi_slave
#-----------------------------------------------------------------------------

name        : asylum:communication:I2C:1.0.0
description : I2C Master / Slave Module

#=========================================
generate:
#=========================================

  #---------------------------------------
  gen_csr:
  #---------------------------------------
    generator : regtool
    parameters:
      file         : hdl/csr/I2C.hjson
      name         : I2C
      copy         : hdl/csr
      logical_name : asylum

#=========================================
filesets:
#=========================================

  #---------------------------------------
  hdl:
  #---------------------------------------
    files        :
      - hdl/i2c_pkg.vhd
      - hdl/i2c_master.vhd
      - hdl/i2c_slave.vhd
      - hdl/i2c_core.vhd
      - hdl/sbi_I2C.vhd
    file_type    : vhdlSource
    logical_name : asylum
    depend       :
      - ">=asylum:utils:generators:2.8.0"
      - asylum:utils:pkg
      - asylum:target:techmap

  #---------------------------------------
  sim_basic:
  #---------------------------------------
    files        :
      - sim/basic/tb_I2C_bfm_pkg.vhd
      - sim/basic/tb_I2C_reset_pkg.vhd
      - sim/basic/tb_I2C_master_pkg.vhd
      - sim/basic/tb_I2C_slave_pkg.vhd
      - sim/basic/tb_I2C_tests_pkg.vhd
      - sim/basic/tb_I2C.vhd
    file_type    : vhdlSource-2008
    depend       :
      - bitvis:verification:uvvm
      # string_pkg list_length / list_item / list_contains (TESTS_LIST)
      - ">=asylum:utils:pkg:1.10.0"

  #---------------------------------------
  sim_multi:
  #---------------------------------------
    files        :
      - sim/multi/tb_I2C_multi_bfm_pkg.vhd
      - sim/multi/tb_I2C_multi_transfers_pkg.vhd
      - sim/multi/tb_I2C_multi_tests_pkg.vhd
      - sim/multi/tb_I2C_multi.vhd
    file_type    : vhdlSource-2008
    depend       :
      - bitvis:verification:uvvm
      # string_pkg list_length / list_item / list_contains (TESTS_LIST)
      - ">=asylum:utils:pkg:1.10.0"

  #---------------------------------------
  # Lint Files (pre_run hook of lint_ghdl_synth_*)
  #---------------------------------------
  syn:
    files:
      - syn/sbi_I2C_wrapper.vhd
    file_type    : vhdlSource-2008
    logical_name : asylum

  #---------------------------------------
  # Yosys scripts of the syn_* targets
  #---------------------------------------
  syn_yosys:
    depend       :
      - asylum:utils:yosys_synth

#=========================================
targets:
#=========================================

  #---------------------------------------
  default: &default
  #---------------------------------------
    description     : Default Target
    filesets        :
      - hdl
    toplevel        : sbi_I2C
    default_tool    : ghdl
    generate        :
      - gen_csr

  #---------------------------------------
  # Lint : -Wall analysis and elaboration (empty simulation)
  #---------------------------------------
  lint_ghdl : &lint_ghdl
    << : *default
    description     : Lint with GHDL (-Wall analysis and elaboration of sbi_I2C_wrapper)
    toplevel        : asylum.sbi_I2C_wrapper
    filesets_append : [syn]
    default_tool    : ghdl
    tools :
      ghdl :
        analyze_options : ["-Wall"]

  #---------------------------------------
  # Synthesis check : -Wall analysis, ghdl --synth -Wall and elaboration
  # (no simulation) of sbi_I2C_wrapper with the generics of the target.
  # The pre_run hook adds syn/ghdl/ghdl_synth.mk to the edalize Makefile.
  # FuseSoC merges tools in depth : analyze_options comes from lint_ghdl.
  #---------------------------------------
  lint_ghdl_synth_default : &lint_ghdl_synth
    << : *lint_ghdl
    description     : Synthesis check of sbi_I2C_wrapper, default generics
    tools :
      ghdl :
        run_options     : ["--no-run"]
    hooks :
      pre_run : [ghdl_synth]

  #---------------------------------------
  lint_ghdl_synth_sim :
  #---------------------------------------
    << : *lint_ghdl_synth
    description     : Synthesis check of sbi_I2C_wrapper, generics of the sim_* targets
    parameters      :
      - DEPTH_CMD=4
      - DEPTH_TX=8
      - DEPTH_RX=8

  #---------------------------------------
  lint_ghdl_synth_master_only :
  #---------------------------------------
    << : *lint_ghdl_synth
    description     : Synthesis check of sbi_I2C_wrapper, master only
    parameters      :
      - SLAVE_ENABLE=false

  #---------------------------------------
  lint_ghdl_synth_slave_only :
  #---------------------------------------
    << : *lint_ghdl_synth
    description     : Synthesis check of sbi_I2C_wrapper, slave only (no cmd register)
    parameters      :
      - MASTER_ENABLE=false

  #---------------------------------------
  lint_ghdl_synth_fixed_prescaler :
  #---------------------------------------
    << : *lint_ghdl_synth
    description     : Synthesis check of sbi_I2C_wrapper, fixed prescaler
    parameters      :
      - USER_DEFINE_PRESCALER=false
      - PRESCALER_RATIO=00011000

  #---------------------------------------
  # Synthesis : size of sbi_I2C_wrapper with the generics of the target,
  # Xilinx Artix-7 (LUT, FF, BRAM, DSP) and sky130 (area), by Yosys and
  # its GHDL plugin. Same configurations as lint_ghdl_synth_*.
  # The pre_run hook (yosys_synth.sh of asylum:utils:yosys_synth) adds
  # yosys_synth.mk to the edalize Makefile.
  #---------------------------------------
  syn_default : &syn
    << : *lint_ghdl
    description     : Synthesis (Artix-7, sky130) of sbi_I2C_wrapper, default generics
    filesets_append : [syn, syn_yosys]
    tools :
      ghdl :
        run_options     : ["--no-run"]
    hooks :
      pre_run : [yosys_synth]

  #---------------------------------------
  syn_sim :
  #---------------------------------------
    << : *syn
    description     : Synthesis (Artix-7, sky130) of sbi_I2C_wrapper, generics of the sim_* targets
    parameters      :
      - DEPTH_CMD=4
      - DEPTH_TX=8
      - DEPTH_RX=8

  #---------------------------------------
  syn_master_only :
  #---------------------------------------
    << : *syn
    description     : Synthesis (Artix-7, sky130) of sbi_I2C_wrapper, master only
    parameters      :
      - SLAVE_ENABLE=false

  #---------------------------------------
  syn_slave_only :
  #---------------------------------------
    << : *syn
    description     : Synthesis (Artix-7, sky130) of sbi_I2C_wrapper, slave only (no cmd register)
    parameters      :
      - MASTER_ENABLE=false

  #---------------------------------------
  syn_fixed_prescaler :
  #---------------------------------------
    << : *syn
    description     : Synthesis (Artix-7, sky130) of sbi_I2C_wrapper, fixed prescaler
    parameters      :
      - USER_DEFINE_PRESCALER=false
      - PRESCALER_RATIO=00011000

  #---------------------------------------
  # tb_I2C : compiled once (one DUT configuration), scenarios chosen at
  # run time (TESTS_LIST, empty : build and elaboration only) ;
  # sim_i2c (build only) and one sim_i2c_<test> target per scenario
  #---------------------------------------
  sim_i2c: &sim_i2c
    << : *default
    description     : Simulation of sbi_I2C (tb_I2C) - build only (scenarios of TESTS_LIST)
    filesets_append :
      - sim_basic
    toplevel        : tb_I2C
    parameters      :
      - TESTS_LIST
    default_tool    : ghdl
    tools :
      ghdl :
        analyze_options :
          - "$(GHDL_ANALYZE_OPTION)"
          - "-Wall"
          - "-frelaxed"
        run_options     :
          - "$(GHDL_RUN_OPTION)"
          - "--ieee-asserts=disable"

  #---------------------------------------
  sim_i2c_reset_values:
  #---------------------------------------
    << : *sim_i2c
    description     : Simulation of sbi_I2C (tb_I2C) - reset values of the registers
    parameters      :
      - TESTS_LIST=reset_values

  #---------------------------------------
  sim_i2c_master_write:
  #---------------------------------------
    << : *sim_i2c
    description     : Simulation of sbi_I2C (tb_I2C) - DUT master writes to the BFM slave, SCL period (prescaler 4)
    parameters      :
      - TESTS_LIST=master_write

  #---------------------------------------
  sim_i2c_master_read:
  #---------------------------------------
    << : *sim_i2c
    description     : Simulation of sbi_I2C (tb_I2C) - DUT master reads from the BFM slave
    parameters      :
      - TESTS_LIST=master_read

  #---------------------------------------
  sim_i2c_master_write_read:
  #---------------------------------------
    << : *sim_i2c
    description     : Simulation of sbi_I2C (tb_I2C) - DUT master write + repeated START + read (register read)
    parameters      :
      - TESTS_LIST=master_write_read

  #---------------------------------------
  sim_i2c_master_nack:
  #---------------------------------------
    << : *sim_i2c
    description     : Simulation of sbi_I2C (tb_I2C) - DUT master writes to an absent slave (NACK)
    parameters      :
      - TESTS_LIST=master_nack

  #---------------------------------------
  sim_i2c_master_stretch:
  #---------------------------------------
    << : *sim_i2c
    description     : Simulation of sbi_I2C (tb_I2C) - DUT master write with SCL stretched by the bench
    parameters      :
      - TESTS_LIST=master_stretch

  #---------------------------------------
  sim_i2c_master_prescaler:
  #---------------------------------------
    << : *sim_i2c
    description     : Simulation of sbi_I2C (tb_I2C) - DUT master SCL period with prescaler 9
    parameters      :
      - TESTS_LIST=master_prescaler

  #---------------------------------------
  sim_i2c_slave_write:
  #---------------------------------------
    << : *sim_i2c
    description     : Simulation of sbi_I2C (tb_I2C) - BFM master writes to the DUT slave
    parameters      :
      - TESTS_LIST=slave_write

  #---------------------------------------
  sim_i2c_slave_read:
  #---------------------------------------
    << : *sim_i2c
    description     : Simulation of sbi_I2C (tb_I2C) - BFM master reads from the DUT slave
    parameters      :
      - TESTS_LIST=slave_read

  #---------------------------------------
  sim_i2c_slave_stretch:
  #---------------------------------------
    << : *sim_i2c
    description     : Simulation of sbi_I2C (tb_I2C) - BFM master reads from the DUT slave, TX FIFO empty (clock stretching)
    parameters      :
      - TESTS_LIST=slave_stretch

  #---------------------------------------
  sim_i2c_slave_write_read:
  #---------------------------------------
    << : *sim_i2c
    description     : Simulation of sbi_I2C (tb_I2C) - BFM master write + repeated START + read from the DUT slave
    parameters      :
      - TESTS_LIST=slave_write_read

  #---------------------------------------
  sim_i2c_slave_wrong_address:
  #---------------------------------------
    << : *sim_i2c
    description     : Simulation of sbi_I2C (tb_I2C) - BFM master addresses an other slave (NACK)
    parameters      :
      - TESTS_LIST=slave_wrong_address

  #---------------------------------------
  sim_i2c_slave_disabled:
  #---------------------------------------
    << : *sim_i2c
    description     : Simulation of sbi_I2C (tb_I2C) - BFM master addresses a disabled slave (NACK)
    parameters      :
      - TESTS_LIST=slave_disabled

  #---------------------------------------
  sim_i2c_disabled:
  #---------------------------------------
    << : *sim_i2c
    description     : Simulation of sbi_I2C (tb_I2C) - BFM master addresses a disabled I2C (NACK, pads released)
    parameters      :
      - TESTS_LIST=disabled

  #---------------------------------------
  # tb_I2C_multi : compiled once per configuration (NB_SLAVE), scenarios
  # chosen at run time (TESTS_LIST, empty : build and elaboration only).
  # Reference configuration 3 slaves : sim_multi_3 (build only) and one
  # sim_multi_3_<test> target per scenario ; the other configurations run
  # the whole list. Each target repeats the generics of its
  # configuration : FuseSoC replaces the parameters list of an inherited
  # target.
  #---------------------------------------
  sim_multi_3: &sim_multi
    << : *default
    description     : Simulation of one master and 3 slaves sbi_I2C (tb_I2C_multi) - build only (scenarios of TESTS_LIST)
    filesets_append :
      - sim_multi
    toplevel        : tb_I2C_multi
    parameters      :
      - TESTS_LIST
      - NB_SLAVE=3
    default_tool    : ghdl
    tools :
      ghdl :
        analyze_options :
          - "$(GHDL_ANALYZE_OPTION)"
          - "-Wall"
          - "-frelaxed"
        run_options     :
          - "$(GHDL_RUN_OPTION)"
          - "--ieee-asserts=disable"

  #---------------------------------------
  sim_multi_3_write:
  #---------------------------------------
    << : *sim_multi
    description     : Simulation of one master and 3 slaves sbi_I2C (tb_I2C_multi) - the master writes to each slave
    parameters      :
      - TESTS_LIST=write
      - NB_SLAVE=3

  #---------------------------------------
  sim_multi_3_read:
  #---------------------------------------
    << : *sim_multi
    description     : Simulation of one master and 3 slaves sbi_I2C (tb_I2C_multi) - the master reads from each slave
    parameters      :
      - TESTS_LIST=read
      - NB_SLAVE=3

  #---------------------------------------
  sim_multi_3_write_read:
  #---------------------------------------
    << : *sim_multi
    description     : Simulation of one master and 3 slaves sbi_I2C (tb_I2C_multi) - write to a slave + repeated START + read from an other slave
    parameters      :
      - TESTS_LIST=write_read
      - NB_SLAVE=3

  #---------------------------------------
  sim_multi_3_stretch:
  #---------------------------------------
    << : *sim_multi
    description     : Simulation of one master and 3 slaves sbi_I2C (tb_I2C_multi) - read with an empty TX FIFO (clock stretching by the slave)
    parameters      :
      - TESTS_LIST=stretch
      - NB_SLAVE=3

  #---------------------------------------
  sim_multi_3_nack:
  #---------------------------------------
    << : *sim_multi
    description     : Simulation of one master and 3 slaves sbi_I2C (tb_I2C_multi) - write to an absent address (NACK)
    parameters      :
      - TESTS_LIST=nack
      - NB_SLAVE=3

  #---------------------------------------
  sim_multi_1:
  #---------------------------------------
    << : *sim_multi
    description     : Simulation of one master and 1 slave sbi_I2C (tb_I2C_multi) - every scenario
    parameters      :
      - TESTS_LIST=write,read,write_read,stretch,nack
      - NB_SLAVE=1

#=========================================
scripts:
#=========================================

  #---------------------------------------
  # pre_run hook of lint_ghdl_synth_* (cwd = work_root)
  #---------------------------------------
  ghdl_synth :
    cmd : [bash, ghdl_synth.sh]

  #---------------------------------------
  # pre_run hook of syn_* (cwd = work_root)
  #---------------------------------------
  yosys_synth :
    cmd : [bash, yosys_synth.sh]

#=========================================
parameters :
#=========================================

  #---------------------------------------
  # Generics of the testbenches (sim_*)
  #---------------------------------------
  TESTS_LIST :
    description : Scenarios run in sequence, separated by ',' (names in sim/basic/tb_I2C_tests_pkg.vhd, sim/multi/tb_I2C_multi_tests_pkg.vhd), empty = build only
    datatype    : str
    default     : ""
    paramtype   : generic

  NB_SLAVE :
    description : Number of slave instances of tb_I2C_multi (1 to 3)
    datatype    : int
    default     : 3
    paramtype   : generic

  #---------------------------------------
  # Generics of sbi_I2C_wrapper (lint_ghdl_synth_*, syn_*)
  #---------------------------------------
  USER_DEFINE_PRESCALER :
    description : true, prescaler register writable by software ; false, ratio fixed to PRESCALER_RATIO
    datatype    : bool
    default     : true
    paramtype   : generic

  PRESCALER_RATIO :
    description : Reset / fixed value of the prescaler ratio (8-bit string)
    datatype    : str
    default     : "01111100"
    paramtype   : generic

  MASTER_ENABLE :
    description : true, master implemented (and cmd register)
    datatype    : bool
    default     : true
    paramtype   : generic

  SLAVE_ENABLE :
    description : true, slave implemented
    datatype    : bool
    default     : true
    paramtype   : generic

  DEPTH_CMD :
    description : Depth of the command FIFO (0 = no FIFO)
    datatype    : int
    default     : 0
    paramtype   : generic

  DEPTH_TX :
    description : Depth of the TX FIFO (0 = no FIFO)
    datatype    : int
    default     : 0
    paramtype   : generic

  DEPTH_RX :
    description : Depth of the RX FIFO (0 = no FIFO)
    datatype    : int
    default     : 0
    paramtype   : generic

# Next lines is a pragma, don't modify
#<PROVIDER_BEGIN>
provider  :
  name    : github
  user    : deuskane
  repo    : asylum-communication-i2c
  version : asylum-communication-I2C-1.0.0
 #version : e5270eb6e2790a9be1f8834bbc8de2ba14efe3eb
#<PROVIDER_END>
