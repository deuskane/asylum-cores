CAPI=2:

#-----------------------------------------------------------------------------
# Title      : SPI Core file
# Project    : Asylum
#-----------------------------------------------------------------------------
# File       : SPI.core
# Author     : mrosiere
#-----------------------------------------------------------------------------
# Description: 
#-----------------------------------------------------------------------------
# Copyright (c) 2025
#-----------------------------------------------------------------------------
# Revisions  :
# Date        Version  Author   Description
# 2025-06-13  1.0.0    mrosiere First Release
# 2025-06-21  1.0.1    mrosiere Dump FIFO activity in file
# 2025-06-25  1.1.0    mrosiere Add STOP special case
# 2025-07-09  1.2.0    mrosiere Configure FIFO Depth
# 2025-09-05  1.2.1    mrosiere Add Package
# 2025-11-22  1.2.2    mrosiere Use sbi instead pbi
# 2026-01-17  1.2.3    mrosiere Move loopback from sbi_SPI to spi_master
# 2026-06-06  1.2.4    mrosiere Add Name
# 2026-08-02  1.2.5    mrosiere Testbench : use UVVM sbi, dut is sbi_spi instead spi_master
# 2026-08-17  2.0.0    mrosiere Add multiple data
# 2026-10-05  2.0.1    mrosiere Update sim_basic
# 2026-10-27  2.1.0    mrosiere Update after review
# 2026-11-16  2.2.0    mrosiere spi_enable = 0 drives CS# / SCLK and flushes the FIFOs,
#                               RX_LATE_SAMPLE (input registers, late RX sampling)
#-----------------------------------------------------------------------------

name        : asylum:communication:SPI:2.2.0
description : SPI Module

#=========================================
generate:
#=========================================

  #---------------------------------------
  gen_csr:
  #---------------------------------------
    generator : regtool
    parameters:
      file         : hdl/csr/SPI.hjson
      name         : SPI
      copy         : hdl/csr
      logical_name : asylum

#=========================================
filesets:
#=========================================

  #---------------------------------------
  hdl:
  #---------------------------------------
    files        :
      - hdl/spi_pkg.vhd
      - hdl/spi_master.vhd
      - hdl/sbi_SPI.vhd
    file_type    : vhdlSource
    logical_name : asylum
    depend       :
      - ">=asylum:utils:generators:2.8.0"
      - asylum:utils:pkg

  #---------------------------------------
  syn:
  #---------------------------------------
    files        :
      - syn/sbi_SPI_wrapper.vhd
    file_type    : vhdlSource
    logical_name : asylum
    # ghdl_synth.sh / ghdl_synth.mk (pre_run hook of lint_ghdl_synth_*)
    depend       :
      - asylum:utils:pkg
      - asylum:utils:ghdl_synth

  #---------------------------------------
  syn_yosys:
  #---------------------------------------
    # yosys_synth.sh / yosys_synth.mk / yosys_synth.py (pre_run hook of syn_*)
    depend       :
      - asylum:utils:yosys_synth

  #---------------------------------------
  sim_basic:
  #---------------------------------------
    files:
      - sim/basic/tb_SPI_bfm_pkg.vhd
      - sim/basic/tb_SPI_reset_pkg.vhd
      - sim/basic/tb_SPI_modes_pkg.vhd
      - sim/basic/tb_SPI_cmd_pkg.vhd
      - sim/basic/tb_SPI_tests_pkg.vhd
      - sim/basic/tb_SPI.vhd
#    logical_name : work
    file_type : vhdlSource-2008
    depend       :
      - bitvis:verification:uvvm
      # string_pkg list_length / list_item / list_contains (TESTS_LIST)
      - ">=asylum:utils:pkg:1.10.0"

  #---------------------------------------
  models:
  #---------------------------------------
    files:
      - sim/basic/tb_SPI_pkg.vhd
      - sim/models/tb_SPI_models_bfm_pkg.vhd
      - sim/models/tb_SPI_models_read_pkg.vhd
      - sim/models/tb_SPI_models_multi_io_pkg.vhd
      - sim/models/tb_SPI_models_tests_pkg.vhd
      - sim/models/tb_SPI.vhd
      - sim/models/mem/memory_1KB.mem    : {file_type : user, copyto : memory.mem   }
      - sim/models/mem/memoryOTP.mem     : {file_type : user, copyto : memoryOTP.mem}
      - sim/models/mem/none              : {file_type : user, copyto : none         }
#    logical_name : work
    file_type    : vhdlSource-2008
    depend       :
      - asylum:target:techmap
      - bitvis:verification:uvvm 
      - fmf:memory:flash_nor
      # string_pkg list_length / list_item / list_contains (TESTS_LIST)
      - ">=asylum:utils:pkg:1.10.0"

#=========================================
targets:
#=========================================

  #---------------------------------------
  default: &default
  #---------------------------------------
    description     : Default Target
    filesets        :
      - hdl
    toplevel        : asylum.sbi_SPI
    default_tool    : ghdl
    generate        :
      - gen_csr

  #---------------------------------------
  # Lint : -Wall analysis and elaboration (empty simulation)
  #---------------------------------------
  lint_ghdl : &lint_ghdl
    << : *default
    description     : Lint with GHDL (-Wall analysis and elaboration of sbi_SPI_wrapper)
    toplevel        : asylum.sbi_SPI_wrapper
    filesets_append : [syn]
    default_tool    : ghdl
    tools :
      ghdl :
        analyze_options : ["-Wall"]

  #---------------------------------------
  # Synthesis check : -Wall analysis, ghdl --synth -Wall and elaboration
  # (no simulation) of sbi_SPI_wrapper with the generics of the target.
  # The pre_run hook (ghdl_synth.sh of asylum:utils:ghdl_synth) adds
  # ghdl_synth.mk to the edalize Makefile.
  # FuseSoC merges tools in depth : analyze_options comes from lint_ghdl.
  #---------------------------------------
  lint_ghdl_synth_default : &lint_ghdl_synth
    << : *lint_ghdl
    description     : Synthesis check of sbi_SPI_wrapper, default generics (PicoSoC)
    tools :
      ghdl :
        run_options     : ["--no-run"]
    hooks :
      pre_run : [ghdl_synth]

  #---------------------------------------
  lint_ghdl_synth_sim_basic :
  #---------------------------------------
    << : *lint_ghdl_synth
    description     : Synthesis check of sbi_SPI_wrapper, generics of sim_basic
    parameters      :
      - PRESCALER_RATIO=00001111
      - DEPTH_CMD=4
      - DEPTH_TX=8
      - DEPTH_RX=8
      - HANDLE_HOLD_WP=false

  #---------------------------------------
  lint_ghdl_synth_sim_models :
  #---------------------------------------
    << : *lint_ghdl_synth
    description     : Synthesis check of sbi_SPI_wrapper, generics of the model testbenches
    parameters      :
      - PRESCALER_RATIO=00001111
      - DEPTH_CMD=4
      - DEPTH_TX=4
      - DEPTH_RX=4

  #---------------------------------------
  lint_ghdl_synth_fixed_prescaler :
  #---------------------------------------
    << : *lint_ghdl_synth
    description     : Synthesis check of sbi_SPI_wrapper, fixed prescaler
    parameters      :
      - USER_DEFINE_PRESCALER=false
      - PRESCALER_RATIO=00001111

  #---------------------------------------
  lint_ghdl_synth_rx_late_sample :
  #---------------------------------------
    << : *lint_ghdl_synth
    description     : Synthesis check of sbi_SPI_wrapper, late RX sampling (input registers)
    parameters      :
      - RX_LATE_SAMPLE=true

  #---------------------------------------
  # Synthesis : size of sbi_SPI_wrapper with the generics of the target,
  # Xilinx Artix-7 (LUT, FF, BRAM, DSP) and sky130 (area), by Yosys and
  # its GHDL plugin. Same configurations as lint_ghdl_synth_*.
  # The pre_run hook (yosys_synth.sh of asylum:utils:yosys_synth) adds
  # yosys_synth.mk to the edalize Makefile.
  #---------------------------------------
  syn_default : &syn
    << : *lint_ghdl
    description     : Synthesis (Artix-7, sky130) of sbi_SPI_wrapper, default generics (PicoSoC)
    filesets_append : [syn, syn_yosys]
    tools :
      ghdl :
        run_options     : ["--no-run"]
    hooks :
      pre_run : [yosys_synth]

  #---------------------------------------
  syn_sim_basic :
  #---------------------------------------
    << : *syn
    description     : Synthesis (Artix-7, sky130) of sbi_SPI_wrapper, generics of sim_basic
    parameters      :
      - PRESCALER_RATIO=00001111
      - DEPTH_CMD=4
      - DEPTH_TX=8
      - DEPTH_RX=8
      - HANDLE_HOLD_WP=false

  #---------------------------------------
  syn_sim_models :
  #---------------------------------------
    << : *syn
    description     : Synthesis (Artix-7, sky130) of sbi_SPI_wrapper, generics of the model testbenches
    parameters      :
      - PRESCALER_RATIO=00001111
      - DEPTH_CMD=4
      - DEPTH_TX=4
      - DEPTH_RX=4

  #---------------------------------------
  syn_fixed_prescaler :
  #---------------------------------------
    << : *syn
    description     : Synthesis (Artix-7, sky130) of sbi_SPI_wrapper, fixed prescaler
    parameters      :
      - USER_DEFINE_PRESCALER=false
      - PRESCALER_RATIO=00001111

  #---------------------------------------
  syn_rx_late_sample :
  #---------------------------------------
    << : *syn
    description     : Synthesis (Artix-7, sky130) of sbi_SPI_wrapper, late RX sampling (input registers)
    parameters      :
      - RX_LATE_SAMPLE=true

  #---------------------------------------
  # tb_SPI basic : compiled once per configuration (RX_LATE_SAMPLE,
  # SLAVE_TV_NS), scenarios chosen at run time (TESTS_LIST, empty :
  # build and elaboration only).
  # Reference configuration : default generics (sampling on the sample
  # edge) : sim_basic (build only) and one sim_basic_<test> target per
  # scenario ; sim_basic_late runs the whole list. Each target repeats
  # the generics of its configuration : FuseSoC replaces the parameters
  # list of an inherited target.
  #---------------------------------------
  sim_basic: &sim_basic
    << : *default
    description     : Simulation of sbi_SPI with the SPI slave model of the bench (UVVM) - build only (scenarios of TESTS_LIST)
    filesets_append :
      - sim_basic
    toplevel        : tb_SPI
    parameters      :
      - TESTS_LIST
      - RX_LATE_SAMPLE=false
      - SLAVE_TV_NS=0
    default_tool    : ghdl
    tools :
      ghdl :
        analyze_options :
          - "$(GHDL_ANALYZE_OPTION)"
          - "-Wall"
          - "-frelaxed"
        run_options     :
          - "$(GHDL_RUN_OPTION)"
          - "--ieee-asserts=disable"

  #---------------------------------------
  sim_basic_reset_values:
  #---------------------------------------
    << : *sim_basic
    description     : Simulation of sbi_SPI with the SPI slave model of the bench (UVVM) - reset values, pads driven by the master in reset
    parameters      :
      - TESTS_LIST=reset_values
      - RX_LATE_SAMPLE=false
      - SLAVE_TV_NS=0

  #---------------------------------------
  sim_basic_single:
  #---------------------------------------
    << : *sim_basic
    description     : Simulation of sbi_SPI with the SPI slave model of the bench (UVVM) - single full duplex 1 and 4 bytes in the 4 modes, SCLK period
    parameters      :
      - TESTS_LIST=single
      - RX_LATE_SAMPLE=false
      - SLAVE_TV_NS=0

  #---------------------------------------
  sim_basic_dual:
  #---------------------------------------
    << : *sim_basic
    description     : Simulation of sbi_SPI with the SPI slave model of the bench (UVVM) - dual TX and RX in the 4 modes
    parameters      :
      - TESTS_LIST=dual
      - RX_LATE_SAMPLE=false
      - SLAVE_TV_NS=0

  #---------------------------------------
  sim_basic_quad:
  #---------------------------------------
    << : *sim_basic
    description     : Simulation of sbi_SPI with the SPI slave model of the bench (UVVM) - quad TX and RX in the 4 modes
    parameters      :
      - TESTS_LIST=quad
      - RX_LATE_SAMPLE=false
      - SLAVE_TV_NS=0

  #---------------------------------------
  sim_basic_stop:
  #---------------------------------------
    << : *sim_basic
    description     : Simulation of sbi_SPI with the SPI slave model of the bench (UVVM) - commands without last then STOP in the 4 modes
    parameters      :
      - TESTS_LIST=stop
      - RX_LATE_SAMPLE=false
      - SLAVE_TV_NS=0

  #---------------------------------------
  sim_basic_cs_high:
  #---------------------------------------
    << : *sim_basic
    description     : Simulation of sbi_SPI with the SPI slave model of the bench (UVVM) - back to back transactions, CS# high time, in the 4 modes
    parameters      :
      - TESTS_LIST=cs_high
      - RX_LATE_SAMPLE=false
      - SLAVE_TV_NS=0

  #---------------------------------------
  sim_basic_keep:
  #---------------------------------------
    << : *sim_basic
    description     : Simulation of sbi_SPI with the SPI slave model of the bench (UVVM) - KEEP command mode
    parameters      :
      - TESTS_LIST=keep
      - RX_LATE_SAMPLE=false
      - SLAVE_TV_NS=0

  #---------------------------------------
  sim_basic_loopback:
  #---------------------------------------
    << : *sim_basic
    description     : Simulation of sbi_SPI with the SPI slave model of the bench (UVVM) - loopback
    parameters      :
      - TESTS_LIST=loopback
      - RX_LATE_SAMPLE=false
      - SLAVE_TV_NS=0

  #---------------------------------------
  sim_basic_disable:
  #---------------------------------------
    << : *sim_basic
    description     : Simulation of sbi_SPI with the SPI slave model of the bench (UVVM) - abort by spi_enable = 0, commands dropped while disabled
    parameters      :
      - TESTS_LIST=disable
      - RX_LATE_SAMPLE=false
      - SLAVE_TV_NS=0

  #---------------------------------------
  sim_basic_status:
  #---------------------------------------
    << : *sim_basic
    description     : Simulation of sbi_SPI with the SPI slave model of the bench (UVVM) - status flags and busy, master stalled by a full RX FIFO
    parameters      :
      - TESTS_LIST=status
      - RX_LATE_SAMPLE=false
      - SLAVE_TV_NS=0

  #---------------------------------------
  sim_basic_late:
  #---------------------------------------
    << : *sim_basic
    description     : Simulation of sbi_SPI with the SPI slave model of the bench (UVVM) - RX_LATE_SAMPLE and a slave output valid time longer than half a SCLK period, every scenario
    parameters      :
      - TESTS_LIST=reset_values,single,dual,quad,stop,cs_high,keep,loopback,disable,status
      - RX_LATE_SAMPLE=true
      - SLAVE_TV_NS=25

  #---------------------------------------
  # Flash model testbench (sim/models) : compiled once per model (MODEL),
  # scenarios chosen at run time (TESTS_LIST, empty : build and
  # elaboration only).
  # Reference configuration s25fl512s (the only model with the dual and
  # quad scenarios) : sim_s25fl512s (build only) and one
  # sim_s25fl512s_<test> target per scenario ; the other models run
  # the scenarios they support (read, fast_read).
  #---------------------------------------
  sim_s25fl512s: &sim_models
    << : *default
    description     : Simulation of sbi_SPI with the s25fl512s flash model - build only (scenarios of TESTS_LIST)
    filesets_append :
      - models
    toplevel        : tb
    parameters      :
      - TESTS_LIST
      - MODEL=s25fl512s
    default_tool    : ghdl
    tools :
      ghdl :
        analyze_options :
          - "$(GHDL_ANALYZE_OPTION)"
          - "-frelaxed"
          - "--no-vital-checks"
          - "-Wno-shared"
          - "-Wno-hide"
          - "-Wno-pure"
        run_options     :
          - "$(GHDL_RUN_OPTION)"
          - "--ieee-asserts=disable"

  #---------------------------------------
  sim_s25fl512s_read:
  #---------------------------------------
    << : *sim_models
    description     : Simulation of sbi_SPI with the s25fl512s flash model - Read (0x03)
    parameters      :
      - TESTS_LIST=read
      - MODEL=s25fl512s

  #---------------------------------------
  sim_s25fl512s_fast_read:
  #---------------------------------------
    << : *sim_models
    description     : Simulation of sbi_SPI with the s25fl512s flash model - Fast Read (0x0B)
    parameters      :
      - TESTS_LIST=fast_read
      - MODEL=s25fl512s

  #---------------------------------------
  sim_s25fl512s_dual_read:
  #---------------------------------------
    << : *sim_models
    description     : Simulation of sbi_SPI with the s25fl512s flash model - DOR (0x3B)
    parameters      :
      - TESTS_LIST=dual_read
      - MODEL=s25fl512s

  #---------------------------------------
  sim_s25fl512s_dual_io_read:
  #---------------------------------------
    << : *sim_models
    description     : Simulation of sbi_SPI with the s25fl512s flash model - DIOR (0xBB)
    parameters      :
      - TESTS_LIST=dual_io_read
      - MODEL=s25fl512s

  #---------------------------------------
  sim_s25fl512s_quad_read:
  #---------------------------------------
    << : *sim_models
    description     : Simulation of sbi_SPI with the s25fl512s flash model - QOR (0x6B)
    parameters      :
      - TESTS_LIST=quad_read
      - MODEL=s25fl512s

  #---------------------------------------
  sim_s25fl512s_quad_io_read:
  #---------------------------------------
    << : *sim_models
    description     : Simulation of sbi_SPI with the s25fl512s flash model - QIOR (0xEB)
    parameters      :
      - TESTS_LIST=quad_io_read
      - MODEL=s25fl512s

  #---------------------------------------
  sim_s25fl512s_quad_io_read_cont:
  #---------------------------------------
    << : *sim_models
    description     : Simulation of sbi_SPI with the s25fl512s flash model - QIOR (0xEB) in continuous mode
    parameters      :
      - TESTS_LIST=quad_io_read_cont
      - MODEL=s25fl512s

  #---------------------------------------
  sim_at25df161:
  #---------------------------------------
    << : *sim_models
    description     : Simulation of sbi_SPI with the at25df161 flash model - Read, Fast Read
    parameters      :
      - TESTS_LIST=read,fast_read
      - MODEL=at25df161

  #---------------------------------------
  sim_cy15b104qs:
  #---------------------------------------
    << : *sim_models
    description     : Simulation of sbi_SPI with the cy15b104qs flash model - Read, Fast Read
    parameters      :
      - TESTS_LIST=read,fast_read
      - MODEL=cy15b104qs

  #---------------------------------------
  sim_cy15v104qs:
  #---------------------------------------
    << : *sim_models
    description     : Simulation of sbi_SPI with the cy15v104qs flash model - Read, Fast Read
    parameters      :
      - TESTS_LIST=read,fast_read
      - MODEL=cy15v104qs

  #---------------------------------------
  sim_m25p40:
  #---------------------------------------
    << : *sim_models
    description     : Simulation of sbi_SPI with the m25p40 flash model - Read, Fast Read
    parameters      :
      - TESTS_LIST=read,fast_read
      - MODEL=m25p40

  #---------------------------------------
  sim_m45pe80:
  #---------------------------------------
    << : *sim_models
    description     : Simulation of sbi_SPI with the m45pe80 flash model - Read, Fast Read
    parameters      :
      - TESTS_LIST=read,fast_read
      - MODEL=m45pe80

  #---------------------------------------
  sim_s25fl064p:
  #---------------------------------------
    << : *sim_models
    description     : Simulation of sbi_SPI with the s25fl064p flash model - Read, Fast Read
    parameters      :
      - TESTS_LIST=read,fast_read
      - MODEL=s25fl064p

  #---------------------------------------
  sim_s35hl256t:
  #---------------------------------------
    << : *sim_models
    description     : Simulation of sbi_SPI with the s35hl256t flash model - Read, Fast Read
    parameters      :
      - TESTS_LIST=read,fast_read
      - MODEL=s35hl256t

#=========================================
scripts:
#=========================================

  #---------------------------------------
  # pre_run hook of lint_ghdl_synth_* (cwd = work_root)
  #---------------------------------------
  ghdl_synth :
    cmd : [bash, ghdl_synth.sh]

  #---------------------------------------
  # pre_run hook of syn_* (cwd = work_root)
  #---------------------------------------
  yosys_synth :
    cmd : [bash, yosys_synth.sh]

#=========================================
parameters :
#=========================================

  MODEL :
    description : SPI Memory Model
    datatype    : str
    default     : m25p40
    paramtype   : generic

  TESTS_LIST :
    description : Scenarios run in sequence, separated by ',' (names in sim/basic/tb_SPI_tests_pkg.vhd, sim/models/tb_SPI_models_tests_pkg.vhd), empty = build only
    datatype    : str
    default     : ""
    paramtype   : generic

  #---------------------------------------
  # Generics of sbi_SPI_wrapper (lint_ghdl_synth_*, syn_*)
  #---------------------------------------
  USER_DEFINE_PRESCALER :
    description : true, prescaler register writable by software ; false, ratio fixed to PRESCALER_RATIO
    datatype    : bool
    default     : true
    paramtype   : generic

  PRESCALER_RATIO :
    description : Reset / fixed value of the prescaler ratio (8-bit string)
    datatype    : str
    default     : "00000000"
    paramtype   : generic

  DEPTH_CMD :
    description : Depth of the command FIFO (0 = no FIFO)
    datatype    : int
    default     : 0
    paramtype   : generic

  DEPTH_TX :
    description : Depth of the TX FIFO (0 = no FIFO)
    datatype    : int
    default     : 0
    paramtype   : generic

  DEPTH_RX :
    description : Depth of the RX FIFO (0 = no FIFO)
    datatype    : int
    default     : 0
    paramtype   : generic

  HANDLE_HOLD_WP :
    description : true, io(2) (WP#) and io(3) (HOLD#) driven by the SPI master
    datatype    : bool
    default     : true
    paramtype   : generic

  RX_LATE_SAMPLE :
    description : true, io_i registered and sampled one SCLK period after its sample edge (sbi_SPI_wrapper and tb_SPI basic)
    datatype    : bool
    default     : false
    paramtype   : generic

  SLAVE_TV_NS :
    description : Output valid time of the SPI slave model in ns (tb_SPI basic)
    datatype    : int
    default     : 0
    paramtype   : generic

# Next lines is a pragma, don't modify
#<PROVIDER_BEGIN>
provider  :
  name    : github
  user    : deuskane
  repo    : asylum-communication-spi
  version : asylum-communication-SPI-2.2.0
 #version : b284eed993b83f846fc6a6a64fa1f0a3eb3d94aa
#<PROVIDER_END>
