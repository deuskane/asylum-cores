CAPI=2:

#-----------------------------------------------------------------------------
# Title      : spinlock Core file
# Project    : Asylum
#-----------------------------------------------------------------------------
# File       : spinlock.core
# Author     : mrosiere
#-----------------------------------------------------------------------------
# Description: 
#-----------------------------------------------------------------------------
# Copyright (c) 2025
#-----------------------------------------------------------------------------
# Revisions  :
# Date        Version  Author   Description
# 2026-05-25  1.0.0    mrosiere First Release
# 2026-06-06  1.0.1    mrosiere Add Name
# 2026-10-05  1.0.2    mrosiere Fix default target toplevel (sbi_spinlock), fix lock value
#                               description (0xFF when taken), add UVVM testbench
#-----------------------------------------------------------------------------

name        : asylum:system:spinlock:1.0.2
description : spinlock Module

#=========================================
generate:
#=========================================

  #---------------------------------------
  gen_csr:
  #---------------------------------------
    generator : regtool
    parameters:
      file         : hdl/csr/spinlock.hjson
      name         : spinlock
      copy         : hdl/csr
      logical_name : asylum

#=========================================
filesets:
#=========================================

  #---------------------------------------
  hdl:
  #---------------------------------------
    files        :
      - hdl/spinlock_pkg.vhd
      - hdl/sbi_spinlock.vhd
    file_type    : vhdlSource
    logical_name : asylum
    depend       :
      - ">=asylum:utils:generators:2.8.0"
      - asylum:utils:pkg

  #---------------------------------------
  sim:
  #---------------------------------------
    files:
      - sim/spinlock/tb_spinlock_bfm_pkg.vhd
      - sim/spinlock/tb_spinlock_reset_values_pkg.vhd
      - sim/spinlock/tb_spinlock_acquire_release_pkg.vhd
      - sim/spinlock/tb_spinlock_independent_pkg.vhd
      - sim/spinlock/tb_spinlock_write_values_pkg.vhd
      - sim/spinlock/tb_spinlock_async_reset_pkg.vhd
      - sim/spinlock/tb_spinlock_tests_pkg.vhd
      - sim/spinlock/tb_spinlock.vhd
    file_type : vhdlSource-2008
    depend       :
      - bitvis:verification:uvvm
      # string_pkg list_length / list_item / list_contains (TESTS_LIST)
      - ">=asylum:utils:pkg:1.10.0"

  #---------------------------------------
  syn:
  #---------------------------------------
    files        :
      - syn/sbi_spinlock_wrapper.vhd
    file_type    : vhdlSource-2008
    logical_name : asylum
    # ghdl_synth.sh / ghdl_synth.mk (pre_run hook of lint_ghdl_synth_*)
    depend       :
      - asylum:utils:ghdl_synth

  #---------------------------------------
  syn_yosys:
  #---------------------------------------
    # yosys_synth.sh / yosys_synth.mk / yosys_synth.py (pre_run hook of syn_*)
    depend       :
      - asylum:utils:yosys_synth

#=========================================
targets:
#=========================================

  #---------------------------------------
  default: &default
  #---------------------------------------
    description     : Default Target
    filesets        :
      - hdl
    toplevel        : sbi_spinlock
    default_tool    : ghdl
    generate        :
      - gen_csr

  #---------------------------------------
  # Lint : -Wall analysis and elaboration (empty simulation)
  #---------------------------------------
  lint_ghdl : &lint_ghdl
    << : *default
    description     : Lint with GHDL (-Wall analysis and elaboration of sbi_spinlock_wrapper)
    toplevel        : asylum.sbi_spinlock_wrapper
    filesets_append : [syn]
    default_tool    : ghdl
    tools :
      ghdl :
        analyze_options : ["-Wall"]

  #---------------------------------------
  # Synthesis check : -Wall analysis, ghdl --synth -Wall and elaboration
  # (no simulation) of sbi_spinlock_wrapper with the generics of the target.
  # The pre_run hook (ghdl_synth.sh of asylum:utils:ghdl_synth) adds
  # ghdl_synth.mk to the edalize Makefile.
  # FuseSoC merges tools in depth : analyze_options comes from lint_ghdl.
  #---------------------------------------
  lint_ghdl_synth_default : &lint_ghdl_synth
    << : *lint_ghdl
    description     : Synthesis check of sbi_spinlock_wrapper, default generics
    tools :
      ghdl :
        run_options     : ["--no-run"]
    hooks :
      pre_run : [ghdl_synth]

  #---------------------------------------
  lint_ghdl_synth_owner :
  #---------------------------------------
    << : *lint_ghdl_synth
    description     : Synthesis check of sbi_spinlock_wrapper, owner ID mode (OWNER_ID = true)
    parameters      :
      - OWNER_ID=true

  #---------------------------------------
  # Synthesis : size of sbi_spinlock_wrapper with the generics of the
  # target, Xilinx Artix-7 (LUT, FF, BRAM, DSP) and sky130 (area), by Yosys
  # and its GHDL plugin. Same configurations as lint_ghdl_synth_*.
  # The pre_run hook (yosys_synth.sh of asylum:utils:yosys_synth) adds
  # yosys_synth.mk to the edalize Makefile.
  #---------------------------------------
  syn_default : &syn
    << : *lint_ghdl
    description     : Synthesis (Artix-7, sky130) of sbi_spinlock_wrapper, default generics
    filesets_append : [syn, syn_yosys]
    tools :
      ghdl :
        run_options     : ["--no-run"]
    hooks :
      pre_run : [yosys_synth]

  #---------------------------------------
  syn_owner :
  #---------------------------------------
    << : *syn
    description     : Synthesis (Artix-7, sky130) of sbi_spinlock_wrapper, owner ID mode (OWNER_ID = true)
    parameters      :
      - OWNER_ID=true

  #---------------------------------------
  # tb_spinlock (sim/spinlock) : compiled once per configuration
  # (OWNER_ID), scenarios chosen at run time (TESTS_LIST, empty : build
  # and elaboration only). Reference configuration OWNER_ID = false
  # (test-and-set on read) : sim_spinlock (build only) and one
  # sim_spinlock_<test> target per scenario ; sim_spinlock_owner
  # (OWNER_ID = true) runs the whole list. Each target repeats the
  # generics of its configuration : FuseSoC replaces the parameters list
  # of an inherited target.
  #---------------------------------------
  sim_spinlock: &sim_spinlock
    << : *default
    description     : Simulation of sbi_spinlock (UVVM) - test-and-set on read (OWNER_ID = false) - build only (scenarios of TESTS_LIST)
    filesets_append :
      - sim
    toplevel        : tb_spinlock
    parameters      :
      - TESTS_LIST
      - OWNER_ID=false
    default_tool    : ghdl
    tools :
      ghdl :
        analyze_options :
          - "$(GHDL_ANALYZE_OPTION)"
          - "-Wall"
          - "-frelaxed"
        run_options     :
          - "$(GHDL_RUN_OPTION)"
          - "--ieee-asserts=disable"

  #---------------------------------------
  sim_spinlock_reset_values:
  #---------------------------------------
    << : *sim_spinlock
    description     : Simulation of sbi_spinlock (UVVM) - test-and-set on read (OWNER_ID = false) - every lock free after reset, NAME of the target, first read takes the lock
    parameters      :
      - TESTS_LIST=reset_values
      - OWNER_ID=false

  #---------------------------------------
  sim_spinlock_acquire_release:
  #---------------------------------------
    << : *sim_spinlock
    description     : Simulation of sbi_spinlock (UVVM) - test-and-set on read (OWNER_ID = false) - a read takes a free lock, the next reads return taken, write 0x00 releases
    parameters      :
      - TESTS_LIST=acquire_release
      - OWNER_ID=false

  #---------------------------------------
  sim_spinlock_independent:
  #---------------------------------------
    << : *sim_spinlock
    description     : Simulation of sbi_spinlock (UVVM) - test-and-set on read (OWNER_ID = false) - an access to a lock never changes the other one
    parameters      :
      - TESTS_LIST=independent
      - OWNER_ID=false

  #---------------------------------------
  sim_spinlock_write_values:
  #---------------------------------------
    << : *sim_spinlock
    description     : Simulation of sbi_spinlock (UVVM) - test-and-set on read (OWNER_ID = false) - a write never takes a lock, it clears the bits written to 0
    parameters      :
      - TESTS_LIST=write_values
      - OWNER_ID=false

  #---------------------------------------
  sim_spinlock_async_reset:
  #---------------------------------------
    << : *sim_spinlock
    description     : Simulation of sbi_spinlock (UVVM) - test-and-set on read (OWNER_ID = false) - the asynchronous reset releases every lock, also without clock edge
    parameters      :
      - TESTS_LIST=async_reset
      - OWNER_ID=false

  #---------------------------------------
  sim_spinlock_owner:
  #---------------------------------------
    << : *sim_spinlock
    description     : Simulation of sbi_spinlock (UVVM) - owner ID mode (OWNER_ID = true), every scenario
    parameters      :
      - TESTS_LIST=reset_values,acquire_release,independent,write_values,async_reset
      - OWNER_ID=true

#=========================================
scripts:
#=========================================

  #---------------------------------------
  # pre_run hook of lint_ghdl_synth_* (cwd = work_root)
  #---------------------------------------
  ghdl_synth :
    cmd : [bash, ghdl_synth.sh]

  #---------------------------------------
  # pre_run hook of syn_* (cwd = work_root)
  #---------------------------------------
  yosys_synth :
    cmd : [bash, yosys_synth.sh]

#=========================================
parameters :
#=========================================

  TESTS_LIST :
    description : Scenarios run in sequence, separated by ',' (names in sim/spinlock/tb_spinlock_tests_pkg.vhd), empty = build only
    datatype    : str
    default     : ""
    paramtype   : generic

  OWNER_ID :
    description : Lock protocol of sbi_spinlock (tb_spinlock, sbi_spinlock_wrapper), false = test-and-set on read, true = owner ID
    datatype    : bool
    default     : false
    paramtype   : generic

# Next lines is a pragma, don't modify
#<PROVIDER_BEGIN>
provider  :
  name    : github
  user    : deuskane
  repo    : asylum-system-spinlock
  version : asylum-system-spinlock-1.0.2
 #version : 4e4def844dad65bbb2b37f0926dc5c6e2bb8f5aa
#<PROVIDER_END>
