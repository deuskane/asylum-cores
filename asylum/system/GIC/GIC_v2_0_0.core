CAPI=2:

#-----------------------------------------------------------------------------
# Title      : GIC Core file
# Project    : Asylum
#-----------------------------------------------------------------------------
# File       : GIC.core
# Author     : mrosiere
#-----------------------------------------------------------------------------
# Description: 
#-----------------------------------------------------------------------------
# Copyright (c) 2025
#-----------------------------------------------------------------------------
# Revisions  :
# Date        Version  Author   Description
# 2025-06-28  1.0.0    mrosiere First Release
# 2025-07-30  1.1.0    mrosiere Add package
# 2025-11-22  1.1.1    mrosiere Use sbi instead pbi
# 2026-01-17  1.2.0    mrosiere Add parameter to enable syncdff
# 2026-06-06  1.2.1    mrosiere Add Name
# 2026-10-05  1.2.2    mrosiere Fix default target toplevel (sbi_GIC), assert number of
#                               lines, add UVVM testbench
# 2026-11-12  2.0.0    mrosiere ISR latches the masked lines too, the IMR masks itm_o only
#                               (behaviour change for the software and for the IPs using
#                               GIC_core) ; lines mapped by position ; it_ctrl keeps an
#                               edge coinciding with the ack ; lint_ghdl /
#                               lint_ghdl_synth_* targets, it_ctrl testbench
#-----------------------------------------------------------------------------

name        : asylum:system:GIC:2.0.0
description : GIC Module

#=========================================
generate:
#=========================================

  #---------------------------------------
  gen_csr:
  #---------------------------------------
    generator : regtool
    parameters:
      file         : hdl/csr/GIC.hjson
      name         : GIC
      copy         : hdl/csr
      logical_name : asylum

#=========================================
filesets:
#=========================================

  #---------------------------------------
  hdl:
  #---------------------------------------
    files        :
      - hdl/GIC_pkg.vhd
      - hdl/it_ctrl.vhd
      - hdl/GIC_core.vhd
      - hdl/sbi_GIC.vhd
    file_type    : vhdlSource
    logical_name : asylum
    depend       :
      - ">=asylum:utils:generators:2.8.0"
      - asylum:utils:pkg
      - asylum:target:techmap

  #---------------------------------------
  sim:
  #---------------------------------------
    files:
      - sim/gic/tb_GIC_bfm_pkg.vhd
      - sim/gic/tb_GIC_reset_values_pkg.vhd
      - sim/gic/tb_GIC_imr_rw_pkg.vhd
      - sim/gic/tb_GIC_masked_latched_pkg.vhd
      - sim/gic/tb_GIC_unmasked_itm_pkg.vhd
      - sim/gic/tb_GIC_latency_pulse_pkg.vhd
      - sim/gic/tb_GIC_rw1c_pkg.vhd
      - sim/gic/tb_GIC_isr_set_again_pkg.vhd
      - sim/gic/tb_GIC_mask_pending_pkg.vhd
      - sim/gic/tb_GIC_random_pkg.vhd
      - sim/gic/tb_GIC_async_reset_pkg.vhd
      - sim/gic/tb_GIC_tests_pkg.vhd
      - sim/gic/tb_GIC.vhd
    file_type : vhdlSource-2008
    depend       :
      - bitvis:verification:uvvm
      # string_pkg list_length / list_item (TESTS_LIST)
      - ">=asylum:utils:pkg:1.10.0"

  #---------------------------------------
  sim_it_ctrl:
  #---------------------------------------
    files:
      - sim/it_ctrl/tb_it_ctrl_pkg.vhd
      - sim/it_ctrl/tb_it_ctrl.vhd
    file_type : vhdlSource-2008
    depend       :
      - bitvis:verification:uvvm
      # string_pkg list_length / list_item (TESTS_LIST)
      - ">=asylum:utils:pkg:1.10.0"

  #---------------------------------------
  syn:
  #---------------------------------------
    files        :
      - syn/sbi_GIC_wrapper.vhd
    file_type    : vhdlSource-2008
    logical_name : asylum
    # ghdl_synth.sh / ghdl_synth.mk (pre_run hook of lint_ghdl_synth_*)
    depend       :
      - asylum:utils:ghdl_synth

  #---------------------------------------
  syn_yosys:
  #---------------------------------------
    # yosys_synth.sh / yosys_synth.mk / yosys_synth.py (pre_run hook of syn_*)
    depend       :
      - asylum:utils:yosys_synth

#=========================================
targets:
#=========================================

  #---------------------------------------
  default: &default
  #---------------------------------------
    description     : Default Target
    filesets        :
      - hdl
    toplevel        : sbi_GIC
    default_tool    : ghdl
    generate        :
      - gen_csr

  #---------------------------------------
  # Lint : -Wall analysis and elaboration (empty simulation)
  #---------------------------------------
  lint_ghdl : &lint_ghdl
    << : *default
    description     : Lint with GHDL (-Wall analysis and elaboration of sbi_GIC_wrapper)
    toplevel        : asylum.sbi_GIC_wrapper
    filesets_append : [syn]
    default_tool    : ghdl
    tools :
      ghdl :
        analyze_options : ["-Wall"]

  #---------------------------------------
  # Synthesis check : -Wall analysis, ghdl --synth -Wall and elaboration
  # (no simulation) of sbi_GIC_wrapper with the generics of the target.
  # The pre_run hook (ghdl_synth.sh of asylum:utils:ghdl_synth) adds
  # ghdl_synth.mk to the edalize Makefile.
  # FuseSoC merges tools in depth : analyze_options comes from lint_ghdl.
  #---------------------------------------
  lint_ghdl_synth_default : &lint_ghdl_synth
    << : *lint_ghdl
    description     : Synthesis check of sbi_GIC_wrapper, 8 lines without synchronizer (default generics)
    tools :
      ghdl :
        run_options     : ["--no-run"]
    hooks :
      pre_run : [ghdl_synth]

  #---------------------------------------
  lint_ghdl_synth_sync8 :
  #---------------------------------------
    << : *lint_ghdl_synth
    description     : Synthesis check of sbi_GIC_wrapper, 8 lines with synchronizer
    parameters      :
      - ITS_SYNC_ENABLE=11111111

  #---------------------------------------
  lint_ghdl_synth_mixed3 :
  #---------------------------------------
    << : *lint_ghdl_synth
    description     : Synthesis check of sbi_GIC_wrapper, 3 lines, mixed
    parameters      :
      - NB_LINES=3
      - ITS_SYNC_ENABLE=101

  #---------------------------------------
  lint_ghdl_synth_sync1 :
  #---------------------------------------
    << : *lint_ghdl_synth
    description     : Synthesis check of sbi_GIC_wrapper, 1 line with synchronizer
    parameters      :
      - NB_LINES=1
      - ITS_SYNC_ENABLE=1

  #---------------------------------------
  lint_ghdl_synth_it_ctrl :
  #---------------------------------------
    << : *lint_ghdl_synth
    description     : Synthesis check of it_ctrl (own top, not instantiated by sbi_GIC)
    toplevel        : asylum.it_ctrl

  #---------------------------------------
  # Synthesis : size of sbi_GIC_wrapper (or it_ctrl) with the generics of
  # the target, Xilinx Artix-7 (LUT, FF, BRAM, DSP) and sky130 (area), by
  # Yosys and its GHDL plugin. Same configurations as lint_ghdl_synth_*.
  # The pre_run hook (yosys_synth.sh of asylum:utils:yosys_synth) adds
  # yosys_synth.mk to the edalize Makefile.
  #---------------------------------------
  syn_default : &syn
    << : *lint_ghdl
    description     : Synthesis (Artix-7, sky130) of sbi_GIC_wrapper, 8 lines without synchronizer (default generics)
    filesets_append : [syn, syn_yosys]
    tools :
      ghdl :
        run_options     : ["--no-run"]
    hooks :
      pre_run : [yosys_synth]

  #---------------------------------------
  syn_sync8 :
  #---------------------------------------
    << : *syn
    description     : Synthesis (Artix-7, sky130) of sbi_GIC_wrapper, 8 lines with synchronizer
    parameters      :
      - ITS_SYNC_ENABLE=11111111

  #---------------------------------------
  syn_mixed3 :
  #---------------------------------------
    << : *syn
    description     : Synthesis (Artix-7, sky130) of sbi_GIC_wrapper, 3 lines, mixed
    parameters      :
      - NB_LINES=3
      - ITS_SYNC_ENABLE=101

  #---------------------------------------
  syn_sync1 :
  #---------------------------------------
    << : *syn
    description     : Synthesis (Artix-7, sky130) of sbi_GIC_wrapper, 1 line with synchronizer
    parameters      :
      - NB_LINES=1
      - ITS_SYNC_ENABLE=1

  #---------------------------------------
  syn_it_ctrl :
  #---------------------------------------
    << : *syn
    description     : Synthesis (Artix-7, sky130) of it_ctrl (own top, not instantiated by sbi_GIC)
    toplevel        : asylum.it_ctrl

  #---------------------------------------
  # tb_GIC : compiled once per configuration (NB_LINES, SYNC_MASK),
  # scenarios chosen at run time (TESTS_LIST, empty : build and
  # elaboration only).
  # Reference configuration 8_sync : sim_gic_8_sync (build only) and one
  # sim_gic_8_sync_<test> target per scenario ; the other configurations
  # run the whole list. Each target repeats the generics of its
  # configuration : FuseSoC replaces the parameters list of an inherited
  # target.
  #---------------------------------------
  sim_gic_8_sync: &sim_gic
    << : *default
    description     : Simulation of sbi_GIC with VIP - 8 lines, synchronizer on every line - build only (scenarios of TESTS_LIST)
    filesets_append :
      - sim
    toplevel        : tb_GIC
    parameters      :
      - TESTS_LIST
      - NB_LINES=8
      - SYNC_MASK=255
    default_tool    : ghdl
    tools :
      ghdl :
        analyze_options : ["-Wall","-fsynopsys","-frelaxed","--no-vital-checks"]
        run_options     : ["--fst=dut.fst","--ieee-asserts=disable"]

  #---------------------------------------
  sim_gic_8_sync_reset_values:
  #---------------------------------------
    << : *sim_gic
    description     : Simulation of sbi_GIC with VIP - 8 lines, synchronizer on every line - reset values of ISR, IMR and itm_o
    parameters      :
      - TESTS_LIST=reset_values
      - NB_LINES=8
      - SYNC_MASK=255

  #---------------------------------------
  sim_gic_8_sync_imr_rw:
  #---------------------------------------
    << : *sim_gic
    description     : Simulation of sbi_GIC with VIP - 8 lines, synchronizer on every line - IMR read / write
    parameters      :
      - TESTS_LIST=imr_rw
      - NB_LINES=8
      - SYNC_MASK=255

  #---------------------------------------
  sim_gic_8_sync_masked_latched:
  #---------------------------------------
    << : *sim_gic
    description     : Simulation of sbi_GIC with VIP - 8 lines, synchronizer on every line - masked lines latched in the ISR, itm_o stays 0
    parameters      :
      - TESTS_LIST=masked_latched
      - NB_LINES=8
      - SYNC_MASK=255

  #---------------------------------------
  sim_gic_8_sync_unmasked_itm:
  #---------------------------------------
    << : *sim_gic
    description     : Simulation of sbi_GIC with VIP - 8 lines, synchronizer on every line - only the unmasked line raises itm_o
    parameters      :
      - TESTS_LIST=unmasked_itm
      - NB_LINES=8
      - SYNC_MASK=255

  #---------------------------------------
  sim_gic_8_sync_latency_pulse:
  #---------------------------------------
    << : *sim_gic
    description     : Simulation of sbi_GIC with VIP - 8 lines, synchronizer on every line - latency its_i -> itm_o per line, 1-cycle pulse capture
    parameters      :
      - TESTS_LIST=latency_pulse
      - NB_LINES=8
      - SYNC_MASK=255

  #---------------------------------------
  sim_gic_8_sync_rw1c:
  #---------------------------------------
    << : *sim_gic
    description     : Simulation of sbi_GIC with VIP - 8 lines, synchronizer on every line - ISR write 1 clears, write 0 has no effect
    parameters      :
      - TESTS_LIST=rw1c
      - NB_LINES=8
      - SYNC_MASK=255

  #---------------------------------------
  sim_gic_8_sync_isr_set_again:
  #---------------------------------------
    << : *sim_gic
    description     : Simulation of sbi_GIC with VIP - 8 lines, synchronizer on every line - ISR bit set again while its source is active
    parameters      :
      - TESTS_LIST=isr_set_again
      - NB_LINES=8
      - SYNC_MASK=255

  #---------------------------------------
  sim_gic_8_sync_mask_pending:
  #---------------------------------------
    << : *sim_gic
    description     : Simulation of sbi_GIC with VIP - 8 lines, synchronizer on every line - masking pending lines drops itm_o, masked events kept
    parameters      :
      - TESTS_LIST=mask_pending
      - NB_LINES=8
      - SYNC_MASK=255

  #---------------------------------------
  sim_gic_8_sync_random:
  #---------------------------------------
    << : *sim_gic
    description     : Simulation of sbi_GIC with VIP - 8 lines, synchronizer on every line - random IMR / line patterns
    parameters      :
      - TESTS_LIST=random
      - NB_LINES=8
      - SYNC_MASK=255

  #---------------------------------------
  sim_gic_8_sync_async_reset:
  #---------------------------------------
    << : *sim_gic
    description     : Simulation of sbi_GIC with VIP - 8 lines, synchronizer on every line - asynchronous reset clears ISR and IMR
    parameters      :
      - TESTS_LIST=async_reset
      - NB_LINES=8
      - SYNC_MASK=255

  #---------------------------------------
  sim_gic_8_nosync:
  #---------------------------------------
    << : *sim_gic
    description     : Simulation of sbi_GIC with VIP - 8 lines, no synchronizer
    parameters      :
      - TESTS_LIST=reset_values,imr_rw,masked_latched,unmasked_itm,latency_pulse,rw1c,isr_set_again,mask_pending,random,async_reset
      - NB_LINES=8
      - SYNC_MASK=0

  #---------------------------------------
  sim_gic_3_mixed:
  #---------------------------------------
    << : *sim_gic
    description     : Simulation of sbi_GIC with VIP - 3 lines, synchronizer on lines 0 and 2
    parameters      :
      - TESTS_LIST=reset_values,imr_rw,masked_latched,unmasked_itm,latency_pulse,rw1c,isr_set_again,mask_pending,random,async_reset
      - NB_LINES=3
      - SYNC_MASK=5

  #---------------------------------------
  sim_gic_4_mixed:
  #---------------------------------------
    << : *sim_gic
    description     : Simulation of sbi_GIC with VIP - 4 lines, synchronizer on lines 0 and 1 (asymmetric mask)
    parameters      :
      - TESTS_LIST=reset_values,imr_rw,masked_latched,unmasked_itm,latency_pulse,rw1c,isr_set_again,mask_pending,random,async_reset
      - NB_LINES=4
      - SYNC_MASK=3

  #---------------------------------------
  sim_gic_1_sync:
  #---------------------------------------
    << : *sim_gic
    description     : Simulation of sbi_GIC with VIP - 1 line with synchronizer
    parameters      :
      - TESTS_LIST=reset_values,imr_rw,masked_latched,unmasked_itm,latency_pulse,rw1c,isr_set_again,mask_pending,random,async_reset
      - NB_LINES=1
      - SYNC_MASK=1

  #---------------------------------------
  # it_ctrl : compiled once, scenarios chosen at run time (TESTS_LIST),
  # empty list : build and elaboration only ;
  # one sim_it_ctrl_<test> target per scenario
  #---------------------------------------
  sim_it_ctrl: &sim_it_ctrl
    << : *default
    description     : Simulation of it_ctrl - build only (scenarios of TESTS_LIST)
    filesets_append :
      - sim_it_ctrl
    toplevel        : tb_it_ctrl
    parameters      :
      - TESTS_LIST
    default_tool    : ghdl
    tools :
      ghdl :
        analyze_options : ["-Wall","-fsynopsys","-frelaxed","--no-vital-checks"]
        run_options     : ["--fst=dut.fst","--ieee-asserts=disable"]

  #---------------------------------------
  sim_it_ctrl_edge:
  #---------------------------------------
    << : *sim_it_ctrl
    description     : Simulation of it_ctrl - rising edge latched until the acknowledge
    parameters      :
      - TESTS_LIST=edge

  #---------------------------------------
  sim_it_ctrl_edge_ack:
  #---------------------------------------
    << : *sim_it_ctrl
    description     : Simulation of it_ctrl - rising edge in the cycle of the acknowledge kept
    parameters      :
      - TESTS_LIST=edge_ack

#=========================================
scripts:
#=========================================

  #---------------------------------------
  # pre_run hook of lint_ghdl_synth_* (cwd = work_root)
  #---------------------------------------
  ghdl_synth :
    cmd : [bash, ghdl_synth.sh]

  #---------------------------------------
  # pre_run hook of syn_* (cwd = work_root)
  #---------------------------------------
  yosys_synth :
    cmd : [bash, yosys_synth.sh]

#=========================================
parameters :
#=========================================

  NB_LINES :
    description : Number of interrupt lines of the testbench (1 to 8)
    datatype    : int
    default     : 8
    paramtype   : generic

  SYNC_MASK :
    description : ITS_SYNC_ENABLE of the testbench, bit i = synchronizer on line i
    datatype    : int
    default     : 0
    paramtype   : generic

  TESTS_LIST :
    description : Scenarios run in sequence, separated by ',' (names in sim/gic/tb_GIC_tests_pkg.vhd, sim/it_ctrl/tb_it_ctrl_pkg.vhd), empty = build only
    datatype    : str
    default     : ""
    paramtype   : generic

  #---------------------------------------
  # Generics of sbi_GIC_wrapper (lint_ghdl_synth_*)
  #---------------------------------------
  ITS_SYNC_ENABLE :
    description : Synchronizer on interrupt line i (NB_LINES-bit string)
    datatype    : str
    default     : "00000000"
    paramtype   : generic

# Next lines is a pragma, don't modify
#<PROVIDER_BEGIN>
provider  :
  name    : github
  user    : deuskane
  repo    : asylum-system-gic
  version : asylum-system-GIC-2.0.0
 #version : cb97b8ae5fcdc3916111123cadb471c75453d132
#<PROVIDER_END>
