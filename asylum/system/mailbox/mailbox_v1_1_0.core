CAPI=2:

#-----------------------------------------------------------------------------
# Title      : mailbox Core file
# Project    : Asylum
#-----------------------------------------------------------------------------
# File       : mailbox.core
# Author     : mrosiere
#-----------------------------------------------------------------------------
# Description: 
#-----------------------------------------------------------------------------
# Copyright (c) 2025
#-----------------------------------------------------------------------------
# Revisions  :
# Date        Version  Author   Description
# 2026-05-25  1.0.0    mrosiere First Release
# 2026-06-06  1.0.1    mrosiere Add Name
# 2026-10-05  1.0.2    mrosiere Fix default target toplevel (sbi_mailbox), assert that a
#                               channel has a non-zero depth, add UVVM testbench
#                               (incl. single-word FIFOs, needs fifo >= 1.2.1)
# 2026-11-16  1.1.0    mrosiere Status registers status0 / status1 (one read wait
#                               state, generators >= 2.10.0), BLOCKING_READ /
#                               BLOCKING_WRITE, status outputs fifo_empty_o /
#                               fifo_full_o, check of the FIFO depths
#-----------------------------------------------------------------------------

name        : asylum:system:mailbox:1.1.0
description : mailbox Module

#=========================================
generate:
#=========================================

  #---------------------------------------
  gen_csr:
  #---------------------------------------
    generator : regtool
    parameters:
      file         : hdl/csr/mailbox.hjson
      name         : mailbox
      copy         : hdl/csr
      logical_name : asylum

#=========================================
filesets:
#=========================================

  #---------------------------------------
  hdl:
  #---------------------------------------
    files        :
      - hdl/mailbox_pkg.vhd
      - hdl/sbi_mailbox.vhd
    file_type    : vhdlSource
    logical_name : asylum
    depend       :
      - ">=asylum:utils:generators:2.10.0"
      - asylum:utils:pkg

  #---------------------------------------
  sim:
  #---------------------------------------
    files:
      - sim/mailbox/tb_mailbox_bfm_pkg.vhd
      - sim/mailbox/tb_mailbox_reset_values_pkg.vhd
      - sim/mailbox/tb_mailbox_fill_pkg.vhd
      - sim/mailbox/tb_mailbox_write_read_pkg.vhd
      - sim/mailbox/tb_mailbox_random_pkg.vhd
      - sim/mailbox/tb_mailbox_independent_pkg.vhd
      - sim/mailbox/tb_mailbox_status_write_pkg.vhd
      - sim/mailbox/tb_mailbox_async_reset_pkg.vhd
      - sim/mailbox/tb_mailbox_tests_pkg.vhd
      - sim/mailbox/tb_mailbox.vhd
    file_type : vhdlSource-2008
    depend       :
      - bitvis:verification:uvvm
      # string_pkg list_length / list_item / list_contains (TESTS_LIST)
      - ">=asylum:utils:pkg:1.10.0"

  #---------------------------------------
  syn:
  #---------------------------------------
    files        :
      - syn/sbi_mailbox_wrapper.vhd
    file_type    : vhdlSource-2008
    logical_name : asylum
    # ghdl_synth.sh / ghdl_synth.mk (pre_run hook of lint_ghdl_synth_*)
    depend       :
      - asylum:utils:ghdl_synth

  #---------------------------------------
  syn_yosys:
  #---------------------------------------
    # yosys_synth.sh / yosys_synth.mk / yosys_synth.py (pre_run hook of syn_*)
    depend       :
      - asylum:utils:yosys_synth

#=========================================
targets:
#=========================================

  #---------------------------------------
  default: &default
  #---------------------------------------
    description     : Default Target
    filesets        :
      - hdl
    toplevel        : sbi_mailbox
    default_tool    : ghdl
    generate        :
      - gen_csr

  #---------------------------------------
  # Lint : -Wall analysis and elaboration (empty simulation)
  #---------------------------------------
  lint_ghdl : &lint_ghdl
    << : *default
    description     : Lint with GHDL (-Wall analysis and elaboration of sbi_mailbox_wrapper)
    toplevel        : asylum.sbi_mailbox_wrapper
    filesets_append : [syn]
    default_tool    : ghdl
    tools :
      ghdl :
        analyze_options : ["-Wall"]

  #---------------------------------------
  # Synthesis check : -Wall analysis, ghdl --synth -Wall and elaboration
  # (no simulation) of sbi_mailbox_wrapper with the generics of the target.
  # The pre_run hook (ghdl_synth.sh of asylum:utils:ghdl_synth) adds
  # ghdl_synth.mk to the edalize Makefile.
  # FuseSoC merges tools in depth : analyze_options comes from lint_ghdl.
  #---------------------------------------
  lint_ghdl_synth_default : &lint_ghdl_synth
    << : *lint_ghdl
    description     : Synthesis check of sbi_mailbox_wrapper, FIFO depths 4/4/4/4 (PicoSoC)
    tools :
      ghdl :
        run_options     : ["--no-run"]
    hooks :
      pre_run : [ghdl_synth]

  #---------------------------------------
  lint_ghdl_synth_depth0 :
  #---------------------------------------
    << : *lint_ghdl_synth
    description     : Synthesis check of sbi_mailbox_wrapper, FIFO depths 0/4/2/0
    parameters      :
      - FIFO0_DEPTH_TX=0
      - FIFO0_DEPTH_RX=4
      - FIFO1_DEPTH_TX=2
      - FIFO1_DEPTH_RX=0

  #---------------------------------------
  lint_ghdl_synth_depth2_8 :
  #---------------------------------------
    << : *lint_ghdl_synth
    description     : Synthesis check of sbi_mailbox_wrapper, FIFO depths 2/2/8/2
    parameters      :
      - FIFO0_DEPTH_TX=2
      - FIFO0_DEPTH_RX=2
      - FIFO1_DEPTH_TX=8
      - FIFO1_DEPTH_RX=2

  #---------------------------------------
  lint_ghdl_synth_depth1 :
  #---------------------------------------
    << : *lint_ghdl_synth
    description     : Synthesis check of sbi_mailbox_wrapper, FIFO depths 1/1/1/0
    parameters      :
      - FIFO0_DEPTH_TX=1
      - FIFO0_DEPTH_RX=1
      - FIFO1_DEPTH_TX=1
      - FIFO1_DEPTH_RX=0

  #---------------------------------------
  # Synthesis : size of sbi_mailbox_wrapper with the generics of the
  # target, Xilinx Artix-7 (LUT, FF, BRAM, DSP) and sky130 (area), by Yosys
  # and its GHDL plugin. Same configurations as lint_ghdl_synth_*.
  # The pre_run hook (yosys_synth.sh of asylum:utils:yosys_synth) adds
  # yosys_synth.mk to the edalize Makefile.
  #---------------------------------------
  syn_default : &syn
    << : *lint_ghdl
    description     : Synthesis (Artix-7, sky130) of sbi_mailbox_wrapper, FIFO depths 4/4/4/4 (PicoSoC)
    filesets_append : [syn, syn_yosys]
    tools :
      ghdl :
        run_options     : ["--no-run"]
    hooks :
      pre_run : [yosys_synth]

  #---------------------------------------
  syn_depth0 :
  #---------------------------------------
    << : *syn
    description     : Synthesis (Artix-7, sky130) of sbi_mailbox_wrapper, FIFO depths 0/4/2/0
    parameters      :
      - FIFO0_DEPTH_TX=0
      - FIFO0_DEPTH_RX=4
      - FIFO1_DEPTH_TX=2
      - FIFO1_DEPTH_RX=0

  #---------------------------------------
  syn_depth2_8 :
  #---------------------------------------
    << : *syn
    description     : Synthesis (Artix-7, sky130) of sbi_mailbox_wrapper, FIFO depths 2/2/8/2
    parameters      :
      - FIFO0_DEPTH_TX=2
      - FIFO0_DEPTH_RX=2
      - FIFO1_DEPTH_TX=8
      - FIFO1_DEPTH_RX=2

  #---------------------------------------
  syn_depth1 :
  #---------------------------------------
    << : *syn
    description     : Synthesis (Artix-7, sky130) of sbi_mailbox_wrapper, FIFO depths 1/1/1/0
    parameters      :
      - FIFO0_DEPTH_TX=1
      - FIFO0_DEPTH_RX=1
      - FIFO1_DEPTH_TX=1
      - FIFO1_DEPTH_RX=0

  #---------------------------------------
  # tb_mailbox (sim/mailbox) : compiled once per configuration (FIFO
  # depths, BLOCKING_READ, BLOCKING_WRITE), scenarios chosen at run time
  # (TESTS_LIST, empty : build and elaboration only).
  # Reference configuration : FIFO depths 4/4/4/4 (PicoSoC) :
  # sim_mailbox_4_4 (build only) and one sim_mailbox_4_4_<test> target
  # per scenario ; the other configurations run the whole list. Each
  # target repeats the generics of its configuration : FuseSoC replaces
  # the parameters list of an inherited target.
  #---------------------------------------
  sim_mailbox_4_4: &sim_mailbox
  #---------------------------------------
    << : *default
    description     : Simulation of sbi_mailbox (UVVM) - FIFO0 TX 4 / RX 4, FIFO1 TX 4 / RX 4 (PicoSoC configuration), build only (scenarios of TESTS_LIST)
    filesets_append :
      - sim
    toplevel        : tb_mailbox
    parameters      :
      - TESTS_LIST
      - FIFO0_DEPTH_TX=4
      - FIFO0_DEPTH_RX=4
      - FIFO1_DEPTH_TX=4
      - FIFO1_DEPTH_RX=4
    default_tool    : ghdl
    tools :
      ghdl :
        analyze_options :
          - "$(GHDL_ANALYZE_OPTION)"
          - "-Wall"
          - "-frelaxed"
        run_options     :
          - "$(GHDL_RUN_OPTION)"
          - "--ieee-asserts=disable"

  #---------------------------------------
  sim_mailbox_4_4_reset_values:
  #---------------------------------------
    << : *sim_mailbox
    description     : Simulation of sbi_mailbox (UVVM) - FIFO depths 4/4/4/4, empty channels after reset, status registers and outputs, read of an empty channel
    parameters      :
      - TESTS_LIST=reset_values
      - FIFO0_DEPTH_TX=4
      - FIFO0_DEPTH_RX=4
      - FIFO1_DEPTH_TX=4
      - FIFO1_DEPTH_RX=4

  #---------------------------------------
  sim_mailbox_4_4_fill:
  #---------------------------------------
    << : *sim_mailbox
    description     : Simulation of sbi_mailbox (UVVM) - FIFO depths 4/4/4/4, fill each channel, write in the full channel, read back in order, status after each access
    parameters      :
      - TESTS_LIST=fill
      - FIFO0_DEPTH_TX=4
      - FIFO0_DEPTH_RX=4
      - FIFO1_DEPTH_TX=4
      - FIFO1_DEPTH_RX=4

  #---------------------------------------
  sim_mailbox_4_4_write_read:
  #---------------------------------------
    << : *sim_mailbox
    description     : Simulation of sbi_mailbox (UVVM) - FIFO depths 4/4/4/4, read of each byte just after its write
    parameters      :
      - TESTS_LIST=write_read
      - FIFO0_DEPTH_TX=4
      - FIFO0_DEPTH_RX=4
      - FIFO1_DEPTH_TX=4
      - FIFO1_DEPTH_RX=4

  #---------------------------------------
  sim_mailbox_4_4_random:
  #---------------------------------------
    << : *sim_mailbox
    description     : Simulation of sbi_mailbox (UVVM) - FIFO depths 4/4/4/4, random writes and reads in each channel
    parameters      :
      - TESTS_LIST=random
      - FIFO0_DEPTH_TX=4
      - FIFO0_DEPTH_RX=4
      - FIFO1_DEPTH_TX=4
      - FIFO1_DEPTH_RX=4

  #---------------------------------------
  sim_mailbox_4_4_independent:
  #---------------------------------------
    << : *sim_mailbox
    description     : Simulation of sbi_mailbox (UVVM) - FIFO depths 4/4/4/4, fifo0 full while fifo1 is used, status of both
    parameters      :
      - TESTS_LIST=independent
      - FIFO0_DEPTH_TX=4
      - FIFO0_DEPTH_RX=4
      - FIFO1_DEPTH_TX=4
      - FIFO1_DEPTH_RX=4

  #---------------------------------------
  sim_mailbox_4_4_status_write:
  #---------------------------------------
    << : *sim_mailbox
    description     : Simulation of sbi_mailbox (UVVM) - FIFO depths 4/4/4/4, writes of the read only status registers
    parameters      :
      - TESTS_LIST=status_write
      - FIFO0_DEPTH_TX=4
      - FIFO0_DEPTH_RX=4
      - FIFO1_DEPTH_TX=4
      - FIFO1_DEPTH_RX=4

  #---------------------------------------
  sim_mailbox_4_4_async_reset:
  #---------------------------------------
    << : *sim_mailbox
    description     : Simulation of sbi_mailbox (UVVM) - FIFO depths 4/4/4/4, asynchronous reset of full channels
    parameters      :
      - TESTS_LIST=async_reset
      - FIFO0_DEPTH_TX=4
      - FIFO0_DEPTH_RX=4
      - FIFO1_DEPTH_TX=4
      - FIFO1_DEPTH_RX=4

  #---------------------------------------
  sim_mailbox_depth0:
  #---------------------------------------
    << : *sim_mailbox
    description     : Simulation of sbi_mailbox (UVVM) - FIFO0 TX 0 / RX 4, FIFO1 TX 2 / RX 0 (one FIFO bypassed per channel), every scenario
    parameters      :
      - TESTS_LIST=reset_values,fill,write_read,random,independent,status_write,async_reset
      - FIFO0_DEPTH_TX=0
      - FIFO0_DEPTH_RX=4
      - FIFO1_DEPTH_TX=2
      - FIFO1_DEPTH_RX=0

  #---------------------------------------
  sim_mailbox_2_8:
  #---------------------------------------
    << : *sim_mailbox
    description     : Simulation of sbi_mailbox (UVVM) - FIFO0 TX 2 / RX 2, FIFO1 TX 8 / RX 2, every scenario
    parameters      :
      - TESTS_LIST=reset_values,fill,write_read,random,independent,status_write,async_reset
      - FIFO0_DEPTH_TX=2
      - FIFO0_DEPTH_RX=2
      - FIFO1_DEPTH_TX=8
      - FIFO1_DEPTH_RX=2

  #---------------------------------------
  sim_mailbox_depth1:
  #---------------------------------------
    << : *sim_mailbox
    description     : Simulation of sbi_mailbox (UVVM) - FIFO0 TX 1 / RX 1, FIFO1 TX 1 / RX 0 (single-word FIFOs), every scenario
    parameters      :
      - TESTS_LIST=reset_values,fill,write_read,random,independent,status_write,async_reset
      - FIFO0_DEPTH_TX=1
      - FIFO0_DEPTH_RX=1
      - FIFO1_DEPTH_TX=1
      - FIFO1_DEPTH_RX=0

  #---------------------------------------
  sim_mailbox_nonblocking:
  #---------------------------------------
    << : *sim_mailbox
    description     : Simulation of sbi_mailbox (UVVM) - non blocking accesses, FIFO0 TX 4 / RX 0, FIFO1 TX 0 / RX 2, every scenario
    parameters      :
      - TESTS_LIST=reset_values,fill,write_read,random,independent,status_write,async_reset
      - FIFO0_DEPTH_TX=4
      - FIFO0_DEPTH_RX=0
      - FIFO1_DEPTH_TX=0
      - FIFO1_DEPTH_RX=2
      - BLOCKING_READ=false
      - BLOCKING_WRITE=false

  #---------------------------------------
  sim_mailbox_nonblocking_write:
  #---------------------------------------
    << : *sim_mailbox
    description     : Simulation of sbi_mailbox (UVVM) - blocking read, non blocking write, FIFO depths 4/4/4/4, every scenario
    parameters      :
      - TESTS_LIST=reset_values,fill,write_read,random,independent,status_write,async_reset
      - FIFO0_DEPTH_TX=4
      - FIFO0_DEPTH_RX=4
      - FIFO1_DEPTH_TX=4
      - FIFO1_DEPTH_RX=4
      - BLOCKING_READ=true
      - BLOCKING_WRITE=false

#=========================================
scripts:
#=========================================

  #---------------------------------------
  # pre_run hook of lint_ghdl_synth_* (cwd = work_root)
  #---------------------------------------
  ghdl_synth :
    cmd : [bash, ghdl_synth.sh]

  #---------------------------------------
  # pre_run hook of syn_* (cwd = work_root)
  #---------------------------------------
  yosys_synth :
    cmd : [bash, yosys_synth.sh]

#=========================================
parameters :
#=========================================

  TESTS_LIST :
    description : Scenarios run in sequence, separated by ',' (names in sim/mailbox/tb_mailbox_tests_pkg.vhd), empty = build only
    datatype    : str
    default     : ""
    paramtype   : generic

  FIFO0_DEPTH_TX :
    description : FIFO0 Depth of FIFO TX (SW2HW)
    datatype    : int
    default     : 4
    paramtype   : generic

  FIFO0_DEPTH_RX :
    description : FIFO0 Depth of FIFO RX (HW2SW)
    datatype    : int
    default     : 4
    paramtype   : generic

  FIFO1_DEPTH_TX :
    description : FIFO1 Depth of FIFO TX (SW2HW)
    datatype    : int
    default     : 4
    paramtype   : generic

  FIFO1_DEPTH_RX :
    description : FIFO1 Depth of FIFO RX (HW2SW)
    datatype    : int
    default     : 4
    paramtype   : generic

  BLOCKING_READ :
    description : A read of an empty channel waits for a data (true) or completes at once (false)
    datatype    : bool
    default     : true
    paramtype   : generic

  BLOCKING_WRITE :
    description : A write in a full channel waits for a free slot (true) or completes at once, data dropped (false)
    datatype    : bool
    default     : true
    paramtype   : generic

# Next lines is a pragma, don't modify
#<PROVIDER_BEGIN>
provider  :
  name    : github
  user    : deuskane
  repo    : asylum-system-mailbox
  version : asylum-system-mailbox-1.1.0
 #version : 610110b161c232bca9aa553debf519177c8f1ca7
#<PROVIDER_END>
