CAPI=2:

#-----------------------------------------------------------------------------
# Title      : PWM Core file
# Project    : Asylum
#-----------------------------------------------------------------------------
# File       : PWM.core
# Author     : mrosiere
#-----------------------------------------------------------------------------
# Description: PWM with CSR access over the SBI bus
#-----------------------------------------------------------------------------
# Copyright (c) 2026
#-----------------------------------------------------------------------------
# Revisions  :
# Date        Version  Author   Description
# 2026-10-22  1.0.0    mrosiere First Release
#-----------------------------------------------------------------------------

name        : asylum:component:PWM:1.0.0
description : PWM Module

#=========================================
generate:
#=========================================

  #---------------------------------------
  gen_csr:
  #---------------------------------------
    generator : regtool
    parameters:
      file         : hdl/csr/PWM.hjson
      name         : PWM
      copy         : hdl/csr
      logical_name : asylum

#=========================================
filesets:
#=========================================

  #---------------------------------------
  hdl:
  #---------------------------------------
    files        :
      - hdl/pwm_pkg.vhd
      - hdl/pwm_core.vhd
      - hdl/sbi_PWM.vhd
    file_type    : vhdlSource
    logical_name : asylum
    depend       :
      - ">=asylum:component:clock_divider:2.1.0"
      - asylum:utils:generators
      - asylum:utils:pkg

  #---------------------------------------
  # Testbench helpers shared by tb_PWM and tb_pwm_core
  #---------------------------------------
  sim_common:
    files        :
      - sim/common/tb_PWM_bfm_pkg.vhd
    file_type    : vhdlSource-2008
    depend       :
      - bitvis:verification:uvvm
      # string_pkg list_length / list_item / list_contains (TESTS_LIST)
      - ">=asylum:utils:pkg:1.10.0"

  #---------------------------------------
  sim_pwm:
  #---------------------------------------
    files        :
      - sim/pwm/tb_PWM_reset_values_pkg.vhd
      - sim/pwm/tb_PWM_registers_pkg.vhd
      - sim/pwm/tb_PWM_disabled_pkg.vhd
      - sim/pwm/tb_PWM_no_prescaler_pkg.vhd
      - sim/pwm/tb_PWM_prescaler_pkg.vhd
      - sim/pwm/tb_PWM_duty_pkg.vhd
      - sim/pwm/tb_PWM_period_0_pkg.vhd
      - sim/pwm/tb_PWM_update_duty_pkg.vhd
      - sim/pwm/tb_PWM_update_period_pkg.vhd
      - sim/pwm/tb_PWM_update_prescaler_pkg.vhd
      - sim/pwm/tb_PWM_disable_enable_pkg.vhd
      - sim/pwm/tb_PWM_frequency_pkg.vhd
      - sim/pwm/tb_PWM_servo_pkg.vhd
      - sim/pwm/tb_PWM_async_reset_pkg.vhd
      - sim/pwm/tb_PWM_tests_pkg.vhd
      - sim/pwm/tb_PWM.vhd
    file_type    : vhdlSource-2008
    depend       :
      - bitvis:verification:uvvm

  #---------------------------------------
  sim_pwm_core:
  #---------------------------------------
    files        :
      - sim/pwm_core/tb_pwm_core_bfm_pkg.vhd
      - sim/pwm_core/tb_pwm_core_prescaler_pkg.vhd
      - sim/pwm_core/tb_pwm_core_full_period_pkg.vhd
      - sim/pwm_core/tb_pwm_core_update_duty_pkg.vhd
      - sim/pwm_core/tb_pwm_core_always_high_pkg.vhd
      - sim/pwm_core/tb_pwm_core_tests_pkg.vhd
      - sim/pwm_core/tb_pwm_core.vhd
    file_type    : vhdlSource-2008
    depend       :
      - bitvis:verification:uvvm

  #---------------------------------------
  syn:
  #---------------------------------------
    files        :
      - syn/sbi_PWM_wrapper.vhd
    file_type    : vhdlSource-2008
    logical_name : asylum
    # ghdl_synth.sh / ghdl_synth.mk (pre_run hook of lint_ghdl_synth_*)
    depend       :
      - asylum:utils:ghdl_synth

  #---------------------------------------
  syn_yosys:
  #---------------------------------------
    # yosys_synth.sh / yosys_synth.mk / yosys_synth.py (pre_run hook of syn_*)
    depend       :
      - asylum:utils:yosys_synth

#=========================================
targets:
#=========================================

  #---------------------------------------
  default: &default
  #---------------------------------------
    description     : Default Target
    filesets        :
      - hdl
    toplevel        : sbi_PWM
    default_tool    : ghdl
    generate        :
      - gen_csr

  #---------------------------------------
  # Lint : -Wall analysis and elaboration (empty simulation)
  #---------------------------------------
  lint_ghdl : &lint_ghdl
    << : *default
    description     : Lint with GHDL (-Wall analysis and elaboration of sbi_PWM_wrapper)
    toplevel        : asylum.sbi_PWM_wrapper
    filesets_append : [syn]
    default_tool    : ghdl
    tools :
      ghdl :
        analyze_options : ["-Wall"]

  #---------------------------------------
  # Synthesis check : -Wall analysis, ghdl --synth -Wall and elaboration
  # (no simulation) of sbi_PWM_wrapper with the generics of the target.
  # The pre_run hook (ghdl_synth.sh of asylum:utils:ghdl_synth) adds
  # ghdl_synth.mk to the edalize Makefile.
  # FuseSoC merges tools in depth : analyze_options comes from lint_ghdl.
  #---------------------------------------
  lint_ghdl_synth_default : &lint_ghdl_synth
    << : *lint_ghdl
    description     : Synthesis check of sbi_PWM_wrapper, default generics (also the generics of sim_pwm)
    tools :
      ghdl :
        run_options     : ["--no-run"]
    hooks :
      pre_run : [ghdl_synth]

  #---------------------------------------
  lint_ghdl_synth_fixed_prescaler :
  #---------------------------------------
    << : *lint_ghdl_synth
    description     : Synthesis check of sbi_PWM_wrapper, fixed prescaler (generics of sim_pwm_fixed_prescaler)
    parameters      :
      - USER_DEFINE_PRESCALER=false
      - PRESCALER_RATIO=00000010

  #---------------------------------------
  lint_ghdl_synth_static_prescaler :
  #---------------------------------------
    << : *lint_ghdl_synth
    description     : Synthesis check of sbi_PWM_wrapper, static prescaler (generics of sim_pwm_static_prescaler)
    parameters      :
      - STATIC_PRESCALER_RATIO=20

  #---------------------------------------
  # Synthesis : size of sbi_PWM_wrapper with the generics of the target,
  # Xilinx Artix-7 (LUT, FF, BRAM, DSP) and sky130 (area), by Yosys and
  # its GHDL plugin. Same configurations as lint_ghdl_synth_*.
  # The pre_run hook (yosys_synth.sh of asylum:utils:yosys_synth) adds
  # yosys_synth.mk to the edalize Makefile.
  #---------------------------------------
  syn_default : &syn
    << : *lint_ghdl
    description     : Synthesis (Artix-7, sky130) of sbi_PWM_wrapper, default generics (also the generics of sim_pwm)
    filesets_append : [syn, syn_yosys]
    tools :
      ghdl :
        run_options     : ["--no-run"]
    hooks :
      pre_run : [yosys_synth]

  #---------------------------------------
  syn_fixed_prescaler :
  #---------------------------------------
    << : *syn
    description     : Synthesis (Artix-7, sky130) of sbi_PWM_wrapper, fixed prescaler (generics of sim_pwm_fixed_prescaler)
    parameters      :
      - USER_DEFINE_PRESCALER=false
      - PRESCALER_RATIO=00000010

  #---------------------------------------
  syn_static_prescaler :
  #---------------------------------------
    << : *syn
    description     : Synthesis (Artix-7, sky130) of sbi_PWM_wrapper, static prescaler (generics of sim_pwm_static_prescaler)
    parameters      :
      - STATIC_PRESCALER_RATIO=20

  #---------------------------------------
  # tb_PWM (sim/pwm) : compiled once per configuration
  # (STATIC_PRESCALER_RATIO, USER_DEFINE_PRESCALER, PRESCALER_RATIO),
  # scenarios chosen at run time (TESTS_LIST, empty : build and
  # elaboration only). Reference configuration : default generics of
  # sbi_PWM : sim_pwm (build only) and one sim_pwm_<test> target per
  # scenario ; sim_pwm_fixed_prescaler and sim_pwm_static_prescaler run
  # the list of their scenarios. Each target repeats the generics of its
  # configuration : FuseSoC replaces the parameters list of an inherited
  # target.
  #---------------------------------------
  #---------------------------------------
  sim_pwm: &sim_pwm
  #---------------------------------------
    << : *default
    description     : Simulation of sbi_PWM (UVVM) - build only (scenarios of TESTS_LIST)
    filesets_append :
      - sim_common
      - sim_pwm
    toplevel        : tb_PWM
    parameters      :
      - TESTS_LIST
      - STATIC_PRESCALER_RATIO=1
      - USER_DEFINE_PRESCALER=true
      - PRESCALER_RATIO=11000010
    default_tool    : ghdl
    tools :
      ghdl :
        analyze_options :
          - "$(GHDL_ANALYZE_OPTION)"
          - "-Wall"
          - "-frelaxed"
        run_options     :
          - "$(GHDL_RUN_OPTION)"
          - "--ieee-asserts=disable"

  #---------------------------------------
  sim_pwm_reset_values:
  #---------------------------------------
    << : *sim_pwm
    description     : Simulation of sbi_PWM (UVVM) - reset values of the registers and of pwm_o
    parameters      :
      - TESTS_LIST=reset_values
      - STATIC_PRESCALER_RATIO=1
      - USER_DEFINE_PRESCALER=true
      - PRESCALER_RATIO=11000010

  #---------------------------------------
  sim_pwm_registers:
  #---------------------------------------
    << : *sim_pwm
    description     : Simulation of sbi_PWM (UVVM) - read and write of the registers
    parameters      :
      - TESTS_LIST=registers
      - STATIC_PRESCALER_RATIO=1
      - USER_DEFINE_PRESCALER=true
      - PRESCALER_RATIO=11000010

  #---------------------------------------
  sim_pwm_disabled:
  #---------------------------------------
    << : *sim_pwm
    description     : Simulation of sbi_PWM (UVVM) - pwm_o low while the PWM is disabled
    parameters      :
      - TESTS_LIST=disabled
      - STATIC_PRESCALER_RATIO=1
      - USER_DEFINE_PRESCALER=true
      - PRESCALER_RATIO=11000010

  #---------------------------------------
  sim_pwm_no_prescaler:
  #---------------------------------------
    << : *sim_pwm
    description     : Simulation of sbi_PWM (UVVM) - start latency and timing with prescaler 0
    parameters      :
      - TESTS_LIST=no_prescaler
      - STATIC_PRESCALER_RATIO=1
      - USER_DEFINE_PRESCALER=true
      - PRESCALER_RATIO=11000010

  #---------------------------------------
  sim_pwm_prescaler:
  #---------------------------------------
    << : *sim_pwm
    description     : Simulation of sbi_PWM (UVVM) - start latency and timing with prescaler 4
    parameters      :
      - TESTS_LIST=prescaler
      - STATIC_PRESCALER_RATIO=1
      - USER_DEFINE_PRESCALER=true
      - PRESCALER_RATIO=11000010

  #---------------------------------------
  sim_pwm_duty:
  #---------------------------------------
    << : *sim_pwm
    description     : Simulation of sbi_PWM (UVVM) - duty 0, 1, period, period+1 and 255
    parameters      :
      - TESTS_LIST=duty
      - STATIC_PRESCALER_RATIO=1
      - USER_DEFINE_PRESCALER=true
      - PRESCALER_RATIO=11000010

  #---------------------------------------
  sim_pwm_period_0:
  #---------------------------------------
    << : *sim_pwm
    description     : Simulation of sbi_PWM (UVVM) - PWM period of one tick
    parameters      :
      - TESTS_LIST=period_0
      - STATIC_PRESCALER_RATIO=1
      - USER_DEFINE_PRESCALER=true
      - PRESCALER_RATIO=11000010

  #---------------------------------------
  sim_pwm_update_duty:
  #---------------------------------------
    << : *sim_pwm
    description     : Simulation of sbi_PWM (UVVM) - duty changed during a period, taken into account at the next one
    parameters      :
      - TESTS_LIST=update_duty
      - STATIC_PRESCALER_RATIO=1
      - USER_DEFINE_PRESCALER=true
      - PRESCALER_RATIO=11000010

  #---------------------------------------
  sim_pwm_update_period:
  #---------------------------------------
    << : *sim_pwm
    description     : Simulation of sbi_PWM (UVVM) - period changed during a period (increased, decreased below the counter)
    parameters      :
      - TESTS_LIST=update_period
      - STATIC_PRESCALER_RATIO=1
      - USER_DEFINE_PRESCALER=true
      - PRESCALER_RATIO=11000010

  #---------------------------------------
  sim_pwm_update_prescaler:
  #---------------------------------------
    << : *sim_pwm
    description     : Simulation of sbi_PWM (UVVM) - prescaler changed during a period, taken into account at the next one
    parameters      :
      - TESTS_LIST=update_prescaler
      - STATIC_PRESCALER_RATIO=1
      - USER_DEFINE_PRESCALER=true
      - PRESCALER_RATIO=11000010

  #---------------------------------------
  sim_pwm_disable_enable:
  #---------------------------------------
    << : *sim_pwm
    description     : Simulation of sbi_PWM (UVVM) - disable during the high and the low phase then enable
    parameters      :
      - TESTS_LIST=disable_enable
      - STATIC_PRESCALER_RATIO=1
      - USER_DEFINE_PRESCALER=true
      - PRESCALER_RATIO=11000010

  #---------------------------------------
  sim_pwm_frequency:
  #---------------------------------------
    << : *sim_pwm
    description     : Simulation of sbi_PWM (UVVM) - reset values of prescaler and period (1 kHz with a 50 MHz clock)
    parameters      :
      - TESTS_LIST=frequency
      - STATIC_PRESCALER_RATIO=1
      - USER_DEFINE_PRESCALER=true
      - PRESCALER_RATIO=11000010

  #---------------------------------------
  sim_pwm_servo:
  #---------------------------------------
    << : *sim_pwm
    description     : Simulation of sbi_PWM (UVVM) - prescaler 249, period 199, duty 15 (servo pulse)
    parameters      :
      - TESTS_LIST=servo
      - STATIC_PRESCALER_RATIO=1
      - USER_DEFINE_PRESCALER=true
      - PRESCALER_RATIO=11000010

  #---------------------------------------
  sim_pwm_async_reset:
  #---------------------------------------
    << : *sim_pwm
    description     : Simulation of sbi_PWM (UVVM) - asynchronous reset while running
    parameters      :
      - TESTS_LIST=async_reset
      - STATIC_PRESCALER_RATIO=1
      - USER_DEFINE_PRESCALER=true
      - PRESCALER_RATIO=11000010

  #---------------------------------------
  sim_pwm_fixed_prescaler:
  #---------------------------------------
    << : *sim_pwm
    description     : Simulation of sbi_PWM (UVVM) - fixed prescaler 2 (no prescaler register), every scenario but update_prescaler
    parameters      :
      - TESTS_LIST=reset_values,registers,disabled,no_prescaler,prescaler,duty,period_0,update_duty,update_period,disable_enable,frequency,servo,async_reset
      - STATIC_PRESCALER_RATIO=1
      - USER_DEFINE_PRESCALER=false
      - PRESCALER_RATIO=00000010

  #---------------------------------------
  sim_pwm_static_prescaler:
  #---------------------------------------
    << : *sim_pwm
    description     : Simulation of sbi_PWM (UVVM) - static prescaler 20 (servo 50 Hz), every scenario
    parameters      :
      - TESTS_LIST=reset_values,registers,disabled,no_prescaler,prescaler,duty,period_0,update_duty,update_period,update_prescaler,disable_enable,frequency,servo,async_reset
      - STATIC_PRESCALER_RATIO=20
      - USER_DEFINE_PRESCALER=true
      - PRESCALER_RATIO=11000010

  #---------------------------------------
  # tb_pwm_core (sim/pwm_core) : pwm_core alone, one configuration
  # (4-bit prescaler, 12-bit counter) : sim_pwm_core (build only) and one
  # sim_pwm_core_<test> target per scenario
  #---------------------------------------
  #---------------------------------------
  sim_pwm_core: &sim_pwm_core
  #---------------------------------------
    << : *default
    description     : Simulation of pwm_core alone (UVVM), 4-bit prescaler, 12-bit counter - build only (scenarios of TESTS_LIST)
    filesets_append :
      - sim_common
      - sim_pwm_core
    toplevel        : tb_pwm_core
    parameters      :
      - TESTS_LIST
      - PRESCALER_WIDTH=4
      - COUNTER_WIDTH=12
    default_tool    : ghdl
    tools :
      ghdl :
        analyze_options :
          - "$(GHDL_ANALYZE_OPTION)"
          - "-Wall"
          - "-frelaxed"
        run_options     :
          - "$(GHDL_RUN_OPTION)"
          - "--ieee-asserts=disable"

  #---------------------------------------
  sim_pwm_core_prescaler:
  #---------------------------------------
    << : *sim_pwm_core
    description     : Simulation of pwm_core alone (UVVM), 4-bit prescaler, 12-bit counter - maximum prescaler ratio, period 1000 ticks
    parameters      :
      - TESTS_LIST=prescaler
      - PRESCALER_WIDTH=4
      - COUNTER_WIDTH=12

  #---------------------------------------
  sim_pwm_core_full_period:
  #---------------------------------------
    << : *sim_pwm_core
    description     : Simulation of pwm_core alone (UVVM), 4-bit prescaler, 12-bit counter - maximum period (4096 ticks)
    parameters      :
      - TESTS_LIST=full_period
      - PRESCALER_WIDTH=4
      - COUNTER_WIDTH=12

  #---------------------------------------
  sim_pwm_core_update_duty:
  #---------------------------------------
    << : *sim_pwm_core
    description     : Simulation of pwm_core alone (UVVM), 4-bit prescaler, 12-bit counter - maximum duty written while running
    parameters      :
      - TESTS_LIST=update_duty
      - PRESCALER_WIDTH=4
      - COUNTER_WIDTH=12

  #---------------------------------------
  sim_pwm_core_always_high:
  #---------------------------------------
    << : *sim_pwm_core
    description     : Simulation of pwm_core alone (UVVM), 4-bit prescaler, 12-bit counter - duty greater than period
    parameters      :
      - TESTS_LIST=always_high
      - PRESCALER_WIDTH=4
      - COUNTER_WIDTH=12

#=========================================
scripts:
#=========================================

  #---------------------------------------
  # pre_run hook of lint_ghdl_synth_* (cwd = work_root)
  #---------------------------------------
  ghdl_synth :
    cmd : [bash, ghdl_synth.sh]

  #---------------------------------------
  # pre_run hook of syn_* (cwd = work_root)
  #---------------------------------------
  yosys_synth :
    cmd : [bash, yosys_synth.sh]

#=========================================
parameters :
#=========================================

  #---------------------------------------
  # Scenarios of tb_PWM and tb_pwm_core (sim_*)
  #---------------------------------------
  TESTS_LIST :
    description : Scenarios run in sequence, separated by ',' (names in sim/pwm/tb_PWM_tests_pkg.vhd, sim/pwm_core/tb_pwm_core_tests_pkg.vhd), empty = build only
    datatype    : str
    default     : ""
    paramtype   : generic

  #---------------------------------------
  # Generics of tb_pwm_core (sim_pwm_core*)
  #---------------------------------------
  PRESCALER_WIDTH :
    description : Width of the prescaler ratio of pwm_core
    datatype    : int
    default     : 4
    paramtype   : generic

  COUNTER_WIDTH :
    description : Width of the period and of the duty of pwm_core
    datatype    : int
    default     : 12
    paramtype   : generic

  #---------------------------------------
  # Generics of sbi_PWM_wrapper (lint_ghdl_synth_*, syn_*) and of tb_PWM (sim_*)
  #---------------------------------------
  STATIC_PRESCALER_RATIO :
    description : Static prescaler, clock cycles per step of the prescaler (1 = no static prescaler)
    datatype    : int
    default     : 1
    paramtype   : generic

  USER_DEFINE_PRESCALER :
    description : true, prescaler register writable by software ; false, ratio fixed to PRESCALER_RATIO
    datatype    : bool
    default     : true
    paramtype   : generic

  PRESCALER_RATIO :
    description : Reset / fixed value of the prescaler ratio (8-bit string)
    datatype    : str
    default     : "11000010"
    paramtype   : generic

# Next lines is a pragma, don't modify
#<PROVIDER_BEGIN>
provider  :
  name    : github
  user    : deuskane
  repo    : asylum-component-pwm
  version : asylum-component-PWM-1.0.0
 #version : bae70aa13b4c1ceb31840e6f9105947bc53a9441
#<PROVIDER_END>
