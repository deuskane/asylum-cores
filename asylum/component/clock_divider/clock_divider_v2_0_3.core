CAPI=2:

#-----------------------------------------------------------------------------
# Title      : Clock Divider Core file
# Project    : Asylum
#-----------------------------------------------------------------------------
# File       : clock_divider.core
# Author     : mrosiere
#-----------------------------------------------------------------------------
# Description: 
#-----------------------------------------------------------------------------
# Copyright (c) 2021
#-----------------------------------------------------------------------------
# Revisions  :
# Date        Version  Author   Description#
# 2021-10-26  1.0.0    mrosiere Created
# 2022-02-11  1.1.0    mrosiere Ratio parameter is string, delete GATED_CLOCK
# 2022-02-27  2.0.0    mrosiere Create real 50% duty cycle
# 2025-08-13  2.0.1    mrosiere Instanciate Clock Buffer after clock divider
# 2025-09-05  2.0.2    mrosiere Add Package
# 2026-10-05  2.0.3    mrosiere Fix 50% period for odd RATIO, assert on invalid
#                               ALGO, UVVM self-checking testbench, remove
#                               unused parameters
#-----------------------------------------------------------------------------

name : asylum:component:clock_divider:2.0.3
description : Clock Divider Cell

filesets:

  #---------------------------------------
  # Source Files
  #---------------------------------------
  files_hdl:
    files:
      - hdl/clock_divider_pkg.vhd
      - hdl/clock_divider.vhd
    file_type    : vhdlSource
    logical_name : asylum
    depend       :
      - asylum:utils:pkg
      - asylum:target:techmap
      
  #---------------------------------------
  # Testbench Files
  #---------------------------------------
  files_sim:
    files:
      - sim/tb_clock_divider.vhd
    file_type : vhdlSource-2008
    depend    :
      - bitvis:verification:uvvm

targets:

  #---------------------------------------
  # Default Target
  #---------------------------------------
  default: &default
    description     : Default Target
    filesets        :
      - files_hdl
    toplevel        : clock_divider
    default_tool    : ghdl

  sim_basic:
    << : *default
    description     : Simulation of all RATIO / ALGO cases (UVVM, self-checking)
    filesets_append :
      - files_sim
    toplevel        : tb_clock_divider
    default_tool    : ghdl
    tools :
      ghdl :
        analyze_options : ["-Wall","-fsynopsys","-frelaxed","--no-vital-checks"]
        run_options     : ["--fst=dut.fst","--ieee-asserts=disable"]


# Next lines is a pragma, don't modify
#<PROVIDER_BEGIN>
provider  :
  name    : github
  user    : deuskane
  repo    : asylum-component-clock_divider
  version : asylum-component-clock_divider-2.0.3
 #version : d61072918fe5f30a1951a35aebd36ad2922536b0
#<PROVIDER_END>
