CAPI=2:

#-----------------------------------------------------------------------------
# Title      : Clock Divider Core file
# Project    : Asylum
#-----------------------------------------------------------------------------
# File       : clock_divider.core
# Author     : mrosiere
#-----------------------------------------------------------------------------
# Description: 
#-----------------------------------------------------------------------------
# Copyright (c) 2021
#-----------------------------------------------------------------------------
# Revisions  :
# Date        Version  Author   Description#
# 2021-10-26  1.0.0    mrosiere Created
# 2022-02-11  1.1.0    mrosiere Ratio parameter is string, delete GATED_CLOCK
# 2022-02-27  2.0.0    mrosiere Create real 50% duty cycle
# 2025-08-13  2.0.1    mrosiere Instanciate Clock Buffer after clock divider
# 2025-09-05  2.0.2    mrosiere Add Package
# 2026-10-05  2.0.3    mrosiere Fix 50% period for odd RATIO, assert on invalid
#                               ALGO, UVVM self-checking testbench, remove
#                               unused parameters
# 2026-10-22  2.1.0    mrosiere Add BYPASS_CBUFG generic (no clock buffer)
#-----------------------------------------------------------------------------

name : asylum:component:clock_divider:2.1.0
description : Clock Divider Cell

filesets:

  #---------------------------------------
  # Source Files
  #---------------------------------------
  files_hdl:
    files:
      - hdl/clock_divider_pkg.vhd
      - hdl/clock_divider.vhd
    file_type    : vhdlSource
    logical_name : asylum
    depend       :
      - asylum:utils:pkg
      - asylum:target:techmap
      
  #---------------------------------------
  # Testbench Files
  #---------------------------------------
  files_sim:
    files:
      - sim/clock_divider/tb_clock_divider_bfm_pkg.vhd
      - sim/clock_divider/tb_clock_divider_reset_pkg.vhd
      - sim/clock_divider/tb_clock_divider_period_pkg.vhd
      - sim/clock_divider/tb_clock_divider_cke_stop_pkg.vhd
      - sim/clock_divider/tb_clock_divider_cke_half_pkg.vhd
      - sim/clock_divider/tb_clock_divider_reset_running_pkg.vhd
      - sim/clock_divider/tb_clock_divider_bypass_pkg.vhd
      - sim/clock_divider/tb_clock_divider_tests_pkg.vhd
      - sim/clock_divider/tb_clock_divider.vhd
    file_type : vhdlSource-2008
    depend    :
      - bitvis:verification:uvvm
      # string_pkg list_length / list_item / list_contains (TESTS_LIST)
      - ">=asylum:utils:pkg:1.10.0"

  #---------------------------------------
  syn:
  #---------------------------------------
    files        :
      - syn/clock_divider_wrapper.vhd
    file_type    : vhdlSource
    logical_name : asylum
    # ghdl_synth.sh / ghdl_synth.mk (pre_run hook of lint_ghdl_synth_*)
    depend       :
      - asylum:utils:ghdl_synth

  #---------------------------------------
  # Yosys scripts of the syn_* targets
  #---------------------------------------
  syn_yosys:
    depend       :
      - asylum:utils:yosys_synth

targets:

  #---------------------------------------
  # Default Target
  #---------------------------------------
  default: &default
    description     : Default Target
    filesets        :
      - files_hdl
    toplevel        : clock_divider
    default_tool    : ghdl

  #---------------------------------------
  # Lint : -Wall analysis and elaboration (empty simulation)
  #---------------------------------------
  lint_ghdl : &lint_ghdl
    << : *default
    description     : Lint with GHDL (-Wall analysis and elaboration of clock_divider_wrapper)
    toplevel        : asylum.clock_divider_wrapper
    filesets_append : [syn]
    default_tool    : ghdl
    tools :
      ghdl :
        analyze_options : ["-Wall"]

  #---------------------------------------
  # Synthesis check : -Wall analysis, ghdl --synth -Wall and elaboration
  # (no simulation) of clock_divider_wrapper with the generics of the target.
  # The pre_run hook (ghdl_synth.sh of asylum:utils:ghdl_synth) adds
  # ghdl_synth.mk to the edalize Makefile.
  # FuseSoC merges tools in depth : analyze_options comes from lint_ghdl.
  #---------------------------------------
  lint_ghdl_synth_default : &lint_ghdl_synth
    << : *lint_ghdl
    description     : Synthesis check of clock_divider_wrapper, default generics
    tools :
      ghdl :
        run_options     : ["--no-run"]
    hooks :
      pre_run : [ghdl_synth]

  #---------------------------------------
  lint_ghdl_synth_pulse_ratio1 :
  #---------------------------------------
    << : *lint_ghdl_synth
    description     : Synthesis check of clock_divider_wrapper, pulse, RATIO 1
    parameters      :
      - RATIO=1

  #---------------------------------------
  lint_ghdl_synth_pulse_ratio5 :
  #---------------------------------------
    << : *lint_ghdl_synth
    description     : Synthesis check of clock_divider_wrapper, pulse, RATIO 5
    parameters      :
      - RATIO=5

  #---------------------------------------
  lint_ghdl_synth_duty50_ratio4 :
  #---------------------------------------
    << : *lint_ghdl_synth
    description     : Synthesis check of clock_divider_wrapper, 50% duty cycle, RATIO 4
    parameters      :
      - RATIO=4
      - ALGO_50=true

  #---------------------------------------
  lint_ghdl_synth_duty50_ratio5 :
  #---------------------------------------
    << : *lint_ghdl_synth
    description     : Synthesis check of clock_divider_wrapper, 50% duty cycle, RATIO 5
    parameters      :
      - RATIO=5
      - ALGO_50=true

  #---------------------------------------
  # Synthesis : size of clock_divider_wrapper with the generics of the
  # target, Xilinx Artix-7 (LUT, FF, BRAM, DSP) and sky130 (area), by Yosys
  # and its GHDL plugin. Same configurations as lint_ghdl_synth_*.
  # The pre_run hook (yosys_synth.sh of asylum:utils:yosys_synth) adds
  # yosys_synth.mk to the edalize Makefile.
  #---------------------------------------
  syn_default : &syn
    << : *lint_ghdl
    description     : Synthesis (Artix-7, sky130) of clock_divider_wrapper, default generics
    filesets_append : [syn, syn_yosys]
    tools :
      ghdl :
        run_options     : ["--no-run"]
    hooks :
      pre_run : [yosys_synth]

  #---------------------------------------
  syn_pulse_ratio1 :
  #---------------------------------------
    << : *syn
    description     : Synthesis (Artix-7, sky130) of clock_divider_wrapper, pulse, RATIO 1
    parameters      :
      - RATIO=1

  #---------------------------------------
  syn_pulse_ratio5 :
  #---------------------------------------
    << : *syn
    description     : Synthesis (Artix-7, sky130) of clock_divider_wrapper, pulse, RATIO 5
    parameters      :
      - RATIO=5

  #---------------------------------------
  syn_duty50_ratio4 :
  #---------------------------------------
    << : *syn
    description     : Synthesis (Artix-7, sky130) of clock_divider_wrapper, 50% duty cycle, RATIO 4
    parameters      :
      - RATIO=4
      - ALGO_50=true

  #---------------------------------------
  syn_duty50_ratio5 :
  #---------------------------------------
    << : *syn
    description     : Synthesis (Artix-7, sky130) of clock_divider_wrapper, 50% duty cycle, RATIO 5
    parameters      :
      - RATIO=5
      - ALGO_50=true

  #---------------------------------------
  # tb_clock_divider (sim/clock_divider) : compiled once per configuration
  # (RATIO, ALGO_50), scenarios chosen at run time (TESTS_LIST, empty :
  # build and elaboration only). Reference configuration 50% duty cycle,
  # RATIO 5 (odd ratio : rising and falling edge registers) : sim_duty50_ratio5
  # (build only) and one sim_duty50_ratio5_<test> target per scenario ;
  # every other configuration (pulse and 50%, RATIO 1 to 8, 24 and 25)
  # runs the whole list. Each target repeats the generics of its
  # configuration : FuseSoC replaces the parameters list of an inherited
  # target.
  #---------------------------------------
  sim_duty50_ratio5: &sim
  #---------------------------------------
    << : *default
    description     : Simulation of clock_divider (UVVM), 50% duty cycle, RATIO 5 - build only (scenarios of TESTS_LIST)
    filesets_append :
      - files_sim
    toplevel        : tb_clock_divider
    parameters      :
      - TESTS_LIST
      - RATIO=5
      - ALGO_50=true
    default_tool    : ghdl
    tools :
      ghdl :
        analyze_options :
          - "$(GHDL_ANALYZE_OPTION)"
          - "-Wall"
          - "-frelaxed"
        run_options     :
          - "$(GHDL_RUN_OPTION)"
          - "--ieee-asserts=disable"

  #---------------------------------------
  sim_duty50_ratio5_reset:
  #---------------------------------------
    << : *sim
    description     : Simulation of clock_divider (UVVM), 50% duty cycle, RATIO 5 - clk_div_o low during the reset, first rising edge after the release
    parameters      :
      - TESTS_LIST=reset
      - RATIO=5
      - ALGO_50=true

  #---------------------------------------
  sim_duty50_ratio5_period:
  #---------------------------------------
    << : *sim
    description     : Simulation of clock_divider (UVVM), 50% duty cycle, RATIO 5 - period and high time with cke_i = 1
    parameters      :
      - TESTS_LIST=period
      - RATIO=5
      - ALGO_50=true

  #---------------------------------------
  sim_duty50_ratio5_cke_stop:
  #---------------------------------------
    << : *sim
    description     : Simulation of clock_divider (UVVM), 50% duty cycle, RATIO 5 - cke_i = 0 at 4 phases freezes clk_div_o, then period and high time
    parameters      :
      - TESTS_LIST=cke_stop
      - RATIO=5
      - ALGO_50=true

  #---------------------------------------
  sim_duty50_ratio5_cke_half:
  #---------------------------------------
    << : *sim
    description     : Simulation of clock_divider (UVVM), 50% duty cycle, RATIO 5 - cke_i = 1 one cycle out of 2 (changes on the falling then the rising edges), period 2*RATIO
    parameters      :
      - TESTS_LIST=cke_half
      - RATIO=5
      - ALGO_50=true

  #---------------------------------------
  sim_duty50_ratio5_reset_running:
  #---------------------------------------
    << : *sim
    description     : Simulation of clock_divider (UVVM), 50% duty cycle, RATIO 5 - reset between two clock edges clears clk_div_o at once, first rising edge after the release
    parameters      :
      - TESTS_LIST=reset_running
      - RATIO=5
      - ALGO_50=true

  #---------------------------------------
  sim_duty50_ratio5_bypass:
  #---------------------------------------
    << : *sim
    description     : Simulation of clock_divider (UVVM), 50% duty cycle, RATIO 5 - period and high time of the instance with BYPASS_CBUFG = true
    parameters      :
      - TESTS_LIST=bypass
      - RATIO=5
      - ALGO_50=true

  #---------------------------------------
  sim_pulse_ratio1:
  #---------------------------------------
    << : *sim
    description     : Simulation of clock_divider (UVVM), pulse, RATIO 1 - every scenario
    parameters      :
      - TESTS_LIST=reset,period,cke_stop,cke_half,reset_running,bypass
      - RATIO=1
      - ALGO_50=false

  #---------------------------------------
  sim_pulse_ratio2:
  #---------------------------------------
    << : *sim
    description     : Simulation of clock_divider (UVVM), pulse, RATIO 2 - every scenario
    parameters      :
      - TESTS_LIST=reset,period,cke_stop,cke_half,reset_running,bypass
      - RATIO=2
      - ALGO_50=false

  #---------------------------------------
  sim_pulse_ratio3:
  #---------------------------------------
    << : *sim
    description     : Simulation of clock_divider (UVVM), pulse, RATIO 3 - every scenario
    parameters      :
      - TESTS_LIST=reset,period,cke_stop,cke_half,reset_running,bypass
      - RATIO=3
      - ALGO_50=false

  #---------------------------------------
  sim_pulse_ratio4:
  #---------------------------------------
    << : *sim
    description     : Simulation of clock_divider (UVVM), pulse, RATIO 4 - every scenario
    parameters      :
      - TESTS_LIST=reset,period,cke_stop,cke_half,reset_running,bypass
      - RATIO=4
      - ALGO_50=false

  #---------------------------------------
  sim_pulse_ratio5:
  #---------------------------------------
    << : *sim
    description     : Simulation of clock_divider (UVVM), pulse, RATIO 5 - every scenario
    parameters      :
      - TESTS_LIST=reset,period,cke_stop,cke_half,reset_running,bypass
      - RATIO=5
      - ALGO_50=false

  #---------------------------------------
  sim_pulse_ratio6:
  #---------------------------------------
    << : *sim
    description     : Simulation of clock_divider (UVVM), pulse, RATIO 6 - every scenario
    parameters      :
      - TESTS_LIST=reset,period,cke_stop,cke_half,reset_running,bypass
      - RATIO=6
      - ALGO_50=false

  #---------------------------------------
  sim_pulse_ratio7:
  #---------------------------------------
    << : *sim
    description     : Simulation of clock_divider (UVVM), pulse, RATIO 7 - every scenario
    parameters      :
      - TESTS_LIST=reset,period,cke_stop,cke_half,reset_running,bypass
      - RATIO=7
      - ALGO_50=false

  #---------------------------------------
  sim_pulse_ratio8:
  #---------------------------------------
    << : *sim
    description     : Simulation of clock_divider (UVVM), pulse, RATIO 8 - every scenario
    parameters      :
      - TESTS_LIST=reset,period,cke_stop,cke_half,reset_running,bypass
      - RATIO=8
      - ALGO_50=false

  #---------------------------------------
  sim_pulse_ratio24:
  #---------------------------------------
    << : *sim
    description     : Simulation of clock_divider (UVVM), pulse, RATIO 24 - every scenario
    parameters      :
      - TESTS_LIST=reset,period,cke_stop,cke_half,reset_running,bypass
      - RATIO=24
      - ALGO_50=false

  #---------------------------------------
  sim_pulse_ratio25:
  #---------------------------------------
    << : *sim
    description     : Simulation of clock_divider (UVVM), pulse, RATIO 25 - every scenario
    parameters      :
      - TESTS_LIST=reset,period,cke_stop,cke_half,reset_running,bypass
      - RATIO=25
      - ALGO_50=false

  #---------------------------------------
  sim_duty50_ratio1:
  #---------------------------------------
    << : *sim
    description     : Simulation of clock_divider (UVVM), 50% duty cycle, RATIO 1 - every scenario
    parameters      :
      - TESTS_LIST=reset,period,cke_stop,cke_half,reset_running,bypass
      - RATIO=1
      - ALGO_50=true

  #---------------------------------------
  sim_duty50_ratio2:
  #---------------------------------------
    << : *sim
    description     : Simulation of clock_divider (UVVM), 50% duty cycle, RATIO 2 - every scenario
    parameters      :
      - TESTS_LIST=reset,period,cke_stop,cke_half,reset_running,bypass
      - RATIO=2
      - ALGO_50=true

  #---------------------------------------
  sim_duty50_ratio3:
  #---------------------------------------
    << : *sim
    description     : Simulation of clock_divider (UVVM), 50% duty cycle, RATIO 3 - every scenario
    parameters      :
      - TESTS_LIST=reset,period,cke_stop,cke_half,reset_running,bypass
      - RATIO=3
      - ALGO_50=true

  #---------------------------------------
  sim_duty50_ratio4:
  #---------------------------------------
    << : *sim
    description     : Simulation of clock_divider (UVVM), 50% duty cycle, RATIO 4 - every scenario
    parameters      :
      - TESTS_LIST=reset,period,cke_stop,cke_half,reset_running,bypass
      - RATIO=4
      - ALGO_50=true

  #---------------------------------------
  sim_duty50_ratio6:
  #---------------------------------------
    << : *sim
    description     : Simulation of clock_divider (UVVM), 50% duty cycle, RATIO 6 - every scenario
    parameters      :
      - TESTS_LIST=reset,period,cke_stop,cke_half,reset_running,bypass
      - RATIO=6
      - ALGO_50=true

  #---------------------------------------
  sim_duty50_ratio7:
  #---------------------------------------
    << : *sim
    description     : Simulation of clock_divider (UVVM), 50% duty cycle, RATIO 7 - every scenario
    parameters      :
      - TESTS_LIST=reset,period,cke_stop,cke_half,reset_running,bypass
      - RATIO=7
      - ALGO_50=true

  #---------------------------------------
  sim_duty50_ratio8:
  #---------------------------------------
    << : *sim
    description     : Simulation of clock_divider (UVVM), 50% duty cycle, RATIO 8 - every scenario
    parameters      :
      - TESTS_LIST=reset,period,cke_stop,cke_half,reset_running,bypass
      - RATIO=8
      - ALGO_50=true

  #---------------------------------------
  sim_duty50_ratio24:
  #---------------------------------------
    << : *sim
    description     : Simulation of clock_divider (UVVM), 50% duty cycle, RATIO 24 - every scenario
    parameters      :
      - TESTS_LIST=reset,period,cke_stop,cke_half,reset_running,bypass
      - RATIO=24
      - ALGO_50=true

  #---------------------------------------
  sim_duty50_ratio25:
  #---------------------------------------
    << : *sim
    description     : Simulation of clock_divider (UVVM), 50% duty cycle, RATIO 25 - every scenario
    parameters      :
      - TESTS_LIST=reset,period,cke_stop,cke_half,reset_running,bypass
      - RATIO=25
      - ALGO_50=true

scripts:

  #---------------------------------------
  # pre_run hook of lint_ghdl_synth_* (cwd = work_root)
  #---------------------------------------
  ghdl_synth :
    cmd : [bash, ghdl_synth.sh]

  #---------------------------------------
  # pre_run hook of syn_* (cwd = work_root)
  #---------------------------------------
  yosys_synth :
    cmd : [bash, yosys_synth.sh]

#=========================================
parameters :
#=========================================

  TESTS_LIST :
    description : Scenarios run in sequence, separated by ',' (names in sim/clock_divider/tb_clock_divider_tests_pkg.vhd), empty = build only
    datatype    : str
    default     : ""
    paramtype   : generic

  #---------------------------------------
  # Generics of clock_divider_wrapper (lint_ghdl_synth_*, syn_*) and
  # tb_clock_divider (sim_*)
  #---------------------------------------
  RATIO :
    description : Static ratio
    datatype    : int
    default     : 2
    paramtype   : generic

  ALGO_50 :
    description : false, pulse ; true, 50% duty cycle (ALGO of clock_divider)
    datatype    : bool
    default     : false
    paramtype   : generic

# Next lines is a pragma, don't modify
#<PROVIDER_BEGIN>
provider  :
  name    : github
  user    : deuskane
  repo    : asylum-component-clock_divider
  version : asylum-component-clock_divider-2.1.0
 #version : eb104b0024576debdd0dde47eb6c3933529d5af6
#<PROVIDER_END>
