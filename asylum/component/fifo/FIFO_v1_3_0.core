CAPI=2:

#-----------------------------------------------------------------------------
# Title      : FIFO Core file
# Project    : Asylum
#-----------------------------------------------------------------------------
# File       : FIFO.core
# Author     : mrosiere
#-----------------------------------------------------------------------------
# Description: 
#-----------------------------------------------------------------------------
# Copyright (c) 2025
#-----------------------------------------------------------------------------
# Revisions  :
# Date        Version  Author   Description
# 2025-07-05  1.0.0    mrosiere First Release
# 2025-07-28  1.1.0    mrosiere Add flags full/empty in each side
# 2025-09-06  1.1.1    mrosiere Update depends
# 2026-06-10  1.2.0    mrosiere Add SYNC_READ and tb
# 2026-10-05  1.2.1    mrosiere Fix SYNC_READ push+pop with one word stored
#                               Skip nb_elt assertion before reset
#                               Fix empty/full flags with DEPTH=1
#                               Add simultaneous push/pop tests
#                               Rename lint target to lint_ghdl
# 2026-11-27  1.3.0    mrosiere Add fifo_async (two clocks, ram_1r1w_2c,
#                               Gray pointers of gray_pkg, reset released on
#                               each clock) and tb_fifo_async
#-----------------------------------------------------------------------------

name        : asylum:component:fifo:1.3.0
description : "FIFO Module (fifo_sync : one clock, fifo_async : two clocks)"

#=========================================
filesets:
#=========================================

  #---------------------------------------
  hdl:
  #---------------------------------------
    files        :
      - hdl/fifo_pkg.vhd
      - hdl/fifo_sync.vhd
      - hdl/fifo_async.vhd
    file_type    : vhdlSource-2008
    logical_name : asylum
    depend       :
      # gray_pkg (fifo_async)
      - ">=asylum:utils:pkg:1.12.0"
      # ram_1r1w_2c (storage of fifo_async)
      - ">=asylum:component:ram:1.3.0"
      # sync2dffrn (synchronizers of fifo_async)
      - asylum:target:techmap

  #---------------------------------------
  sim_fifo_sync:
  #---------------------------------------
    files        :
      - sim/fifo_sync/tb_fifo_sync_bfm_pkg.vhd
      - sim/fifo_sync/tb_fifo_sync_reset_values_pkg.vhd
      - sim/fifo_sync/tb_fifo_sync_write_read_pkg.vhd
      - sim/fifo_sync/tb_fifo_sync_fill_drain_pkg.vhd
      - sim/fifo_sync/tb_fifo_sync_alternate_pkg.vhd
      - sim/fifo_sync/tb_fifo_sync_half_full_pkg.vhd
      - sim/fifo_sync/tb_fifo_sync_overflow_pkg.vhd
      - sim/fifo_sync/tb_fifo_sync_underflow_pkg.vhd
      - sim/fifo_sync/tb_fifo_sync_push_pop_pkg.vhd
      - sim/fifo_sync/tb_fifo_sync_random_pkg.vhd
      - sim/fifo_sync/tb_fifo_sync_async_reset_pkg.vhd
      - sim/fifo_sync/tb_fifo_sync_tests_pkg.vhd
      - sim/fifo_sync/tb_fifo_sync.vhd
    file_type    : vhdlSource-2008
    depend       :
      - bitvis:verification:uvvm
      # string_pkg list_length / list_item / list_contains (TESTS_LIST)
      - ">=asylum:utils:pkg:1.10.0"

  #---------------------------------------
  # Testbench of fifo_async : helpers of tb_fifo_sync_bfm_pkg, one package
  # per scenario
  #---------------------------------------
  sim_fifo_async:
    files        :
      - sim/fifo_sync/tb_fifo_sync_bfm_pkg.vhd
      - sim/fifo_async/tb_fifo_async_bfm_pkg.vhd
      - sim/fifo_async/tb_fifo_async_reset_values_pkg.vhd
      - sim/fifo_async/tb_fifo_async_write_read_pkg.vhd
      - sim/fifo_async/tb_fifo_async_fill_drain_pkg.vhd
      - sim/fifo_async/tb_fifo_async_overflow_pkg.vhd
      - sim/fifo_async/tb_fifo_async_underflow_pkg.vhd
      - sim/fifo_async/tb_fifo_async_stream_pkg.vhd
      - sim/fifo_async/tb_fifo_async_async_reset_pkg.vhd
      - sim/fifo_async/tb_fifo_async_clock_stop_pkg.vhd
      - sim/fifo_async/tb_fifo_async_reset_release_pkg.vhd
      - sim/fifo_async/tb_fifo_async_reset_traffic_pkg.vhd
      - sim/fifo_async/tb_fifo_async_tests_pkg.vhd
      - sim/fifo_async/tb_fifo_async.vhd
    file_type    : vhdlSource-2008
    depend       :
      - bitvis:verification:uvvm
      # string_pkg list_length / list_item / list_contains (TESTS_LIST)
      - ">=asylum:utils:pkg:1.10.0"

  #---------------------------------------
  # Lint / synthesis check : asylum:utils:ghdl_synth, a core without
  # dependency (fifo cannot depend on generators : cycle
  # generators -> fifo -> ram -> pkg)
  #---------------------------------------
  syn:
    # ghdl_synth.sh / ghdl_synth.mk (pre_run hook of lint_ghdl_synth_*)
    depend       :
      - asylum:utils:ghdl_synth
      # sync2dffrn without a comment read as a pragma (-Werror of the lint)
      - ">=asylum:target:generic:1.1.6"

  #---------------------------------------
  syn_yosys:
  #---------------------------------------
    # yosys_synth.sh / yosys_synth.mk / yosys_synth.py (pre_run hook of syn_*)
    depend       :
      - asylum:utils:yosys_synth

#=========================================
targets:
#=========================================

  #---------------------------------------
  default: &default
  #---------------------------------------
    description     : Default Target
    filesets        :
      - hdl

  #---------------------------------------
  lint_ghdl : &lint_ghdl
  #---------------------------------------
    << : *default
    description     : Lint with GHDL (-Wall analysis and elaboration of fifo_sync)
    toplevel        : asylum.fifo_sync
    filesets_append : [syn]
    default_tool    : ghdl
    tools :
      ghdl :
        analyze_options : ["-Wall","-Werror"]

  #---------------------------------------
  # Synthesis check : -Wall analysis, ghdl --synth -Wall and elaboration
  # (no simulation) of fifo_sync with the generics of the target.
  # The pre_run hook (ghdl_synth.sh of asylum:utils:ghdl_synth) adds
  # ghdl_synth.mk to the edalize Makefile.
  # FuseSoC merges tools in depth : analyze_options comes from lint_ghdl.
  #---------------------------------------
  lint_ghdl_synth_default : &lint_ghdl_synth
    << : *lint_ghdl
    description     : Synthesis check of fifo_sync, default generics
    tools :
      ghdl :
        run_options     : ["--no-run"]
    hooks :
      pre_run : [ghdl_synth]

  #---------------------------------------
  lint_ghdl_synth_depth1_read_async :
  #---------------------------------------
    << : *lint_ghdl_synth
    description     : Synthesis check of fifo_sync, DEPTH 1, asynchronous read
    parameters      :
      - DEPTH=1

  #---------------------------------------
  lint_ghdl_synth_depth1_read_sync :
  #---------------------------------------
    << : *lint_ghdl_synth
    description     : Synthesis check of fifo_sync, DEPTH 1, synchronous read
    parameters      :
      - DEPTH=1
      - SYNC_READ=true

  #---------------------------------------
  lint_ghdl_synth_depth8_read_async :
  #---------------------------------------
    << : *lint_ghdl_synth
    description     : Synthesis check of fifo_sync, DEPTH 8, asynchronous read
    parameters      :
      - DEPTH=8

  #---------------------------------------
  lint_ghdl_synth_depth8_read_sync :
  #---------------------------------------
    << : *lint_ghdl_synth
    description     : Synthesis check of fifo_sync, DEPTH 8, synchronous read
    parameters      :
      - DEPTH=8
      - SYNC_READ=true

  #---------------------------------------
  # fifo_async : default generics (DEPTH 4) and DEPTH 16. The attributes
  # of sync2dffrn (ASYNC_REG ...) are not handled by ghdl --synth : these
  # warnings are not errors
  #---------------------------------------
  lint_ghdl_synth_async_default : &lint_ghdl_synth_async
    << : *lint_ghdl_synth
    description     : Synthesis check of fifo_async, default generics (DEPTH 4)
    toplevel        : asylum.fifo_async
    tools :
      ghdl :
        analyze_options : ["-Wno-error=unhandled-attribute"]

  #---------------------------------------
  lint_ghdl_synth_async_depth16 :
  #---------------------------------------
    << : *lint_ghdl_synth_async
    description     : Synthesis check of fifo_async, DEPTH 16
    toplevel        : asylum.fifo_async
    parameters      :
      - DEPTH=16

  #---------------------------------------
  # Synthesis : size of fifo_sync with the generics of the target, Xilinx
  # Artix-7 (LUT, FF, BRAM, DSP) and sky130 (area), by Yosys and its GHDL
  # plugin. Same configurations as lint_ghdl_synth_*.
  # The pre_run hook (yosys_synth.sh of asylum:utils:yosys_synth) adds
  # yosys_synth.mk to the edalize Makefile.
  #---------------------------------------
  syn_default : &syn
    << : *lint_ghdl
    description     : Synthesis (Artix-7, sky130) of fifo_sync, default generics
    filesets_append : [syn, syn_yosys]
    tools :
      ghdl :
        run_options     : ["--no-run"]
    hooks :
      pre_run : [yosys_synth]

  #---------------------------------------
  syn_depth1_read_async :
  #---------------------------------------
    << : *syn
    description     : Synthesis (Artix-7, sky130) of fifo_sync, DEPTH 1, asynchronous read
    parameters      :
      - DEPTH=1

  #---------------------------------------
  syn_depth1_read_sync :
  #---------------------------------------
    << : *syn
    description     : Synthesis (Artix-7, sky130) of fifo_sync, DEPTH 1, synchronous read
    parameters      :
      - DEPTH=1
      - SYNC_READ=true

  #---------------------------------------
  syn_depth8_read_async :
  #---------------------------------------
    << : *syn
    description     : Synthesis (Artix-7, sky130) of fifo_sync, DEPTH 8, asynchronous read
    parameters      :
      - DEPTH=8

  #---------------------------------------
  syn_depth8_read_sync :
  #---------------------------------------
    << : *syn
    description     : Synthesis (Artix-7, sky130) of fifo_sync, DEPTH 8, synchronous read
    parameters      :
      - DEPTH=8
      - SYNC_READ=true

  #---------------------------------------
  syn_async_default : &syn_async
  #---------------------------------------
    << : *syn
    description     : Synthesis (Artix-7, sky130) of fifo_async, default generics (DEPTH 4)
    toplevel        : asylum.fifo_async
    tools :
      ghdl :
        analyze_options : ["-Wno-error=unhandled-attribute"]

  #---------------------------------------
  syn_async_depth16 :
  #---------------------------------------
    << : *syn_async
    description     : Synthesis (Artix-7, sky130) of fifo_async, DEPTH 16
    toplevel        : asylum.fifo_async
    parameters      :
      - DEPTH=16

  #---------------------------------------
  # tb_fifo_sync (sim/fifo_sync) : compiled once, configuration (DEPTH,
  # SYNC_READ) and scenarios (TESTS_LIST, empty : build and elaboration
  # only) chosen at run time.
  # Reference configuration DEPTH 8, synchronous RAM read :
  # sim_fifo_depth8_read_sync (build only) and one
  # sim_fifo_depth8_read_sync_<test> target per scenario ; the other
  # configurations run the whole list. Each target repeats the generics of
  # its configuration : FuseSoC replaces the parameters list of an
  # inherited target.
  #---------------------------------------
  sim_fifo_depth8_read_sync: &sim_fifo
    << : *default
    description     : Simulation of fifo_sync (UVVM), DEPTH 8, synchronous RAM read - build only (scenarios of TESTS_LIST)
    filesets_append :
      - sim_fifo_sync
    toplevel        : tb_fifo_sync
    parameters      :
      - TESTS_LIST
      - DEPTH=8
      - SYNC_READ=true
    default_tool    : ghdl
    tools :
      ghdl :
        analyze_options :
          - "$(GHDL_ANALYZE_OPTION)"
          - "-Wall"
          - "-frelaxed"
        run_options     :
          - "$(GHDL_RUN_OPTION)"
          - "--ieee-asserts=disable"

  #---------------------------------------
  sim_fifo_depth8_read_sync_reset_values:
  #---------------------------------------
    << : *sim_fifo
    description     : Simulation of fifo_sync (UVVM), DEPTH 8, synchronous RAM read - flags and fill levels after reset, nothing written by an idle producer
    parameters      :
      - TESTS_LIST=reset_values
      - DEPTH=8
      - SYNC_READ=true

  #---------------------------------------
  sim_fifo_depth8_read_sync_write_read:
  #---------------------------------------
    << : *sim_fifo
    description     : Simulation of fifo_sync (UVVM), DEPTH 8, synchronous RAM read - 5 words written then read (AXI-Stream BFM)
    parameters      :
      - TESTS_LIST=write_read
      - DEPTH=8
      - SYNC_READ=true

  #---------------------------------------
  sim_fifo_depth8_read_sync_fill_drain:
  #---------------------------------------
    << : *sim_fifo
    description     : Simulation of fifo_sync (UVVM), DEPTH 8, synchronous RAM read - fill up to DEPTH words, flags when full, drain
    parameters      :
      - TESTS_LIST=fill_drain
      - DEPTH=8
      - SYNC_READ=true

  #---------------------------------------
  sim_fifo_depth8_read_sync_alternate:
  #---------------------------------------
    << : *sim_fifo
    description     : Simulation of fifo_sync (UVVM), DEPTH 8, synchronous RAM read - 2 x DEPTH single word write / read pairs
    parameters      :
      - TESTS_LIST=alternate
      - DEPTH=8
      - SYNC_READ=true

  #---------------------------------------
  sim_fifo_depth8_read_sync_half_full:
  #---------------------------------------
    << : *sim_fifo
    description     : Simulation of fifo_sync (UVVM), DEPTH 8, synchronous RAM read - half filled, then write / read pairs, then drain (DEPTH >= 2)
    parameters      :
      - TESTS_LIST=half_full
      - DEPTH=8
      - SYNC_READ=true

  #---------------------------------------
  sim_fifo_depth8_read_sync_overflow:
  #---------------------------------------
    << : *sim_fifo
    description     : Simulation of fifo_sync (UVVM), DEPTH 8, synchronous RAM read - writes refused when full (s_axis_tready_o = 0), content kept, cycle by cycle
    parameters      :
      - TESTS_LIST=overflow
      - DEPTH=8
      - SYNC_READ=true

  #---------------------------------------
  sim_fifo_depth8_read_sync_underflow:
  #---------------------------------------
    << : *sim_fifo
    description     : Simulation of fifo_sync (UVVM), DEPTH 8, synchronous RAM read - reads refused when empty (m_axis_tvalid_o = 0), next word read, cycle by cycle
    parameters      :
      - TESTS_LIST=underflow
      - DEPTH=8
      - SYNC_READ=true

  #---------------------------------------
  sim_fifo_depth8_read_sync_push_pop:
  #---------------------------------------
    << : *sim_fifo
    description     : Simulation of fifo_sync (UVVM), DEPTH 8, synchronous RAM read - simultaneous write and read at every fill level, reached from below and above, cycle by cycle
    parameters      :
      - TESTS_LIST=push_pop
      - DEPTH=8
      - SYNC_READ=true

  #---------------------------------------
  sim_fifo_depth8_read_sync_random:
  #---------------------------------------
    << : *sim_fifo
    description     : Simulation of fifo_sync (UVVM), DEPTH 8, synchronous RAM read - 1200 cycles of random writes and reads (4 profiles), cycle by cycle
    parameters      :
      - TESTS_LIST=random
      - DEPTH=8
      - SYNC_READ=true

  #---------------------------------------
  sim_fifo_depth8_read_sync_async_reset:
  #---------------------------------------
    << : *sim_fifo
    description     : Simulation of fifo_sync (UVVM), DEPTH 8, synchronous RAM read - reset of a full FIFO without clock edge, words written after reset read back
    parameters      :
      - TESTS_LIST=async_reset
      - DEPTH=8
      - SYNC_READ=true

  #---------------------------------------
  sim_fifo_depth8_read_async:
  #---------------------------------------
    << : *sim_fifo
    description     : Simulation of fifo_sync (UVVM), DEPTH 8, asynchronous RAM read, every scenario
    parameters      :
      - TESTS_LIST=reset_values,write_read,fill_drain,alternate,half_full,overflow,underflow,push_pop,random,async_reset
      - DEPTH=8
      - SYNC_READ=false

  #---------------------------------------
  sim_fifo_depth1_read_sync:
  #---------------------------------------
    << : *sim_fifo
    description     : Simulation of fifo_sync (UVVM), DEPTH 1, synchronous RAM read, every scenario but half_full
    parameters      :
      - TESTS_LIST=reset_values,write_read,fill_drain,alternate,overflow,underflow,push_pop,random,async_reset
      - DEPTH=1
      - SYNC_READ=true

  #---------------------------------------
  sim_fifo_depth1_read_async:
  #---------------------------------------
    << : *sim_fifo
    description     : Simulation of fifo_sync (UVVM), DEPTH 1, asynchronous RAM read, every scenario but half_full
    parameters      :
      - TESTS_LIST=reset_values,write_read,fill_drain,alternate,overflow,underflow,push_pop,random,async_reset
      - DEPTH=1
      - SYNC_READ=false

  #---------------------------------------
  # tb_fifo_async (sim/fifo_async) : compiled once per DEPTH, clock
  # periods (S_CLK_PERIOD write side, M_CLK_PERIOD read side, ns) and
  # scenarios (TESTS_LIST) chosen at run time.
  # Reference configuration DEPTH 8, write clock 10 ns, read clock 13 ns
  # (unrelated) : sim_fifo_async_depth8 (build only) and one
  # sim_fifo_async_depth8_<test> target per scenario ; the other
  # configurations run the whole list. Generated.
  #---------------------------------------
  sim_fifo_async_depth8: &sim_fifo_async
    << : *default
    description     : Simulation of fifo_async (UVVM), DEPTH 8, write clock 10 ns, read clock 13 ns - build only (scenarios of TESTS_LIST)
    filesets_append :
      - sim_fifo_async
    toplevel        : tb_fifo_async
    parameters      :
      - TESTS_LIST
      - DEPTH=8
      - S_CLK_PERIOD=10
      - M_CLK_PERIOD=13
    default_tool    : ghdl
    tools :
      ghdl :
        analyze_options :
          - "$(GHDL_ANALYZE_OPTION)"
          - "-Wall"
          - "-frelaxed"
        run_options     :
          - "$(GHDL_RUN_OPTION)"
          - "--ieee-asserts=disable"

  #---------------------------------------
  sim_fifo_async_depth8_reset_values:
  #---------------------------------------
    << : *sim_fifo_async
    description     : Simulation of fifo_async (UVVM), DEPTH 8, write clock 10 ns, read clock 13 ns - flags and fill levels of both sides after reset, nothing read while nothing is written
    parameters      :
      - TESTS_LIST=reset_values
      - DEPTH=8
      - S_CLK_PERIOD=10
      - M_CLK_PERIOD=13

  #---------------------------------------
  sim_fifo_async_depth8_write_read:
  #---------------------------------------
    << : *sim_fifo_async
    description     : Simulation of fifo_async (UVVM), DEPTH 8, write clock 10 ns, read clock 13 ns - 5 words written on the write clock, read in order on the read clock (AXI-Stream BFM)
    parameters      :
      - TESTS_LIST=write_read
      - DEPTH=8
      - S_CLK_PERIOD=10
      - M_CLK_PERIOD=13

  #---------------------------------------
  sim_fifo_async_depth8_fill_drain:
  #---------------------------------------
    << : *sim_fifo_async
    description     : Simulation of fifo_async (UVVM), DEPTH 8, write clock 10 ns, read clock 13 ns - DEPTH words written then read one by one, flags and fill levels of both sides after each word
    parameters      :
      - TESTS_LIST=fill_drain
      - DEPTH=8
      - S_CLK_PERIOD=10
      - M_CLK_PERIOD=13

  #---------------------------------------
  sim_fifo_async_depth8_overflow:
  #---------------------------------------
    << : *sim_fifo_async
    description     : Simulation of fifo_async (UVVM), DEPTH 8, write clock 10 ns, read clock 13 ns - writes refused when full, a read frees a place after the synchronizer (latency checked), order kept
    parameters      :
      - TESTS_LIST=overflow
      - DEPTH=8
      - S_CLK_PERIOD=10
      - M_CLK_PERIOD=13

  #---------------------------------------
  sim_fifo_async_depth8_underflow:
  #---------------------------------------
    << : *sim_fifo_async
    description     : Simulation of fifo_async (UVVM), DEPTH 8, write clock 10 ns, read clock 13 ns - nothing read while empty, a written word seen after the synchronizer (latency checked)
    parameters      :
      - TESTS_LIST=underflow
      - DEPTH=8
      - S_CLK_PERIOD=10
      - M_CLK_PERIOD=13

  #---------------------------------------
  sim_fifo_async_depth8_stream:
  #---------------------------------------
    << : *sim_fifo_async
    description     : Simulation of fifo_async (UVVM), DEPTH 8, write clock 10 ns, read clock 13 ns - writer and reader at the same time, random valid / ready, writer faster then reader faster, order kept
    parameters      :
      - TESTS_LIST=stream
      - DEPTH=8
      - S_CLK_PERIOD=10
      - M_CLK_PERIOD=13

  #---------------------------------------
  sim_fifo_async_depth8_async_reset:
  #---------------------------------------
    << : *sim_fifo_async
    description     : Simulation of fifo_async (UVVM), DEPTH 8, write clock 10 ns, read clock 13 ns - reset of a FIFO holding words, both sides empty, words written after the reset read back
    parameters      :
      - TESTS_LIST=async_reset
      - DEPTH=8
      - S_CLK_PERIOD=10
      - M_CLK_PERIOD=13

  #---------------------------------------
  sim_fifo_async_depth8_clock_stop:
  #---------------------------------------
    << : *sim_fifo_async
    description     : Simulation of fifo_async (UVVM), DEPTH 8, write clock 10 ns, read clock 13 ns - a write (a read) seen by the other side when the write (read) clock stops right after it
    parameters      :
      - TESTS_LIST=clock_stop
      - DEPTH=8
      - S_CLK_PERIOD=10
      - M_CLK_PERIOD=13

  #---------------------------------------
  sim_fifo_async_depth8_reset_release:
  #---------------------------------------
    << : *sim_fifo_async
    description     : Simulation of fifo_async (UVVM), DEPTH 8, write clock 10 ns, read clock 13 ns - during a reset tready and tvalid low, release on each clock (latency checked), words after it
    parameters      :
      - TESTS_LIST=reset_release
      - DEPTH=8
      - S_CLK_PERIOD=10
      - M_CLK_PERIOD=13

  #---------------------------------------
  sim_fifo_async_depth8_reset_traffic:
  #---------------------------------------
    << : *sim_fifo_async
    description     : Simulation of fifo_async (UVVM), DEPTH 8, write clock 10 ns, read clock 13 ns - reset asserted and released in the middle of random traffic at unaligned times, empty after it, new words in order
    parameters      :
      - TESTS_LIST=reset_traffic
      - DEPTH=8
      - S_CLK_PERIOD=10
      - M_CLK_PERIOD=13

  #---------------------------------------
  sim_fifo_async_depth4_write_fast:
  #---------------------------------------
    << : *sim_fifo_async
    description     : Simulation of fifo_async (UVVM), DEPTH 4, write clock 7 ns, read clock 23 ns (write faster), every scenario
    parameters      :
      - TESTS_LIST=reset_values,write_read,fill_drain,overflow,underflow,stream,async_reset,clock_stop,reset_release,reset_traffic
      - DEPTH=4
      - S_CLK_PERIOD=7
      - M_CLK_PERIOD=23

  #---------------------------------------
  sim_fifo_async_depth16_read_fast:
  #---------------------------------------
    << : *sim_fifo_async
    description     : Simulation of fifo_async (UVVM), DEPTH 16, write clock 23 ns, read clock 7 ns (read faster), every scenario
    parameters      :
      - TESTS_LIST=reset_values,write_read,fill_drain,overflow,underflow,stream,async_reset,clock_stop,reset_release,reset_traffic
      - DEPTH=16
      - S_CLK_PERIOD=23
      - M_CLK_PERIOD=7

  #---------------------------------------
  sim_fifo_async_depth8_same_clock:
  #---------------------------------------
    << : *sim_fifo_async
    description     : Simulation of fifo_async (UVVM), DEPTH 8, write and read clocks of 10 ns (edges together), every scenario
    parameters      :
      - TESTS_LIST=reset_values,write_read,fill_drain,overflow,underflow,stream,async_reset,clock_stop,reset_release,reset_traffic
      - DEPTH=8
      - S_CLK_PERIOD=10
      - M_CLK_PERIOD=10

  #---------------------------------------
  sim_fifo_async_depth1:
  #---------------------------------------
    << : *sim_fifo_async
    description     : Simulation of fifo_async (UVVM), DEPTH 1, write clock 10 ns, read clock 13 ns, every scenario
    parameters      :
      - TESTS_LIST=reset_values,write_read,fill_drain,overflow,underflow,stream,async_reset,clock_stop,reset_release,reset_traffic
      - DEPTH=1
      - S_CLK_PERIOD=10
      - M_CLK_PERIOD=13

#=========================================
scripts :
#=========================================

  #---------------------------------------
  # pre_run hook of lint_ghdl_synth_* (cwd = work_root)
  #---------------------------------------
  ghdl_synth :
    cmd : [bash, ghdl_synth.sh]

  #---------------------------------------
  # pre_run hook of syn_* (cwd = work_root)
  #---------------------------------------
  yosys_synth :
    cmd : [bash, yosys_synth.sh]

#=========================================
parameters :
#=========================================

  TESTS_LIST :
    description : Scenarios run in sequence, separated by ',' (names in sim/fifo_sync/tb_fifo_sync_tests_pkg.vhd and sim/fifo_async/tb_fifo_async_tests_pkg.vhd), empty = build only
    datatype    : str
    default     : ""
    paramtype   : generic

  SYNC_READ :
    description : Synchronous read of the RAM
    datatype    : bool
    default     : false
    paramtype   : generic

  DEPTH :
    description : FIFO depth (power of 2)
    datatype    : int
    default     : 16
    paramtype   : generic

  S_CLK_PERIOD :
    description : Period of the write clock of tb_fifo_async, ns
    datatype    : int
    default     : 10
    paramtype   : generic

  M_CLK_PERIOD :
    description : Period of the read clock of tb_fifo_async, ns
    datatype    : int
    default     : 13
    paramtype   : generic

