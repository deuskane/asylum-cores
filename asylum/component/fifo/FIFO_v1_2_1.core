CAPI=2:

#-----------------------------------------------------------------------------
# Title      : FIFO Core file
# Project    : Asylum
#-----------------------------------------------------------------------------
# File       : FIFO.core
# Author     : mrosiere
#-----------------------------------------------------------------------------
# Description: 
#-----------------------------------------------------------------------------
# Copyright (c) 2025
#-----------------------------------------------------------------------------
# Revisions  :
# Date        Version  Author   Description
# 2025-07-05  1.0.0    mrosiere First Release
# 2025-07-28  1.1.0    mrosiere Add flags full/empty in each side
# 2025-09-06  1.1.1    mrosiere Update depends
# 2026-06-10  1.2.0    mrosiere Add SYNC_READ and tb
# 2026-10-05  1.2.1    mrosiere Fix SYNC_READ push+pop with one word stored
#                               Skip nb_elt assertion before reset
#                               Fix empty/full flags with DEPTH=1
#                               Add simultaneous push/pop tests
#                               Rename lint target to lint_ghdl
#-----------------------------------------------------------------------------

name        : asylum:component:fifo:1.2.1
description : FIFO Module

#=========================================
filesets:
#=========================================

  #---------------------------------------
  hdl:
  #---------------------------------------
    files        :
      - hdl/fifo_pkg.vhd
      - hdl/fifo_sync.vhd
    file_type    : vhdlSource-2008
    logical_name : asylum
    depend       :
      - asylum:utils:pkg
      - asylum:component:ram

  #---------------------------------------
  sim_fifo_sync:
  #---------------------------------------
    files        :
      - sim/fifo_sync/tb_fifo_sync_bfm_pkg.vhd
      - sim/fifo_sync/tb_fifo_sync_reset_values_pkg.vhd
      - sim/fifo_sync/tb_fifo_sync_write_read_pkg.vhd
      - sim/fifo_sync/tb_fifo_sync_fill_drain_pkg.vhd
      - sim/fifo_sync/tb_fifo_sync_alternate_pkg.vhd
      - sim/fifo_sync/tb_fifo_sync_half_full_pkg.vhd
      - sim/fifo_sync/tb_fifo_sync_overflow_pkg.vhd
      - sim/fifo_sync/tb_fifo_sync_underflow_pkg.vhd
      - sim/fifo_sync/tb_fifo_sync_push_pop_pkg.vhd
      - sim/fifo_sync/tb_fifo_sync_random_pkg.vhd
      - sim/fifo_sync/tb_fifo_sync_async_reset_pkg.vhd
      - sim/fifo_sync/tb_fifo_sync_tests_pkg.vhd
      - sim/fifo_sync/tb_fifo_sync.vhd
    file_type    : vhdlSource-2008
    depend       :
      - bitvis:verification:uvvm
      # string_pkg list_length / list_item / list_contains (TESTS_LIST)
      - ">=asylum:utils:pkg:1.10.0"

  #---------------------------------------
  # Lint / synthesis check : asylum:utils:ghdl_synth, a core without
  # dependency (fifo cannot depend on generators : cycle
  # generators -> fifo -> ram -> pkg)
  #---------------------------------------
  syn:
    # ghdl_synth.sh / ghdl_synth.mk (pre_run hook of lint_ghdl_synth_*)
    depend       :
      - asylum:utils:ghdl_synth

  #---------------------------------------
  syn_yosys:
  #---------------------------------------
    # yosys_synth.sh / yosys_synth.mk / yosys_synth.py (pre_run hook of syn_*)
    depend       :
      - asylum:utils:yosys_synth

#=========================================
targets:
#=========================================

  #---------------------------------------
  default: &default
  #---------------------------------------
    description     : Default Target
    filesets        :
      - hdl

  #---------------------------------------
  lint_ghdl : &lint_ghdl
  #---------------------------------------
    << : *default
    description     : Lint with GHDL (-Wall analysis and elaboration of fifo_sync)
    toplevel        : asylum.fifo_sync
    filesets_append : [syn]
    default_tool    : ghdl
    tools :
      ghdl :
        analyze_options : ["-Wall","-Werror"]

  #---------------------------------------
  # Synthesis check : -Wall analysis, ghdl --synth -Wall and elaboration
  # (no simulation) of fifo_sync with the generics of the target.
  # The pre_run hook (ghdl_synth.sh of asylum:utils:ghdl_synth) adds
  # ghdl_synth.mk to the edalize Makefile.
  # FuseSoC merges tools in depth : analyze_options comes from lint_ghdl.
  #---------------------------------------
  lint_ghdl_synth_default : &lint_ghdl_synth
    << : *lint_ghdl
    description     : Synthesis check of fifo_sync, default generics
    tools :
      ghdl :
        run_options     : ["--no-run"]
    hooks :
      pre_run : [ghdl_synth]

  #---------------------------------------
  lint_ghdl_synth_depth1_read_async :
  #---------------------------------------
    << : *lint_ghdl_synth
    description     : Synthesis check of fifo_sync, DEPTH 1, asynchronous read
    parameters      :
      - DEPTH=1

  #---------------------------------------
  lint_ghdl_synth_depth1_read_sync :
  #---------------------------------------
    << : *lint_ghdl_synth
    description     : Synthesis check of fifo_sync, DEPTH 1, synchronous read
    parameters      :
      - DEPTH=1
      - SYNC_READ=true

  #---------------------------------------
  lint_ghdl_synth_depth8_read_async :
  #---------------------------------------
    << : *lint_ghdl_synth
    description     : Synthesis check of fifo_sync, DEPTH 8, asynchronous read
    parameters      :
      - DEPTH=8

  #---------------------------------------
  lint_ghdl_synth_depth8_read_sync :
  #---------------------------------------
    << : *lint_ghdl_synth
    description     : Synthesis check of fifo_sync, DEPTH 8, synchronous read
    parameters      :
      - DEPTH=8
      - SYNC_READ=true

  #---------------------------------------
  # Synthesis : size of fifo_sync with the generics of the target, Xilinx
  # Artix-7 (LUT, FF, BRAM, DSP) and sky130 (area), by Yosys and its GHDL
  # plugin. Same configurations as lint_ghdl_synth_*.
  # The pre_run hook (yosys_synth.sh of asylum:utils:yosys_synth) adds
  # yosys_synth.mk to the edalize Makefile.
  #---------------------------------------
  syn_default : &syn
    << : *lint_ghdl
    description     : Synthesis (Artix-7, sky130) of fifo_sync, default generics
    filesets_append : [syn, syn_yosys]
    tools :
      ghdl :
        run_options     : ["--no-run"]
    hooks :
      pre_run : [yosys_synth]

  #---------------------------------------
  syn_depth1_read_async :
  #---------------------------------------
    << : *syn
    description     : Synthesis (Artix-7, sky130) of fifo_sync, DEPTH 1, asynchronous read
    parameters      :
      - DEPTH=1

  #---------------------------------------
  syn_depth1_read_sync :
  #---------------------------------------
    << : *syn
    description     : Synthesis (Artix-7, sky130) of fifo_sync, DEPTH 1, synchronous read
    parameters      :
      - DEPTH=1
      - SYNC_READ=true

  #---------------------------------------
  syn_depth8_read_async :
  #---------------------------------------
    << : *syn
    description     : Synthesis (Artix-7, sky130) of fifo_sync, DEPTH 8, asynchronous read
    parameters      :
      - DEPTH=8

  #---------------------------------------
  syn_depth8_read_sync :
  #---------------------------------------
    << : *syn
    description     : Synthesis (Artix-7, sky130) of fifo_sync, DEPTH 8, synchronous read
    parameters      :
      - DEPTH=8
      - SYNC_READ=true

  #---------------------------------------
  # tb_fifo_sync (sim/fifo_sync) : compiled once, configuration (DEPTH,
  # SYNC_READ) and scenarios (TESTS_LIST, empty : build and elaboration
  # only) chosen at run time.
  # Reference configuration DEPTH 8, synchronous RAM read :
  # sim_fifo_depth8_read_sync (build only) and one
  # sim_fifo_depth8_read_sync_<test> target per scenario ; the other
  # configurations run the whole list. Each target repeats the generics of
  # its configuration : FuseSoC replaces the parameters list of an
  # inherited target.
  #---------------------------------------
  sim_fifo_depth8_read_sync: &sim_fifo
    << : *default
    description     : Simulation of fifo_sync (UVVM), DEPTH 8, synchronous RAM read - build only (scenarios of TESTS_LIST)
    filesets_append :
      - sim_fifo_sync
    toplevel        : tb_fifo_sync
    parameters      :
      - TESTS_LIST
      - DEPTH=8
      - SYNC_READ=true
    default_tool    : ghdl
    tools :
      ghdl :
        analyze_options :
          - "$(GHDL_ANALYZE_OPTION)"
          - "-Wall"
          - "-frelaxed"
        run_options     :
          - "$(GHDL_RUN_OPTION)"
          - "--ieee-asserts=disable"

  #---------------------------------------
  sim_fifo_depth8_read_sync_reset_values:
  #---------------------------------------
    << : *sim_fifo
    description     : Simulation of fifo_sync (UVVM), DEPTH 8, synchronous RAM read - flags and fill levels after reset, nothing written by an idle producer
    parameters      :
      - TESTS_LIST=reset_values
      - DEPTH=8
      - SYNC_READ=true

  #---------------------------------------
  sim_fifo_depth8_read_sync_write_read:
  #---------------------------------------
    << : *sim_fifo
    description     : Simulation of fifo_sync (UVVM), DEPTH 8, synchronous RAM read - 5 words written then read (AXI-Stream BFM)
    parameters      :
      - TESTS_LIST=write_read
      - DEPTH=8
      - SYNC_READ=true

  #---------------------------------------
  sim_fifo_depth8_read_sync_fill_drain:
  #---------------------------------------
    << : *sim_fifo
    description     : Simulation of fifo_sync (UVVM), DEPTH 8, synchronous RAM read - fill up to DEPTH words, flags when full, drain
    parameters      :
      - TESTS_LIST=fill_drain
      - DEPTH=8
      - SYNC_READ=true

  #---------------------------------------
  sim_fifo_depth8_read_sync_alternate:
  #---------------------------------------
    << : *sim_fifo
    description     : Simulation of fifo_sync (UVVM), DEPTH 8, synchronous RAM read - 2 x DEPTH single word write / read pairs
    parameters      :
      - TESTS_LIST=alternate
      - DEPTH=8
      - SYNC_READ=true

  #---------------------------------------
  sim_fifo_depth8_read_sync_half_full:
  #---------------------------------------
    << : *sim_fifo
    description     : Simulation of fifo_sync (UVVM), DEPTH 8, synchronous RAM read - half filled, then write / read pairs, then drain (DEPTH >= 2)
    parameters      :
      - TESTS_LIST=half_full
      - DEPTH=8
      - SYNC_READ=true

  #---------------------------------------
  sim_fifo_depth8_read_sync_overflow:
  #---------------------------------------
    << : *sim_fifo
    description     : Simulation of fifo_sync (UVVM), DEPTH 8, synchronous RAM read - writes refused when full (s_axis_tready_o = 0), content kept, cycle by cycle
    parameters      :
      - TESTS_LIST=overflow
      - DEPTH=8
      - SYNC_READ=true

  #---------------------------------------
  sim_fifo_depth8_read_sync_underflow:
  #---------------------------------------
    << : *sim_fifo
    description     : Simulation of fifo_sync (UVVM), DEPTH 8, synchronous RAM read - reads refused when empty (m_axis_tvalid_o = 0), next word read, cycle by cycle
    parameters      :
      - TESTS_LIST=underflow
      - DEPTH=8
      - SYNC_READ=true

  #---------------------------------------
  sim_fifo_depth8_read_sync_push_pop:
  #---------------------------------------
    << : *sim_fifo
    description     : Simulation of fifo_sync (UVVM), DEPTH 8, synchronous RAM read - simultaneous write and read at every fill level, reached from below and above, cycle by cycle
    parameters      :
      - TESTS_LIST=push_pop
      - DEPTH=8
      - SYNC_READ=true

  #---------------------------------------
  sim_fifo_depth8_read_sync_random:
  #---------------------------------------
    << : *sim_fifo
    description     : Simulation of fifo_sync (UVVM), DEPTH 8, synchronous RAM read - 1200 cycles of random writes and reads (4 profiles), cycle by cycle
    parameters      :
      - TESTS_LIST=random
      - DEPTH=8
      - SYNC_READ=true

  #---------------------------------------
  sim_fifo_depth8_read_sync_async_reset:
  #---------------------------------------
    << : *sim_fifo
    description     : Simulation of fifo_sync (UVVM), DEPTH 8, synchronous RAM read - reset of a full FIFO without clock edge, words written after reset read back
    parameters      :
      - TESTS_LIST=async_reset
      - DEPTH=8
      - SYNC_READ=true

  #---------------------------------------
  sim_fifo_depth8_read_async:
  #---------------------------------------
    << : *sim_fifo
    description     : Simulation of fifo_sync (UVVM), DEPTH 8, asynchronous RAM read, every scenario
    parameters      :
      - TESTS_LIST=reset_values,write_read,fill_drain,alternate,half_full,overflow,underflow,push_pop,random,async_reset
      - DEPTH=8
      - SYNC_READ=false

  #---------------------------------------
  sim_fifo_depth1_read_sync:
  #---------------------------------------
    << : *sim_fifo
    description     : Simulation of fifo_sync (UVVM), DEPTH 1, synchronous RAM read, every scenario but half_full
    parameters      :
      - TESTS_LIST=reset_values,write_read,fill_drain,alternate,overflow,underflow,push_pop,random,async_reset
      - DEPTH=1
      - SYNC_READ=true

  #---------------------------------------
  sim_fifo_depth1_read_async:
  #---------------------------------------
    << : *sim_fifo
    description     : Simulation of fifo_sync (UVVM), DEPTH 1, asynchronous RAM read, every scenario but half_full
    parameters      :
      - TESTS_LIST=reset_values,write_read,fill_drain,alternate,overflow,underflow,push_pop,random,async_reset
      - DEPTH=1
      - SYNC_READ=false

#=========================================
scripts :
#=========================================

  #---------------------------------------
  # pre_run hook of lint_ghdl_synth_* (cwd = work_root)
  #---------------------------------------
  ghdl_synth :
    cmd : [bash, ghdl_synth.sh]

  #---------------------------------------
  # pre_run hook of syn_* (cwd = work_root)
  #---------------------------------------
  yosys_synth :
    cmd : [bash, yosys_synth.sh]

#=========================================
parameters :
#=========================================

  TESTS_LIST :
    description : Scenarios run in sequence, separated by ',' (names in sim/fifo_sync/tb_fifo_sync_tests_pkg.vhd), empty = build only
    datatype    : str
    default     : ""
    paramtype   : generic

  SYNC_READ :
    description : Synchronous read of the RAM
    datatype    : bool
    default     : false
    paramtype   : generic

  DEPTH :
    description : FIFO depth (power of 2)
    datatype    : int
    default     : 16
    paramtype   : generic

# Next lines is a pragma, don't modify
#<PROVIDER_BEGIN>
provider  :
  name    : github
  user    : deuskane
  repo    : asylum-component-fifo
  version : asylum-component-fifo-1.2.1
 #version : f548b4e77383bc65f543b1882a68e66c7d77d68c
#<PROVIDER_END>
