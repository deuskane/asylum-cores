CAPI=2:

#-----------------------------------------------------------------------------
# Title      : Stack Core file
# Project    : Asylum
#-----------------------------------------------------------------------------
# File       : stack.core
# Author     : mrosiere
#-----------------------------------------------------------------------------
# Description: 
#-----------------------------------------------------------------------------
# Copyright (c) 2021
#-----------------------------------------------------------------------------
# Revisions  :
# Date        Version  Author   Description
# 2021-10-26  1.0.0    mrosiere Created
# 2025-09-06  1.0.1    mrosiere Update deps
# 2026-10-05  1.0.2    mrosiere UVVM testbench, OVERWRITE parameter type int,
#                               add sim_overwrite target
# 2026-11-16  1.1.0    mrosiere arstn_i asynchronous reset, CYCLIC_PTR generic
#                               (KCPSM3 cyclic pointer), lint_ghdl targets
# 2026-11-16  1.2.0    mrosiere Synchronous reset srst_i (OpenBlaze8 / KCPSM3)
#-----------------------------------------------------------------------------

name : asylum:component:stack:1.2.0
description : Stack

filesets:

  #---------------------------------------
  # Source Files
  #---------------------------------------
  files_hdl:
    files        :
      - hdl/stack_pkg.vhd
      - hdl/stack.vhd
    file_type    : vhdlSource
    logical_name : asylum
    depend       :
      - ">=asylum:component:ram:1.0.0"
      
  #---------------------------------------
  # Testbench Files
  #---------------------------------------
  files_sim:
    files:
      - sim/stack/tb_stack_bfm_pkg.vhd
      - sim/stack/tb_stack_reset_values_pkg.vhd
      - sim/stack/tb_stack_lifo_pkg.vhd
      - sim/stack/tb_stack_push_full_pkg.vhd
      - sim/stack/tb_stack_push_pop_pkg.vhd
      - sim/stack/tb_stack_cke_pkg.vhd
      - sim/stack/tb_stack_async_reset_pkg.vhd
      - sim/stack/tb_stack_random_pkg.vhd
      - sim/stack/tb_stack_cyclic_pkg.vhd
      - sim/stack/tb_stack_sync_reset_pkg.vhd
      - sim/stack/tb_stack_tests_pkg.vhd
      - sim/stack/tb_stack.vhd
    file_type : vhdlSource-2008
    depend    :
      - bitvis:verification:uvvm
      # string_pkg list_length / list_item / list_contains (TESTS_LIST)
      - ">=asylum:utils:pkg:1.10.0"

  #---------------------------------------
  # Lint / synthesis check : ghdl_synth.sh / ghdl_synth.mk (pre_run
  # hook of lint_ghdl_synth_*) of asylum:utils:ghdl_synth
  #---------------------------------------
  syn:
    depend       :
      - asylum:utils:ghdl_synth

  #---------------------------------------
  # Yosys scripts of the syn_* targets : yosys_synth.sh / yosys_synth.mk /
  # yosys_synth.py (pre_run hook of syn_*)
  #---------------------------------------
  syn_yosys:
    depend       :
      - asylum:utils:yosys_synth

targets:

  #---------------------------------------
  # Default Target
  #---------------------------------------
  default: &default
    description     : Default Target
    filesets        :
      - files_hdl
    toplevel        : stack
    default_tool    : ghdl

  #---------------------------------------
  # Lint : -Wall analysis and elaboration (empty simulation)
  #---------------------------------------
  lint_ghdl : &lint_ghdl
    << : *default
    description     : Lint with GHDL (-Wall analysis and elaboration of stack)
    toplevel        : asylum.stack
    filesets_append : [syn]
    default_tool    : ghdl
    tools :
      ghdl :
        analyze_options : ["-Wall"]

  #---------------------------------------
  # Synthesis check : -Wall analysis, ghdl --synth -Wall and elaboration
  # (no simulation) of stack with the generics of the target.
  # The pre_run hook (ghdl_synth.sh of asylum:utils:ghdl_synth) adds
  # ghdl_synth.mk to the edalize Makefile.
  # FuseSoC merges tools in depth : analyze_options comes from lint_ghdl.
  #---------------------------------------
  lint_ghdl_synth_default : &lint_ghdl_synth
    << : *lint_ghdl
    description     : Synthesis check of stack, default generics
    tools :
      ghdl :
        run_options     : ["--no-run"]
    hooks :
      pre_run : [ghdl_synth]

  #---------------------------------------
  lint_ghdl_synth_8x8b :
  #---------------------------------------
    << : *lint_ghdl_synth
    description     : Synthesis check of stack, 8x8 bits
    parameters      :
      - WIDTH=8
      - DEPTH=8

  #---------------------------------------
  lint_ghdl_synth_4x16b_overwrite :
  #---------------------------------------
    << : *lint_ghdl_synth
    description     : Synthesis check of stack, 4x16 bits, overwrite
    parameters      :
      - WIDTH=16
      - DEPTH=4
      - OVERWRITE=1

  #---------------------------------------
  lint_ghdl_synth_32x10b :
  #---------------------------------------
    << : *lint_ghdl_synth
    description     : Synthesis check of stack, 32x10 bits, overwrite
    parameters      :
      - WIDTH=10
      - DEPTH=32
      - OVERWRITE=1

  #---------------------------------------
  lint_ghdl_synth_cyclic :
  #---------------------------------------
    << : *lint_ghdl_synth
    description     : Synthesis check of stack, 32x10 bits, overwrite, cyclic pointer
    parameters      :
      - WIDTH=10
      - DEPTH=32
      - OVERWRITE=1
      - CYCLIC_PTR=true

  #---------------------------------------
  # Synthesis : size of stack with the generics of the target, Xilinx
  # Artix-7 (LUT, FF, BRAM, DSP) and sky130 (area), by Yosys and its GHDL
  # plugin. Same configurations as lint_ghdl_synth_*.
  # The pre_run hook (yosys_synth.sh of asylum:utils:yosys_synth) adds
  # yosys_synth.mk to the edalize Makefile.
  #---------------------------------------
  syn_default : &syn
    << : *lint_ghdl
    description     : Synthesis (Artix-7, sky130) of stack, default generics
    filesets_append : [syn, syn_yosys]
    tools :
      ghdl :
        run_options     : ["--no-run"]
    hooks :
      pre_run : [yosys_synth]

  #---------------------------------------
  syn_8x8b :
  #---------------------------------------
    << : *syn
    description     : Synthesis (Artix-7, sky130) of stack, 8x8 bits
    parameters      :
      - WIDTH=8
      - DEPTH=8

  #---------------------------------------
  syn_4x16b_overwrite :
  #---------------------------------------
    << : *syn
    description     : Synthesis (Artix-7, sky130) of stack, 4x16 bits, overwrite
    parameters      :
      - WIDTH=16
      - DEPTH=4
      - OVERWRITE=1

  #---------------------------------------
  syn_32x10b :
  #---------------------------------------
    << : *syn
    description     : Synthesis (Artix-7, sky130) of stack, 32x10 bits, overwrite
    parameters      :
      - WIDTH=10
      - DEPTH=32
      - OVERWRITE=1

  #---------------------------------------
  syn_cyclic :
  #---------------------------------------
    << : *syn
    description     : Synthesis (Artix-7, sky130) of stack, 32x10 bits, overwrite, cyclic pointer
    parameters      :
      - WIDTH=10
      - DEPTH=32
      - OVERWRITE=1
      - CYCLIC_PTR=true

  #---------------------------------------
  # tb_stack : compiled once per configuration (WIDTH, DEPTH, OVERWRITE,
  # CYCLIC_PTR), scenarios chosen at run time (TESTS_LIST, empty : build
  # and elaboration only).
  # Reference configuration : cyclic pointer (every scenario applies) :
  # sim_cyclic (build only) and one sim_cyclic_<test> target per
  # scenario ; sim_basic and sim_overwrite run the whole list (cyclic
  # excepted). Each target repeats the generics of its configuration :
  # FuseSoC replaces the parameters list of an inherited target.
  #---------------------------------------
  sim_cyclic: &sim_cyclic
    << : *default
    description     : Simulation of stack (UVVM), OVERWRITE = 1, CYCLIC_PTR = true - build only (scenarios of TESTS_LIST)
    filesets_append :
      - files_sim
    toplevel        : tb_stack
    parameters      :
      - TESTS_LIST
      - WIDTH=10
      - DEPTH=8
      - OVERWRITE=1
      - CYCLIC_PTR=true
    default_tool    : ghdl
    tools :
      ghdl :
        analyze_options :
          - "$(GHDL_ANALYZE_OPTION)"
          - "-Wall"
          - "-frelaxed"
        run_options     :
          - "$(GHDL_RUN_OPTION)"
          - "--ieee-asserts=disable"

  #---------------------------------------
  sim_cyclic_reset_values:
  #---------------------------------------
    << : *sim_cyclic
    description     : Simulation of stack (UVVM), OVERWRITE = 1, CYCLIC_PTR = true - outputs during and after the reset
    parameters      :
      - TESTS_LIST=reset_values
      - WIDTH=10
      - DEPTH=8
      - OVERWRITE=1
      - CYCLIC_PTR=true

  #---------------------------------------
  sim_cyclic_lifo:
  #---------------------------------------
    << : *sim_cyclic
    description     : Simulation of stack (UVVM), OVERWRITE = 1, CYCLIC_PTR = true - push up to full, pop in LIFO order
    parameters      :
      - TESTS_LIST=lifo
      - WIDTH=10
      - DEPTH=8
      - OVERWRITE=1
      - CYCLIC_PTR=true

  #---------------------------------------
  sim_cyclic_push_full:
  #---------------------------------------
    << : *sim_cyclic
    description     : Simulation of stack (UVVM), OVERWRITE = 1, CYCLIC_PTR = true - push on a full stack (overwrite of the oldest word)
    parameters      :
      - TESTS_LIST=push_full
      - WIDTH=10
      - DEPTH=8
      - OVERWRITE=1
      - CYCLIC_PTR=true

  #---------------------------------------
  sim_cyclic_push_pop:
  #---------------------------------------
    << : *sim_cyclic
    description     : Simulation of stack (UVVM), OVERWRITE = 1, CYCLIC_PTR = true - simultaneous push and pop at every level
    parameters      :
      - TESTS_LIST=push_pop
      - WIDTH=10
      - DEPTH=8
      - OVERWRITE=1
      - CYCLIC_PTR=true

  #---------------------------------------
  sim_cyclic_cke:
  #---------------------------------------
    << : *sim_cyclic
    description     : Simulation of stack (UVVM), OVERWRITE = 1, CYCLIC_PTR = true - cke_i = 0 freezes the stack
    parameters      :
      - TESTS_LIST=cke
      - WIDTH=10
      - DEPTH=8
      - OVERWRITE=1
      - CYCLIC_PTR=true

  #---------------------------------------
  sim_cyclic_async_reset:
  #---------------------------------------
    << : *sim_cyclic
    description     : Simulation of stack (UVVM), OVERWRITE = 1, CYCLIC_PTR = true - asynchronous reset arstn_i
    parameters      :
      - TESTS_LIST=async_reset
      - WIDTH=10
      - DEPTH=8
      - OVERWRITE=1
      - CYCLIC_PTR=true

  #---------------------------------------
  sim_cyclic_random:
  #---------------------------------------
    << : *sim_cyclic
    description     : Simulation of stack (UVVM), OVERWRITE = 1, CYCLIC_PTR = true - 1200 cycles of random push, pop and cke_i
    parameters      :
      - TESTS_LIST=random
      - WIDTH=10
      - DEPTH=8
      - OVERWRITE=1
      - CYCLIC_PTR=true

  #---------------------------------------
  sim_cyclic_cyclic:
  #---------------------------------------
    << : *sim_cyclic
    description     : Simulation of stack (UVVM), OVERWRITE = 1, CYCLIC_PTR = true - cyclic pointer, pop on an empty stack, pointer reset
    parameters      :
      - TESTS_LIST=cyclic
      - WIDTH=10
      - DEPTH=8
      - OVERWRITE=1
      - CYCLIC_PTR=true

  #---------------------------------------
  sim_cyclic_sync_reset:
  #---------------------------------------
    << : *sim_cyclic
    description     : Simulation of stack (UVVM), OVERWRITE = 1, CYCLIC_PTR = true - synchronous reset srst_i
    parameters      :
      - TESTS_LIST=sync_reset
      - WIDTH=10
      - DEPTH=8
      - OVERWRITE=1
      - CYCLIC_PTR=true

  #---------------------------------------
  sim_basic:
  #---------------------------------------
    << : *sim_cyclic
    description     : Simulation of stack (UVVM), OVERWRITE = 0 - every scenario (cyclic excepted)
    parameters      :
      - TESTS_LIST=reset_values,lifo,push_full,push_pop,cke,async_reset,random,sync_reset
      - WIDTH=8
      - DEPTH=8
      - OVERWRITE=0
      - CYCLIC_PTR=false

  #---------------------------------------
  sim_overwrite:
  #---------------------------------------
    << : *sim_cyclic
    description     : Simulation of stack (UVVM), OVERWRITE = 1 - every scenario (cyclic excepted)
    parameters      :
      - TESTS_LIST=reset_values,lifo,push_full,push_pop,cke,async_reset,random,sync_reset
      - WIDTH=16
      - DEPTH=4
      - OVERWRITE=1
      - CYCLIC_PTR=false

scripts:

  #---------------------------------------
  # pre_run hook of lint_ghdl_synth_* (cwd = work_root)
  #---------------------------------------
  ghdl_synth :
    cmd : [bash, ghdl_synth.sh]

  #---------------------------------------
  # pre_run hook of syn_* (cwd = work_root)
  #---------------------------------------
  yosys_synth :
    cmd : [bash, yosys_synth.sh]

parameters :

  TESTS_LIST :
    description : Scenarios of tb_stack, separated by ',' (empty, build only)
    datatype    : str
    paramtype   : generic

  WIDTH :
    description : Word width
    datatype    : int
    default     : 8
    paramtype   : generic

  DEPTH :
    description : Number of words
    datatype    : int
    default     : 8
    paramtype   : generic

  OVERWRITE :
    description : Allow the write if the stack is full (0 = no, /= 0 = yes)
    datatype    : int
    default     : 0
    paramtype   : generic

  CYCLIC_PTR :
    description : Purely cyclic pointer, a pop on an empty stack moves the pointer
    datatype    : bool
    default     : false
    paramtype   : generic

# Next lines is a pragma, don't modify
#<PROVIDER_BEGIN>
provider  :
  name    : github
  user    : deuskane
  repo    : asylum-component-stack
  version : asylum-component-stack-1.2.0
 #version : 99c60d0af64551ac1e46a5a381bb3d6316c349f3
#<PROVIDER_END>
