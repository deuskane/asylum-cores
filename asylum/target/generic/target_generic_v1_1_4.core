name        : asylum:target:generic:1.1.4
description : Inferred Technology Cells

#=========================================
filesets:
#=========================================

  #---------------------------------------
  hdl:
  #---------------------------------------
    files:
      - hdl/common/techmap_pkg.vhd
      - hdl/generic/cbufg.vhd
      - hdl/generic/cgate.vhd
      - hdl/generic/sync2dff.vhd
      - hdl/generic/sync2dffrn.vhd
      - hdl/generic/iobuf.vhd
      - hdl/generic/obuf.vhd
      - hdl/generic/ibuf.vhd
    file_type    : vhdlSource
    logical_name : asylum

  #---------------------------------------
  sim:
  #---------------------------------------
    files:
      - sim/src/tb_dummy.vhd
    file_type : vhdlSource

#=========================================
targets:
#=========================================

  #---------------------------------------
  default: &default
  #---------------------------------------
    description     : Default Target (DON'T RUN)
    filesets        :
      - hdl
    default_tool    : ghdl

  #---------------------------------------
  lint: &lint
  #---------------------------------------
    << : *default
    description     : Lint
    default_tool    : ghdl
    toplevel        : tb_dummy
    filesets_append :
      - sim
    tools :
      ghdl :
        analyze_options : ["-fsynopsys"]

# Next lines is a pragma, don't modify
#<PROVIDER_BEGIN>
provider  :
  name    : github
  user    : deuskane
  repo    : asylum-target-techmap
  version : asylum-target-generic-1.1.4
 #version : c8f60146d0e8e94ed7522ec35047a072eecf81ed
#<PROVIDER_END>
