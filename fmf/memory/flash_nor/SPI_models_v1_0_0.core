name        : fmf:memory:flash_nor:1.0.0
description : SPI Flash NOR

#=========================================
filesets:
#=========================================

  #---------------------------------------
  pkg_fmf:
  #---------------------------------------
    files:
      - models/utilities/conversions.vhd
      - models/utilities/gen_utils.vhd
    logical_name : fmf
    file_type    : vhdlSource-2008

  #---------------------------------------
  models:
  #---------------------------------------
    files:
      - models/at25df161.vhd
      - models/cy15b104qs.vhd
      - models/cy15v104qs.vhd
      - models/m25p40.vhd
      - models/m45pe80.vhd
      - models/s25fl064p.vhd
      - models/s25fl512s.vhd
      - models/s35hl256t.vhd
#      - models/memory.mem         : {file_type : user, copyto : memory.mem   }
#      - models/memoryOTP.mem      : {file_type : user, copyto : memoryOTP.mem}
#      - models/none               : {file_type : user, copyto : none         }
#   logical_name : work
    file_type    : vhdlSource-2008
    depend       :
      - asylum:utils:pkg

#=========================================
targets:
#=========================================

  #---------------------------------------
  default: &default
  #---------------------------------------
    description     : Default Target
    filesets        :
      - pkg_fmf
      - models

